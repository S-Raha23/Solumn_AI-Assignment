const fs = require('node:fs');
const path = require('node:path');

class ConfigError extends Error {
  constructor(message) {
    super(message);
    this.name = 'ConfigError';
  }
}

function readJson(file) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch (err) {
    throw new ConfigError(`cannot read ${path.basename(file)}: ${err.message}`);
  }
}

function appRoot() {
  return process.env.APP_ROOT || path.resolve(__dirname, '..');
}

/**
 * Loads settings, the key schema and the destination table from <root>/config
 * and checks them against each other. Everything else in the service reads
 * configuration through the object returned here.
 */
function loadConfig(root = appRoot()) {
  const dir = path.join(root, 'config');
  const settings = readJson(path.join(dir, 'settings.json'));
  const schema = readJson(path.join(dir, 'schema.json'));
  const destinations = readJson(path.join(dir, 'destinations.json'));
  const classes = new Set(schema.classes);

  for (const [key, spec] of Object.entries(schema.keys)) {
    if (!classes.has(spec.class)) {
      throw new ConfigError(`schema: ${key} has unknown class "${spec.class}"`);
    }
    if (!(key in settings)) {
      throw new ConfigError(`settings: missing ${key}`);
    }
    if (typeof settings[key] !== spec.type) {
      throw new ConfigError(`settings: ${key} must be a ${spec.type}`);
    }
  }
  for (const key of Object.keys(settings)) {
    if (!schema.keys[key]) throw new ConfigError(`settings: ${key} is not in the schema`);
  }
  for (const [name, dest] of Object.entries(destinations)) {
    if (!dest.spool || !dest.url) {
      throw new ConfigError(`destinations: ${name} needs url and spool`);
    }
    for (const cls of dest.accepts || []) {
      if (!classes.has(cls)) {
        throw new ConfigError(`destinations: ${name} accepts unknown class "${cls}"`);
      }
    }
  }

  return {
    root,
    get(key) {
      if (!(key in settings)) throw new ConfigError(`unknown setting ${key}`);
      return settings[key];
    },
    /** Schema entry ({type, class, description}) for a key. */
    describe(key) {
      const spec = schema.keys[key];
      if (!spec) throw new ConfigError(`unknown setting ${key}`);
      return { ...spec };
    },
    /** Subset of settings as a plain {key: value} object, in the order given. */
    pick(keys) {
      const out = {};
      for (const key of keys) out[key] = this.get(key);
      return out;
    },
    keys() {
      return Object.keys(settings);
    },
    destination(name) {
      const dest = destinations[name];
      if (!dest) throw new ConfigError(`unknown destination ${name}`);
      return { name, ...dest, accepts: [...(dest.accepts || [])] };
    },
  };
}

module.exports = { loadConfig, appRoot, ConfigError };
'use strict';

const SECRET_KEY = /pass(word|wd)?|secret|token|api[-_]?key|authorization/i;
const BEARER = /\b(Bearer|Basic)\s+[A-Za-z0-9._~+/=-]{8,}/g;
const MASK = '[redacted]';

/**
 * Deep copy of `value` for the oplog: values under secret-looking keys are
 * masked and bearer/basic credentials inside strings are scrubbed.
 */
function redact(value, key = '') {
  if (key && SECRET_KEY.test(key)) return MASK;
  if (typeof value === 'string') return value.replace(BEARER, `$1 ${MASK}`);
  if (Array.isArray(value)) return value.map((item) => redact(item));
  if (value && typeof value === 'object') {
    const out = {};
    for (const [k, v] of Object.entries(value)) out[k] = redact(v, k);
    return out;
  }
  return value;
}

module.exports = { redact, MASK };
'use strict';
const fs = require('node:fs');
const path = require('node:path');
const { redact } = require('./redact');

function oplogPath(root) {
  return path.join(root, 'var', 'oplog.ndjson');
}

/** Appends one run record to var/oplog.ndjson. */
function appendOplog(root, entry) {
  const file = oplogPath(root);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.appendFileSync(file, JSON.stringify(redact(entry)) + '\n');
}

function readOplog(root) {
  const file = oplogPath(root);
  if (!fs.existsSync(file)) return [];
  return fs
    .readFileSync(file, 'utf8')
    .split('\n')
    .filter(Boolean)
    .map((line) => JSON.parse(line));
}

module.exports = { appendOplog, readOplog, oplogPath };
'use strict';
const fs = require('node:fs');
const path = require('node:path');
const { openLedger, totalsByMerchant } = require('./ledger');

class ReconcileMismatchError extends Error {
  constructor(message) {
    super(message);
    this.name = 'ReconcileMismatchError';
  }
}

class FeedError extends Error {
  constructor(message) {
    super(message);
    this.name = 'FeedError';
  }
}

function writeJson(file, value) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, JSON.stringify(value, null, 2) + '\n');
}

function ledgerFor(ctx) {
  return openLedger(ctx.settings['ledger.replica_dsn'], {
    root: ctx.root,
    timeoutMs: ctx.settings['ledger.timeout_ms'],
    log: ctx.log,
  });
}

/** Parses the processor's settled file: merchant,count,total_minor. */
function readProcessorFile(file) {
  if (!fs.existsSync(file)) throw new FeedError(`processor file ${path.basename(file)} not found`);
  const [header, ...lines] = fs.readFileSync(file, 'utf8').trim().split('\n');
  if (header.trim() !== 'merchant,count,total_minor') {
    throw new FeedError(`processor file ${path.basename(file)} has an unexpected header`);
  }
  const rows = new Map();
  for (const line of lines) {
    const [merchant, count, total] = line.trim().split(',');
    rows.set(merchant, { count: Number(count), total_minor: Number(total) });
  }
  return rows;
}

const jobs = {
  'ledger-reconcile': {
    settings: [
      'ledger.replica_dsn',
      'ledger.timeout_ms',
      'reconcile.batch_size',
      'reconcile.tolerance_minor',
      'risk.payout_holds',
    ],
    run(ctx) {
      const ledger = totalsByMerchant(ledgerFor(ctx).entries(ctx.date));
      const processor = readProcessorFile(
        path.join(ctx.root, 'data', 'inbox', 'processor', `settled-${ctx.date}.csv`),
      );
      const merchants = [...new Set([...ledger.keys(), ...processor.keys()])].sort();
      const size = ctx.settings['reconcile.batch_size'];
      const tolerance = ctx.settings['reconcile.tolerance_minor'];
      const holds = ctx.settings['risk.payout_holds'];
      const batches = Math.ceil(merchants.length / size);
      const drift = [];
      for (let b = 0; b < batches; b += 1) {
        for (const merchant of merchants.slice(b * size, (b + 1) * size)) {
          if (holds[merchant]) {
            ctx.log.info(`batch ${b + 1}/${batches} ${merchant} skipped, payout held: ${holds[merchant]}`);
            continue;
          }
          const ours = ledger.get(merchant) || { count: 0, total_minor: 0 };
          const theirs = processor.get(merchant) || { count: 0, total_minor: 0 };
          const delta = ours.total_minor - theirs.total_minor;
          ctx.log.info(`batch ${b + 1}/${batches} ${merchant} ledger=${ours.total_minor} processor=${theirs.total_minor}`);
          if (Math.abs(delta) > tolerance) drift.push({ merchant, delta });
        }
      }
      if (drift.length > 0) {
        const worst = drift.sort((a, b) => Math.abs(b.delta) - Math.abs(a.delta))[0];
        ctx.log.error(`${drift.length} merchant(s) outside tolerance`);
        throw new ReconcileMismatchError(
          `${drift.length} merchant(s) outside tolerance on ${ctx.date}, worst ${worst.merchant} off by ${worst.delta}`,
        );
      }
      writeJson(path.join(ctx.root, 'var', 'reconcile', `${ctx.date}.json`), {
        date: ctx.date,
        merchants: merchants.length,
        total_minor: [...ledger.values()].reduce((sum, slot) => sum + slot.total_minor, 0),
      });
      return { merchants: merchants.length };
    },
  },

  'statement-export': {
    settings: ['ledger.replica_dsn', 'ledger.timeout_ms', 'statement.output_dir', 'statement.currency'],
    run(ctx) {
      const entries = ledgerFor(ctx).entries(ctx.date);
      const currency = ctx.settings['statement.currency'];
      const outDir = path.join(ctx.root, ctx.settings['statement.output_dir'], ctx.date);
      fs.mkdirSync(outDir, { recursive: true });
      const byMerchant = new Map();
      for (const entry of entries) {
        if (!byMerchant.has(entry.merchant)) byMerchant.set(entry.merchant, []);
        byMerchant.get(entry.merchant).push(entry);
      }
      for (const [merchant, rows] of byMerchant) {
        const lines = ['entry_id,kind,amount,currency'];
        for (const row of rows) {
          const signed = row.kind === 'refund' ? -row.amount_minor : row.amount_minor;
          lines.push(`${row.id},${row.kind},${(signed / 100).toFixed(2)},${currency}`);
        }
        fs.writeFileSync(path.join(outDir, `${merchant}.csv`), lines.join('\n') + '\n');
        ctx.log.info(`statement ${merchant} rows=${rows.length}`);
      }
      return { statements: byMerchant.size };
    },
  },

  'fx-rates-refresh': {
    settings: ['fx.feed_dir', 'fx.max_age_hours'],
    run(ctx) {
      const file = path.join(ctx.root, ctx.settings['fx.feed_dir'], `rates-${ctx.date}.json`);
      if (!fs.existsSync(file)) throw new FeedError(`FX feed rates-${ctx.date}.json not found`);
      const feed = JSON.parse(fs.readFileSync(file, 'utf8'));
      const ageHours = (ctx.now.getTime() - new Date(feed.published_at).getTime()) / 3_600_000;
      ctx.log.info(`feed published ${feed.published_at} pairs=${Object.keys(feed.rates).length}`);
      if (ageHours > ctx.settings['fx.max_age_hours']) {
        throw new FeedError(`FX feed is ${Math.floor(ageHours)}h old, limit is ${ctx.settings['fx.max_age_hours']}h`);
      }
      writeJson(path.join(ctx.root, 'var', 'fx', 'latest.json'), { date: ctx.date, rates: feed.rates });
      return { pairs: Object.keys(feed.rates).length };
    },
  },
};

module.exports = { jobs, ReconcileMismatchError, FeedError };
'use strict';
const fs = require('node:fs');
const path = require('node:path');

class LedgerUnavailableError extends Error {
  constructor(message) {
    super(message);
    this.name = 'LedgerUnavailableError';
  }
}

/**
 * libpq keyword/value connection string for a postgresql:// URL, the form the
 * driver takes and reports in its connection errors.
 */
function conninfo(url, timeoutMs) {
  const parts = {
    host: url.hostname,
    port: url.port || '5432',
    dbname: url.pathname.replace(/^\//, ''),
    user: decodeURIComponent(url.username),
    password: decodeURIComponent(url.password),
    connect_timeout: String(Math.ceil(timeoutMs / 1000)),
    sslmode: url.searchParams.get('sslmode') || 'prefer',
  };
  return Object.entries(parts)
    .filter(([, value]) => value)
    .map(([key, value]) => `${key}=${value}`)
    .join(' ');
}

/**
 * Opens the read-only ledger replica named by a DSN.
 * In this image the database name maps to a snapshot folder (see docs/operations.md).
 */
function openLedger(dsn, { root, timeoutMs, log }) {
  let url;
  try {
    url = new URL(dsn);
  } catch {
    throw new LedgerUnavailableError('replica DSN is not a valid URL');
  }
  if (url.protocol !== 'postgresql:') {
    throw new LedgerUnavailableError(`unsupported replica protocol ${url.protocol}`);
  }
  const database = url.pathname.replace(/^\//, '');
  if (!database) throw new LedgerUnavailableError('replica DSN names no database');
  const folder = path.join(root, 'data', 'ledger', database);
  log.info(`replica ${url.hostname}:${url.port || 5432}/${database} timeout=${timeoutMs}ms`);

  return {
    database,
    /** All ledger entries booked on a settlement date. */
    entries(date) {
      const file = path.join(folder, `entries-${date}.jsonl`);
      if (!fs.existsSync(file)) {
        log.error(`no snapshot for ${date} [${conninfo(url, timeoutMs)}]`);
        throw new LedgerUnavailableError(`replica has no snapshot for ${date}`);
      }
      const rows = [];
      for (const line of fs.readFileSync(file, 'utf8').split('\n')) {
        if (!line.trim()) continue;
        const row = JSON.parse(line);
        if (!row.merchant || !Number.isInteger(row.amount_minor)) {
          throw new LedgerUnavailableError(`malformed ledger entry in ${path.basename(file)}`);
        }
        rows.push(row);
      }
      log.info(`replica returned ${rows.length} entries for ${date}`);
      return rows;
    },
  };
}

/** Sums entries per merchant: Map<merchant, {count, total_minor}>, sorted by merchant. */
function totalsByMerchant(entries) {
  const totals = new Map();
  for (const entry of entries) {
    const slot = totals.get(entry.merchant) || { count: 0, total_minor: 0 };
    slot.count += 1;
    slot.total_minor += entry.kind === 'refund' ? -entry.amount_minor : entry.amount_minor;
    totals.set(entry.merchant, slot);
  }
  return new Map([...totals.entries()].sort(([a], [b]) => a.localeCompare(b)));
}

module.exports = { openLedger, totalsByMerchant, LedgerUnavailableError };
