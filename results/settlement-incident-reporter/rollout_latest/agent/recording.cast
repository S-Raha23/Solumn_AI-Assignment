[100.167763, "o", "> PY\r\n\u001b[?2004l\r"]
[100.177662, "o", "\u001b[?2004hroot@b934666ec142:/app# "]
[100.177963, "o", "cat >> docs/operations.md <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[100.178087, "o", "> "]
[100.178202, "o", "## Failed-job incidents\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[100.178332, "o", "\u001b[?2004h> "]
[100.178658, "o", "After the final failed attempt, the runner sends an incident to `tracker` (Faultline).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.179083, "o", "Successful runs do not send incidents. The failed oplog entry records `incident` as\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.179191, "o", "> "]
[100.179439, "o", "`sent`, `suppressed`, or `undelivered`; tracker outages do not change the job's exit code.\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.179486, "o", "> "]
[100.179562, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.179593, "o", "> "]
[100.179991, "o", "`var/incidents.json` keeps per-fingerprint occurrence counts, the first failure time, and\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.180114, "o", "> "]
[100.180314, "o", "last successful send time (`null` until delivered). Repeats within\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.180666, "o", "`incident.dedupe_window_minutes` of the last successful send are counted but suppressed.\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.180702, "o", "> "]
[100.181101, "o", "The window uses the run's `--now` clock, not wall time. Failed deliveries count too, but\r\n\u001b[?2004l\r"]
[100.181148, "o", "\u001b[?2004h"]
[100.181163, "o", "> "]
[100.18141, "o", "never advance the last successful send time.\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.181447, "o", "> \r\n\u001b[?2004l\r"]
[100.181504, "o", "\u001b[?2004h> "]
[100.181851, "o", "Incidents include the final attempt's last `incident.log_tail_lines` lines and the job's\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.181921, "o", "> "]
[100.1822, "o", "settings. Settings outside the tracker's accepted schema classes are masked; the ledger\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.182261, "o", "> "]
[100.18259, "o", "DSN is projected to its scheme/host/port/database, without credentials or query parameters,\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.182635, "o", "> "]
[100.182982, "o", "so on-call can still identify the replica. Restricted setting values (including Risk notes\r\n\u001b[?2004l\r"]
[100.183074, "o", "\u001b[?2004h> "]
[100.18337, "o", "and encoded/decoded ledger passwords) are also scrubbed from outbound diagnostics. This\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.18348, "o", "> "]
[100.183717, "o", "projection does not change the settings or logs used by the job itself.\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.1838, "o", "> EOF\r\n\u001b[?2004l\r"]
[100.189322, "o", "\u001b[?2004hroot@b934666ec142:/app# "]
[100.189524, "o", "node --check src/reporter.js; git diff --stat; cat src/runner.js\r\n\u001b[?2004l\r"]
[100.216228, "o", "\u001b[?1h\u001b=\r docs/operations.md | 19 \u001b[32m+++++++++++++++++++\u001b[m\u001b[m\r\n src/runner.js      | 12 \u001b[32m++++++++++++\u001b[m\u001b[m\r\n 2 files changed, 31 insertions(+)\u001b[m\r\n"]
[100.216385, "o", "\r\u001b[K\u001b[?1l\u001b>"]
[100.218252, "o", "'use strict';\r\nconst { loadConfig } = require('./config');\r\nconst { jobs } = require('./jobs');\r\nconst { appendOplog } = require('./oplog');\r\nconst { reportFailure } = require('./reporter');\r\n\r\nclass UnknownJobError extends Error {\r\n  constructor(name) {\r\n    super(`unknown job ${name}`);\r\n    this.name = 'UnknownJobError';\r\n  }\r\n}\r\n\r\nfunction makeLog(lines, attempt) {\r\n  const write = (level) => (message) => lines.push(`[attempt ${attempt}] ${level} ${message}`);\r\n  return { info: write('INFO'), warn: write('WARN'), error: write('ERROR') };\r\n}\r\n\r\nconst sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));\r\n\r\n/**\r\n * Runs one job with retries and records the result in the oplog.\r\n *\r\n * Resolves to\r\n *   { ok: true,  job, date, attempts, result, log }\r\n *   { ok: false, job, date, attempts, error: {type, message}, log }\r\n * where `log` holds one array of lines per attempt.\r\n */\r\nasync function runJob(name, { date, now = new Date(), root } = {}) {\r\n  const job = jobs[name];\r\n  if (!job) throw new "]
[100.218292, "o", "UnknownJobError(name);\r\n  const config = loadConfig(root);\r\n  const settings = config.pick(job.settings);\r\n  const maxAttempts = config.get('retry.max_attempts');\r\n  const log = [];\r\n  let failure = null;\r\n\r\n  for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {\r\n    const lines = [];\r\n    log.push(lines);\r\n    const logger = makeLog(lines, attempt);\r\n    try {\r\n      logger.info(`${name} starting for ${date}`);\r\n      const result = job.run({ config, settings, date, now, root: config.root, log: logger });\r\n      logger.info(`${name} finished`);\r\n      appendOplog(config.root, {\r\n        ts: now.toISOString(),\r\n        service: config.get('service.name'),\r\n        job: name,\r\n        date,\r\n        outcome: 'ok',\r\n        attempts: attempt,\r\n      });\r\n      return { ok: true, job: name, date, attempts: attempt, result, log };\r\n    } catch (err) {\r\n      failure = { type: err.name || 'Error', message: err.message };\r\n      logger.error(`${failure.type}: ${failure.message}`);\r\n      if (attempt < maxA"]
[100.218318, "o", "ttempts) await sleep(config.get('retry.backoff_ms'));\r\n    }\r\n  }\r\n\r\n  let incident;\r\n  try {\r\n    incident = reportFailure(config, {\r\n      job: name, date, now, attempts: maxAttempts, error: failure, log, settings,\r\n    });\r\n  } catch {\r\n    // Reporting must never replace the job failure or prevent its oplog entry.\r\n    incident = 'undelivered';\r\n  }\r\n\r\n  appendOplog(config.root, {\r\n    ts: now.toISOString(),\r\n    service: config.get('service.name'),\r\n    job: name,\r\n    date,\r\n    outcome: 'failed',\r\n    attempts: maxAttempts,\r\n    error: failure,\r\n    incident,\r\n  });\r\n  return { ok: false, job: name, date, attempts: maxAttempts, error: failure, log };\r\n}\r\n\r\nmodule.exports = { runJob, UnknownJobError };\r\n"]
[100.218583, "o", "\u001b[?2004hroot@b934666ec142:/app# "]
