[100.129964, "i", "mp });\n      entry.last_sent = timestamp;\n      status = 'sent';\n    } catch {\n      status = 'undelivered';\n    }\n  }\n\n  fs.mkdirSync(path.dirname(file), { recursive: true });\n  const temporary = `${file}.${process.pid}.tmp`;\n  fs.writeFileSync(temporary, JSON.stringify(state, null, 2) + '\\n');\n  fs.renameSync(temporary, file);\n  return status;\n}\n\nmodule.exports = { reportFailure };\nEOF\npython3 - <<'PY'\np='src/runner.js'\ns=open(p).read().replace(\"const { appendOplog } = require('./oplog');\", \"const { appendOplog } = require('./oplog');\\nconst { reportFailure } = require('./reporter');\")\nneedle=\"  appendOplog(config.root, {\\n    ts: now.toISOString(),\"\ns=s.replace(needle, \"  let incident;\\n  try {\\n    incident = reportFailure(config, {\\n      job: name, date, now, attempts: maxAttempts, error: failure, log, settings,\\n    });\\n  } catch {\\n    // Reporting must never replace the job failure or prevent its oplog entry.\\n    incident = 'undelivered';\\n  }\\n\\n\"+needle)\ns=s.replace(\"    error: failure,\\n  });\", "]
