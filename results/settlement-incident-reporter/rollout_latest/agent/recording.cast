[154.065174, "o", "\u001b[32m✔ loads settings and describes keys \u001b[90m(7.866446ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a setting that is missing from the schema \u001b[90m(11.022214ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ redact masks secret-looking keys and bearer credentials \u001b[90m(0.547431ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ deliver records the document and honours OUTBOUND_FAIL \u001b[90m(7.464325ms)\u001b[39m\u001b[39m\r\n"]
[154.152649, "o", "\u001b[32m✔ a terminal failure sends one complete document using the run clock and final log tail \u001b[90m(42.756259ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ successful jobs do not send, count incidents, or add an incident oplog field \u001b[90m(19.903659ms)\u001b[39m\u001b[39m\r\n"]
[154.16235, "o", "\u001b[32m✔ a job that succeeds on a retry opens nothing \u001b[90m(12.037419ms)\u001b[39m\u001b[39m\r\n"]
[154.202451, "o", "\u001b[32m✔ de-duplication persists counts, normalizes digits, and expires at the exact boundary \u001b[90m(20.950113ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ fingerprints separate jobs, error types, and non-digit message changes \u001b[90m(12.682881ms)\u001b[39m\u001b[39m\r\n"]
[154.231381, "o", "\u001b[32m✔ outages count every failure and recovery immediately sends with the accumulated count \u001b[90m(28.631107ms)\u001b[39m\u001b[39m\r\n"]
[154.260566, "o", "\u001b[32m✔ an outage after a prior send leaves last_sent unchanged, allowing the next failure to send \u001b[90m(27.658358ms)\u001b[39m\u001b[39m\r\n"]
[154.281583, "o", "\u001b[32m✔ a zero log-tail setting sends no lines \u001b[90m(20.015902ms)\u001b[39m\u001b[39m\r\n"]
[154.305761, "o", "\u001b[32m✔ reconciliation includes tuning and replica identity, but no restricted Risk notes or credentials \u001b[90m(18.854674ms)\u001b[39m\u001b[39m\r\n"]
[154.524344, "o", "\u001b[32m✔ missing snapshot conninfo is safe in outbound logs without changing the job log \u001b[90m(32.71027ms)\u001b[39m\u001b[39m\r\n"]
[154.524609, "o", "\u001b[32m✔ new restricted settings are masked by schema class, including nested log values \u001b[90m(15.622548ms)\u001b[39m\u001b[39m\r\n"]
[154.525146, "o", "\u001b[32m✔ CLI keeps failure code 2 and oplog during tracker outages, success 0, usage 64 \u001b[90m(190.117587ms)\u001b[39m\u001b[39m\r\n"]
[154.536444, "o", "\u001b[32m✔ reconcile succeeds on a balanced day and writes the summary \u001b[90m(62.975746ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ reconcile fails after all attempts when a merchant drifts \u001b[90m(60.854138ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ statement export writes one file per merchant \u001b[90m(25.174316ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ fx refresh rejects a stale feed \u001b[90m(53.601293ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 20\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 20\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 595.952145\u001b[39m\r\n"]
