[100.129393, "i", "cat > src/reporter.js <<'EOF'\n'use strict';\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst { createHash } = require('node:crypto');\nconst { deliver } = require('./transport');\nconst { redact, MASK } = require('./redact');\n\nfunction fingerprint(job, error) {\n  const message = error.message.replace(/\\d+/g, '#');\n  return createHash('sha256').update(`${job}|${error.type}|${message}`).digest('hex').slice(0, 16);\n}\n\n/** Project diagnostics for the hosted tracker, not for the local oplog. */\nfunction trackerDiagnostics(config, settings) {\n  const accepts = new Set(config.destination('tracker').accepts);\n  const replacements = new Map();\n  const projections = {};\n  const maskLeaves = (value) => {\n    if (typeof value === 'string' && value) replacements.set(value, MASK);\n    else if (value && typeof value === 'object') Object.values(value).forEach(maskLeaves);\n  };\n\n  for (const key of config.keys()) {\n    if (accepts.has(config.describe(key).class)) continue;\n    const value = config.get(key"]
[100.129472, "i", ");\n    projections[key] = MASK;\n    if (key === 'ledger.replica_dsn') {\n      try {\n        const url = new URL(value);\n        // The endpoint is useful operational context; userinfo and query parameters are not.\n        const endpoint = `${url.protocol}//${url.host}${url.pathname}`;\n        projections[key] = endpoint;\n        replacements.set(value, endpoint);\n        if (url.password) {\n          replacements.set(url.password, MASK);\n          replacements.set(decodeURIComponent(url.password), MASK);\n        }\n        if (url.username) {\n          replacements.set(`user=${decodeURIComponent(url.username)}`, `user=${MASK}`);\n        }\n      } catch {\n        maskLeaves(value);\n      }\n    } else {\n      maskLeaves(value);\n    }\n  }\n\n  // Longest first prevents partial replacement of an encoded DSN or a nested value.\n  const needles = [...replacements.keys()].sort((a, b) => b.length - a.length);\n  const pattern = needles.length\n    ? new RegExp(needles.map((s) => s.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')).jo"]
[100.12973, "i", "in('|'), 'g')\n    : null;\n  const scrub = (value) => {\n    if (typeof value === 'string') {\n      return pattern ? value.replace(pattern, (match) => replacements.get(match)) : value;\n    }\n    if (Array.isArray(value)) return value.map(scrub);\n    if (value && typeof value === 'object') {\n      return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, scrub(item)]));\n    }\n    return value;\n  };\n  return {\n    settings: Object.fromEntries(Object.entries(settings).map(([key, value]) => [\n      key, Object.hasOwn(projections, key) ? projections[key] : value,\n    ])),\n    sanitize: (value) => scrub(redact(value)),\n  };\n}\n\n/** Count a terminal failure and return sent, suppressed, or undelivered. */\nfunction reportFailure(config, { job, date, now, attempts, error, log, settings }) {\n  const file = path.join(config.root, 'var', 'incidents.json');\n  let state;\n  try {\n    state = JSON.parse(fs.readFileSync(file, 'utf8'));\n  } catch (err) {\n    if (err.code !== 'ENOENT') throw err;\n    state = {};\n  "]
[100.129792, "i", "}\n  const id = fingerprint(job, error);\n  const timestamp = now.toISOString();\n  const entry = state[id] || { first_seen: timestamp, last_sent: null, occurrences: 0 };\n  entry.occurrences += 1;\n  state[id] = entry;\n\n  let status = 'suppressed';\n  const windowMs = config.get('incident.dedupe_window_minutes') * 60_000;\n  if (entry.last_sent === null || now.getTime() - Date.parse(entry.last_sent) >= windowMs) {\n    const diagnostics = trackerDiagnostics(config, settings);\n    const tailLines = Math.max(0, Math.floor(config.get('incident.log_tail_lines')));\n    const document = diagnostics.sanitize({\n      title: `${job} failed: ${error.type}`,\n      service: config.get('service.name'),\n      job,\n      run_date: date,\n      occurred_at: timestamp,\n      fingerprint: id,\n      occurrences: entry.occurrences,\n      attempts,\n      error,\n      log_tail: tailLines ? log.at(-1).slice(-tailLines) : [],\n      settings: diagnostics.settings,\n    });\n    try {\n      deliver(config, 'tracker', document, { sentAt: timesta"]
