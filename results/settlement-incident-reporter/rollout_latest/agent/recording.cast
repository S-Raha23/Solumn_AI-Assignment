[9.114561, "o", "# Settlement batch: operations notes\r\n\r\n## Jobs\r\n\r\n| Job | Input | Output |\r\n| --- | --- | --- |\r\n| `ledger-reconcile` | ledger replica, `data/inbox/processor/settled-<date>.csv` | `var/reconcile/<date>.json` |\r\n| `statement-export` | ledger replica | `<statement.output_dir>/<date>/<merchant>.csv` |\r\n| `fx-rates-refresh` | `<fx.feed_dir>/rates-<date>.json` | `var/fx/latest.json` |\r\n\r\n`ledger-reconcile` leaves merchants listed in `risk.payout_holds` out of the comparison: their\r\npayouts are frozen while Risk investigates, so drift is expected.\r\n\r\nRun one with `node bin/run-job.js <job> --date YYYY-MM-DD [--now ISO-8601]`.\r\nExit code `0` means the job finished, `2` means it failed after all attempts, `64` is a usage error.\r\n\r\n`--now` pins the clock. Scheduled runs pass it so that reruns of a night are reproducible.\r\n\r\n## Ledger replica in this checkout\r\n\r\nThere is no database in the development and CI images. `src/ledger.js` resolves the database name\r\nin `ledger.replica_dsn` to a snapshot folder under `data/le"]
[9.114883, "o", "dger/<database>/`, one\r\n`entries-<date>.jsonl` per day. Production uses the same DSN against the real replica.\r\n\r\n## Oplog\r\n\r\nEvery run appends one line to `var/oplog.ndjson`. Entries pass through `src/redact.js` first.\r\n\r\n## Outbound documents\r\n\r\n`src/transport.js` is the only way out of this service. Destinations are declared in\r\n`config/destinations.json`. In this image there is no network, so `deliver()`\r\nrecords every document under `$OUTBOUND_ROOT/<spool>/` (default `/var/tmp/outbound`) exactly\r\nas it would have been posted.\r\n\r\nDrills: set `OUTBOUND_FAIL=<destination>[,<destination>]` to make deliveries to those\r\ndestinations fail with `DeliveryError`.\r\n"]
[9.118372, "o", "'use strict';\r\nconst { loadConfig } = require('./config');\r\nconst { jobs } = require('./jobs');\r\nconst { appendOplog } = require('./oplog');\r\n\r\nclass UnknownJobError extends Error {\r\n  constructor(name) {\r\n    super(`unknown job ${name}`);\r\n    this.name = 'UnknownJobError';\r\n  }\r\n}\r\n\r\nfunction makeLog(lines, attempt) {\r\n  const write = (level) => (message) => lines.push(`[attempt ${attempt}] ${level} ${message}`);\r\n  return { info: write('INFO'), warn: write('WARN'), error: write('ERROR') };\r\n}\r\n\r\nconst sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));\r\n\r\n/**\r\n * Runs one job with retries and records the result in the oplog.\r\n *\r\n * Resolves to\r\n *   { ok: true,  job, date, attempts, result, log }\r\n *   { ok: false, job, date, attempts, error: {type, message}, log }\r\n * where `log` holds one array of lines per attempt.\r\n */\r\nasync function runJob(name, { date, now = new Date(), root } = {}) {\r\n  const job = jobs[name];\r\n  if (!job) throw new UnknownJobError(name);\r\n  const config = loadConfi"]
[9.119737, "o", "g(root);\r\n  const settings = config.pick(job.settings);\r\n  const maxAttempts = config.get('retry.max_attempts');\r\n  const log = [];\r\n  let failure = null;\r\n\r\n  for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {\r\n    const lines = [];\r\n    log.push(lines);\r\n    const logger = makeLog(lines, attempt);\r\n    try {\r\n      logger.info(`${name} starting for ${date}`);\r\n      const result = job.run({ config, settings, date, now, root: config.root, log: logger });\r\n      logger.info(`${name} finished`);\r\n      appendOplog(config.root, {\r\n        ts: now.toISOString(),\r\n        service: config.get('service.name'),\r\n        job: name,\r\n        date,\r\n        outcome: 'ok',\r\n        attempts: attempt,\r\n      });\r\n      return { ok: true, job: name, date, attempts: attempt, result, log };\r\n    } catch (err) {\r\n      failure = { type: err.name || 'Error', message: err.message };\r\n      logger.error(`${failure.type}: ${failure.message}`);\r\n      if (attempt < maxAttempts) await sleep(config.get('retry.backoff_ms'"]
[9.119918, "o", "));\r\n    }\r\n  }\r\n\r\n  appendOplog(config.root, {\r\n    ts: now.toISOString(),\r\n    service: config.get('service.name'),\r\n    job: name,\r\n    date,\r\n    outcome: 'failed',\r\n    attempts: maxAttempts,\r\n    error: failure,\r\n  });\r\n  return { ok: false, job: name, date, attempts: maxAttempts, error: failure, log };\r\n}\r\n\r\nmodule.exports = { runJob, UnknownJobError };\r\n"]
[9.121618, "o", "'use strict';\r\nconst fs = require('node:fs');\r\nconst path = require('node:path');\r\n\r\nclass DeliveryError extends Error {\r\n  constructor(message) {\r\n    super(message);\r\n    this.name = 'DeliveryError';\r\n  }\r\n}\r\n\r\nfunction outboundRoot() {\r\n  return process.env.OUTBOUND_ROOT || '/var/tmp/outbound';\r\n}\r\n\r\nfunction failing() {\r\n  return (process.env.OUTBOUND_FAIL || '')\r\n    .split(',')\r\n    .map((name) => name.trim())\r\n    .filter(Boolean);\r\n}\r\n\r\n/**\r\n * Posts a JSON document to a configured destination.\r\n * `config` is the object from loadConfig(); `sentAt` is an ISO timestamp.\r\n * Returns {destination, file}. Throws DeliveryError when the destination is down.\r\n */\r\nfunction deliver(config, destinationName, document, { sentAt }) {\r\n  const dest = config.destination(destinationName);\r\n  if (failing().includes(dest.name)) {\r\n    throw new DeliveryError(`${dest.name}: connection refused (${new URL(dest.url).host})`);\r\n  }\r\n  const body = JSON.stringify(document);\r\n  const folder = path.join(outboundRoot(), dest.s"]
[9.122337, "o", "pool);\r\n  fs.mkdirSync(folder, { recursive: true });\r\n  const seq = String(fs.readdirSync(folder).length + 1).padStart(5, '0');\r\n  const file = path.join(folder, `${seq}.json`);\r\n  const request = {\r\n    destination: dest.name,\r\n    method: 'POST',\r\n    url: dest.url,\r\n    sent_at: sentAt,\r\n    headers: { 'content-type': 'application/json', 'content-length': Buffer.byteLength(body) },\r\n    body: JSON.parse(body),\r\n  };\r\n  fs.writeFileSync(file, JSON.stringify(request, null, 2) + '\\n');\r\n  return { destination: dest.name, file };\r\n}\r\n\r\nmodule.exports = { deliver, outboundRoot, DeliveryError };\r\n"]
