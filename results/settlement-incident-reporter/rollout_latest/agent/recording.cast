[168.588008, "o", "\u001b[1mdiff --git a/docs/operations.md b/docs/operations.md\u001b[m\u001b[m\r\n\u001b[1mindex 4c49fb4..7aa5cb7 100755\u001b[m\u001b[m\r\n\u001b[1m--- a/docs/operations.md\u001b[m\u001b[m\r\n\u001b[1m+++ b/docs/operations.md\u001b[m\u001b[m\r\n\u001b[36m@@ -35,3 +35,22 @@\u001b[m \u001b[mas it would have been posted.\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n Drills: set `OUTBOUND_FAIL=<destination>[,<destination>]` to make deliveries to those\u001b[m\u001b[m\r\n destinations fail with `DeliveryError`.\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m## Failed-job incidents\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mAfter the final failed attempt, the runner sends an incident to `tracker` (Faultline).\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mSuccessful runs do not send incidents. The failed oplog entry records `incident` as\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m`sent`, `suppressed`, or `undelivered`; tracker outages do not change the job's exit code.\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m`var/incidents.json` keeps per-fingerprint occurrence counts, the first failure time, and\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mlast successful send time (`null` until delivered). Repeats within\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m`inc"]
[168.588062, "o", "ident.dedupe_win"]
[168.588248, "o", "dow_minutes` of the last successful send are counted but suppressed.\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mThe window uses the run's `--now` clock, not wall time. Failed deliveries count too, but\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mnever advance the last successful send time.\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mIncidents include the final attempt's last `incident.log_tail_lines` lines and the job's\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32msettings. Settings outside the tracker's accepted schema classes are masked; the ledger\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mDSN is projected to its scheme/host/port/database, without credentials or query parameters,\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mso on-call can still identify the replica. Restricted setting values (including Risk notes\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mand encoded/decoded ledger passwords) are also scrubbed from outbound diagnostics. This\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mprojection does not change the settings or logs used by the job itself.\u001b[m\u001b[m\r\n\u001b[1mdiff --git a/src/runner.js b/src/runner.js\u001b[m\u001b[m\r\n\u001b[1mindex 3dcd4cc..637244e 100755\u001b[m\u001b[m\r\n\u001b[1m--- a/src/run"]
[168.588265, "o", "ner.js\u001b[m\u001b[m\r\n\u001b[1m+++ b/src/runner.js\u001b[m\u001b[m\r\n\u001b[36m@@ -2,6 +2,7 @@\u001b[m\u001b[m\r\n const { loadConfig } = require('./config');\u001b[m\u001b[m\r\n const { jobs } = require('./jobs');\u001b[m\u001b[m\r\n const { appendOplog } = require('./oplog');\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mconst { reportFailure } = require('./reporter');\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n class UnknownJobError extends Error {\u001b[m\u001b[m\r\n   constructor(name) {\u001b[m\u001b[m\r\n:\u001b[K"]
[191.488546, "i", "q"]
[191.489213, "o", "\r\u001b[K\u001b[?1l\u001b>"]
[191.490272, "o", "\u001b[?2004hroot@b934666ec142:/app# "]
[191.75198, "i", "python3 - <<'PY'\np='src/reporter.js'\ns=open(p).read().replace(\"if (entry.last_sent === null ||\", \"if (!entry.last_sent ||\")\ns=s.replace(\"    const document = diagnostics.sanitize({\", \"    const diagnosticFields = diagnostics.sanitize({\\n      error,\\n      log_tail: tailLines ? log.at(-1).slice(-tailLines) : [],\\n      settings: diagnostics.settings,\\n    });\\n    const document = {\")\ns=s.replace(\"      error,\\n      log_tail: tailLines ? log.at(-1).slice(-tailLines) : [],\\n      settings: diagnostics.settings,\\n    });\\n    try {\", \"      ...diagnosticFields,\\n    };\\n    try {\")\nopen(p,'w').write(s)\nPY\ncat >> test/reporter.test.js <<'EOF'\n\ntest('configured attempt count is reflected in both the document and final-attempt tail', async (t) => {\n  const root = fixture(t, { 'retry.max_attempts': 2, 'incident.log_tail_lines': 1 });\n  const result = await fail(root);\n  assert.equal(result.attempts, 2);\n  assert.equal(requests(root).length, 1);\n  const body = requests(root)[0].body;\n  assert.equal(body.attempts, 2"]
[191.752036, "i", ");\n  assert.deepEqual(body.log_tail, result.log[1].slice(-1));\n  assert.ok(body.log_tail.every((line) => line.startsWith('[attempt 2]')));\n});\n\ntest('diagnostic scrubbing does not change fingerprint, count, or run-clock metadata', (t) => {\n  const root = fixture(t, { 'risk.payout_holds': { merchant: '2026' } });\n  const config = loadConfig(root);\n  const failure = {\n    job: 'test', date: '2026-11-04', now: NOW, attempts: 1,\n    error: { type: 'Error', message: 'failure 2026' },\n    log: [['failure 2026']], settings: config.pick(['risk.payout_holds']),\n  };\n  reportFailure(config, failure);\n  const body = requests(root)[0].body;\n  assert.equal(body.occurred_at, NOW.toISOString());\n  assert.equal(body.run_date, failure.date);\n  assert.equal(body.fingerprint, expectedFingerprint(failure.job, failure.error));\n  assert.equal(body.occurrences, 1);\n  assert.equal(body.error.message, `failure ${MASK}`);\n});\nEOF\nnpm test; git diff --check; git --no-pager diff --stat; git status --short\n"]
[191.752174, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[191.752517, "o", "\u001b[?2004h> p='src/reporter.js'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.753966, "o", "s=open(p).read().replace(\"if (entry.last_sent === null ||\", \"if (!entry.last_sent ||\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.757785, "o", "s=s.replace(\"    const document = diagnostics.sanitize({\", \"    const diagnosticFields = diagnostics.sanitize({\\n      error,\\n      log_tail: tailLines ? log.at(-1).slice(-tailLines) : [],\\n      settings: diagnostics.settings,\\n    });\\n    const document = {\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"      error,\\n      log_tail: tailLines ? log.at(-1).slice(-tailLines) : [],\\n      settings: diagnostics.settings,\\n    });\\n    try {\", \"      ...diagnosticFields,\\n    };\\n    try {\")\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
