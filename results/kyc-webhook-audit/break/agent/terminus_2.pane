import { canMove, CustomerStore } from "../customers.ts";
import type { KycStatus } from "../customers.ts";
import { SignatureError, verify } from "../signature.ts";
import type { Handler } from "../app.ts";

type VeriformEvent = {
  id: string;
  type: string;
  data: {
    check: {
      id: string;
      reference: string;
      result: "clear" | "consider" | "rejected";
      completed_at: string;
      reasons: Array<{ code: string; message: string }>;
    };
  };
};

const STATUSES: Record<VeriformEvent["data"]["check"]["result"], KycStatus> = {
  clear: "verified",
  consider: "manual_review",
  rejected: "rejected",
};

export const veriformWebhook: Handler = (req, ctx) => {
  try {
    verify(ctx.secrets.veriform, req.headers["veriform-signature"], req.body, ctx.now);
  } catch (err) {
    if (err instanceof SignatureError) return { status: 401, body: { error: err.message } };
    throw err;
  }
  const event = JSON.parse(req.body.toString("utf8")) as VeriformEvent;
  if (event.type !== "check.completed") return { status: 200, body: { ignored: event.type } };

  const check = event.data.check;
  const store = new CustomerStore(ctx.dataDir);
  if (!store.has(check.reference)) return { status: 404, body: { error: "unknown customer" } };
  const customer = store.get(check.reference);
  if (customer.processed_events.includes(event.id)) return { status: 200, body: { duplicate: true } };

  const status = STATUSES[check.result];
  if (!canMove(customer.kyc_status, status)) return { status: 200, body: { ignored: "transition" } };
  if (customer.kyc_updated_at !== null && Date.parse(check.completed_at) < Date.parse(customer.kyc_updated_at)) {
    return { status: 200, body: { ignored: "older check" } };
  }

  customer.kyc_status = status;
  customer.kyc_check_id = check.id;
  customer.kyc_updated_at = check.completed_at;
  store.markProcessed(customer, event.id);
  store.save();
  record("kyc.decision", {
    actor: "veriform",
    subject: customer.id,
    at: ctx.now,
    details: {
      check_id: check.id,
      result: check.result,
      kyc_status: status,
      // Keep Veriform's explanations verbatim, but not unrelated check data.
      reasons: check.reasons.map(({ code, message }) => ({ code, message })),
    },
  });
  return { status: 200, body: { ok: true } };
};
import { test } from "node:test";
import type { TestContext } from "node:test";
import assert from "node:assert/strict";
import { cpSync, existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { handle } from "../src/app.ts";
import type { Customer } from "../src/customers.ts";
import type { AuditEntry } from "../src/audit.ts";
import { sign } from "../src/signature.ts";

const ROOT = join(import.meta.dirname, "..");
const SECRETS = { paylark: "whsec_test_paylark", veriform: "whsec_test_veriform" };
const NOW = new Date("2026-11-16T10:00:00Z");
const T = NOW.getTime() / 1000;

function fixture(t: TestContext) {
  const dir = mkdtempSync(join(tmpdir(), "pocketwise-veriform-"));
  cpSync(join(ROOT, "data"), dir, { recursive: true });
  const previousAudit = process.env.AUDIT_LOG;
  const auditPath = join(dir, "audit.ndjson");
  process.env.AUDIT_LOG = auditPath;
  t.after(() => {
    if (previousAudit === undefined) delete process.env.AUDIT_LOG;
    else process.env.AUDIT_LOG = previousAudit;
    rmSync(dir, { recursive: true, force: true });
  });
  const file = join(dir, "customers.json");
  return {
    file,
    customers: () => JSON.parse(readFileSync(file, "utf8")) as Customer[],
    audit: () => existsSync(auditPath)
      ? readFileSync(auditPath, "utf8").trim().split("\n").map((line) => JSON.parse(line) as AuditEntry)
      : [],
    request(body: Buffer, signature: string | undefined) {
      return handle({ method: "POST", path: "/webhooks/veriform", headers: { "Veriform-Signature": signature }, body },
        { now: NOW, dataDir: dir, secrets: SECRETS });
    },
    send(event: object) {
      const body = Buffer.from(JSON.stringify(event));
      return this.request(body, `t=${T},v1=${sign(SECRETS.veriform, T, body)}`);
    },
    view(id: string) {
      return handle({ method: "GET", path: `/internal/customers/${id}`, headers: {}, body: Buffer.alloc(0) },
        { now: NOW, dataDir: dir, secrets: SECRETS });
    },
  };
}

function completed(result: "clear" | "consider" | "rejected" = "clear", reference = "cus_1002") {
  return {
    id: "evt_v1", type: "check.completed", created: T - 3600,
    data: { check: {
      id: "chk_v1", reference, result, completed_at: "2026-11-16T09:00:00Z",
      reasons: result === "clear" ? [] : [
        { code: "DOC_EXPIRED", message: "Passport 533401187 expired on 2025-04-30", internal: "do not copy" },
        { code: "NAME_MISMATCH", message: "Document name does not match applicant: Daniel Okafor" },
        { code: "NEW_PROVIDER_CODE", message: "Provider's new explanation, kept verbatim." },
      ],
      applicant: { full_name: "Daniel Okafor", date_of_birth: "1991-07-22" },
      document: { number: "533401187" },
      liveness: { selfie_url: "https://files.veriform.example/private.jpg" },
    } },
  };
}

for (const [result, status] of [["clear", "verified"], ["consider", "manual_review"], ["rejected", "rejected"]] as const) {
  test(`${result} saves ${status} and audits all reason explanations, but not the raw check`, (t) => {
    const f = fixture(t);
    const event = completed(result);
[?2004hroot@4985f751a8fd:/app# 