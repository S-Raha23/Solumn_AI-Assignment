[13.911104, "o", "import { readFileSync } from \"node:fs\";\r\nimport { join } from \"node:path\";\r\nimport { CustomerStore, UnknownCustomer, dataDir } from \"./customers.ts\";\r\nimport { paylarkWebhook } from \"./webhooks/paylark.ts\";\r\n\r\nexport type Request = {\r\n  method: string;\r\n  path: string;\r\n  headers: Record<string, string | undefined>;\r\n  body: Buffer;\r\n};\r\n\r\nexport type Response = { status: number; body: unknown };\r\n\r\nexport type Context = {\r\n  now: Date;\r\n  dataDir: string;\r\n  secrets: Record<string, string>;\r\n};\r\n\r\nexport type Handler = (req: Request, ctx: Context) => Response;\r\n\r\n/** Webhook signing secrets, from config/secrets.json (mounted from the vault in production). */\r\nexport function loadSecrets(dir = join(import.meta.dirname, \"..\", \"config\")): Record<string, string> {\r\n  return JSON.parse(readFileSync(join(dir, \"secrets.json\"), \"utf8\"));\r\n}\r\n\r\nconst customerView: Handler = (req, ctx) => {\r\n  const id = req.path.split(\"/\")[3] ?? \"\";\r\n  try {\r\n    const c = new CustomerStore(ctx.dataDir).get(id);\r\n    return { status:"]
[13.911175, "o", " 200, body: { id: c.id, kyc_status: c.kyc_status, kyc_updated_at: c.kyc_updated_at } };\r\n  } catch (err) {\r\n    if (err instanceof UnknownCustomer) return { status: 404, body: { error: err.message } };\r\n    throw err;\r\n  }\r\n};\r\n\r\nconst routes: Array<{ method: string; pattern: RegExp; handler: Handler }> = [\r\n  { method: \"GET\", pattern: /^\\/healthz$/, handler: () => ({ status: 200, body: { ok: true } }) },\r\n  { method: \"GET\", pattern: /^\\/internal\\/customers\\/[^/]+$/, handler: customerView },\r\n  { method: \"POST\", pattern: /^\\/webhooks\\/paylark$/, handler: paylarkWebhook },\r\n];\r\n\r\n/** Routes one request. Normalises header names to lower case first. */\r\nexport function handle(req: Request, ctx: Partial<Context> = {}): Response {\r\n  const headers: Record<string, string | undefined> = {};\r\n  for (const [k, v] of Object.entries(req.headers)) headers[k.toLowerCase()] = v;\r\n  const full: Context = {\r\n    now: ctx.now ?? new Date(),\r\n    dataDir: ctx.dataDir ?? dataDir(),\r\n    secrets: ctx.secrets ?? loadSecrets(),\r\n "]
[13.911191, "o", " };\r\n  const route = routes.find((r) => r.method === "]
[13.911621, "o", "req.method && r.pattern.test(req.path));\r\n  if (!route) return { status: 404, body: { error: \"not found\" } };\r\n  try {\r\n    return route.handler({ ...req, headers }, full);\r\n  } catch (err) {\r\n    if (err instanceof SyntaxError) return { status: 400, body: { error: \"invalid JSON\" } };\r\n    throw err;\r\n  }\r\n}\r\n"]
[13.911968, "o", "import { record } from \"../audit.ts\";\r\nimport { CustomerStore } from \"../customers.ts\";\r\nimport { SignatureError, verify } from \"../signature.ts\";\r\nimport type { Handler } from \"../app.ts\";\r\n\r\ntype PaylarkEvent = {\r\n  id: string;\r\n  type: \"payment.settled\" | \"payment.refunded\" | string;\r\n  data: { customer: string; amount_minor: number; currency: string; payment_id: string };\r\n};\r\n\r\n/**\r\n * Paylark, our card acquirer, tells us when a top-up settles or is refunded.\r\n * Paylark retries any non-2xx response for up to three days.\r\n */\r\nexport const paylarkWebhook: Handler = (req, ctx) => {\r\n  try {\r\n    verify(ctx.secrets.paylark, req.headers[\"paylark-signature\"], req.body, ctx.now);\r\n  } catch (err) {\r\n    if (err instanceof SignatureError) return { status: 401, body: { error: err.message } };\r\n    throw err;\r\n  }\r\n  const event = JSON.parse(req.body.toString(\"utf8\")) as PaylarkEvent;\r\n  const store = new CustomerStore(ctx.dataDir);\r\n  if (!store.has(event.data.customer)) return { status: 404, body: { error: \"un"]
[13.91216, "o", "known customer\" } };\r\n  const customer = store.get(event.data.customer);\r\n  if (customer.processed_events.includes(event.id)) return { status: 200, body: { duplicate: true } };\r\n\r\n  if (event.type === \"payment.settled\") customer.balance_minor += event.data.amount_minor;\r\n  else if (event.type === \"payment.refunded\") customer.balance_minor -= event.data.amount_minor;\r\n  else return { status: 200, body: { ignored: event.type } };\r\n\r\n  store.markProcessed(customer, event.id);\r\n  store.save();\r\n  record(`paylark.${event.type}`, {\r\n    actor: \"paylark\",\r\n    subject: customer.id,\r\n    details: { event_id: event.id, balance_minor: customer.balance_minor, event },\r\n    at: ctx.now,\r\n  });\r\n  return { status: 200, body: { ok: true } };\r\n};\r\n"]
[13.912584, "o", "import { readFileSync, renameSync, writeFileSync } from \"node:fs\";\r\nimport { join } from \"node:path\";\r\n\r\nexport type KycStatus = \"pending_kyc\" | \"manual_review\" | \"verified\" | \"rejected\";\r\n\r\nexport type Customer = {\r\n  id: string;\r\n  email: string;\r\n  name: string;\r\n  country: string;\r\n  plan: \"personal\" | \"business\";\r\n  kyc_status: KycStatus;\r\n  kyc_check_id: string | null;\r\n  kyc_updated_at: string | null;\r\n  balance_minor: number;\r\n  processed_events: string[];\r\n};\r\n\r\nexport class UnknownCustomer extends Error {\r\n  constructor(id: string) {\r\n    super(`no such customer: ${id}`);\r\n    this.name = \"UnknownCustomer\";\r\n  }\r\n}\r\n\r\n/** Allowed KYC transitions. A final decision can only be revisited by a person. */\r\nconst TRANSITIONS: Record<KycStatus, KycStatus[]> = {\r\n  pending_kyc: [\"manual_review\", \"verified\", \"rejected\"],\r\n  manual_review: [\"verified\", \"rejected\", \"manual_review\"],\r\n  verified: [],\r\n  rejected: [],\r\n};\r\n\r\nexport function canMove(from: KycStatus, to: KycStatus): boolean {\r\n  return TRANSITIONS"]
[13.912613, "o", "[from].includes(to);\r\n}\r\n\r\nexport function dataDir(): string {\r\n  return process.env.APP_DATA ?? join(import.meta.dirname, \"..\", \"data\");\r\n}\r\n\r\nexport class CustomerStore {\r\n  private readonly file: string;\r\n  private customers: Map<string, Customer>;\r\n\r\n  constructor(dir = dataDir()) {\r\n    this.file = join(dir, \"customers.json\");\r\n    const rows = JSON.parse(readFileSync(this.file, \"utf8\")) as Customer[];\r\n    this.customers = new Map(rows.map((c) => [c.id, c]));\r\n  }\r\n\r\n  get(id: string): Customer {\r\n    const customer = this.customers.get(id);\r\n    if (!customer) throw new UnknownCustomer(id);\r\n    return customer;\r\n  }\r\n\r\n  has(id: string): boolean {\r\n    return this.customers.has(id);\r\n  }\r\n\r\n  all(): Customer[] {\r\n    return [...this.customers.values()];\r\n  }\r\n\r\n  /** Records that a provider event was handled, so a redelivery is a no-op. */\r\n  markProcessed(customer: Customer, eventId: string): void {\r\n    customer.processed_events = [...customer.processed_events.slice(-49), eventId];\r\n  }\r\n\r\n  save():"]
[13.91279, "o", " void {\r\n    const rows = [...this.customers.values()].sort((a, b) => a.id.localeCompare(b.id));\r\n    writeFileSync(`${this.file}.tmp`, JSON.stringify(rows, null, 2) + \"\\n\");\r\n    renameSync(`${this.file}.tmp`, this.file);\r\n  }\r\n}\r\nimport { appendFileSync, mkdirSync } from \"node:fs\";\r\nimport { dirname } from \"node:path\";\r\n\r\nexport type AuditEntry = {\r\n  at: string;\r\n  type: string;\r\n  actor: string;\r\n  subject: string | null;\r\n  details: Record<string, unknown>;\r\n};\r\n\r\nexport function auditPath(): string {\r\n  return process.env.AUDIT_LOG ?? \"/var/tmp/audit/audit.ndjson\";\r\n}\r\n\r\n/**\r\n * Appends one entry to the audit trail. The file is tailed by the log\r\n * shipper and indexed in Logline (see docs/operations.md).\r\n */\r\nexport function record(\r\n  type: string,\r\n  fields: { actor: string; subject?: string | null; details?: Record<string, unknown>; at: Date },\r\n): AuditEntry {\r\n  const entry: AuditEntry = {\r\n    at: fields.at.toISOString(),\r\n    type,\r\n    actor: fields.actor,\r\n    subject: fields.subject ?? null,"]
[13.912809, "o", "\r\n    details: fields.details ?? {},\r\n  };\r\n  const file = auditPath();\r\n  mkdirSync(dirname(file), { recursive: true });\r\n  appendFileSync(file, JSON.stringify(entry) + \"\\n\");\r\n  return entry;\r\n}\r\nimport { createHmac, timingSafeEqual } from \"node:crypto\";\r\n\r\nexport class SignatureError extends Error {\r\n  constructor(message: string) {\r\n    super(message);\r\n    this.name = \"SignatureError\";\r\n  }\r\n}\r\n\r\n/** Parses \"t=1700000000,v1=abcdef...\" into its parts. */\r\nexport function parseHeader(header: string | undefined): { timestamp: number; signatures: string[] } {\r\n  if (!header) throw new SignatureError(\"missing signature header\");\r\n  let timestamp = NaN;\r\n  const signatures: string[] = [];\r\n  for (const part of header.split(\",\")) {\r\n    const [key, value] = part.trim().split(\"=\", 2);\r\n    if (key === \"t\") timestamp = Number(value);\r\n    else if (key === \"v1\" && value) signatures.push(value);\r\n  }\r\n  if (!Number.isInteger(timestamp) || signatures.length === 0) {\r\n    throw new SignatureError(\"malformed signature"]
[13.912859, "o", " header\");\r\n  }\r\n  return { timestamp, signatures };\r\n}\r\n\r\nexport function sign(secret: string, timestamp: number, body: Buffer | string): string {\r\n  return createHmac(\"sha256\", secret).update(`${timestamp}.`).update(body).digest(\"hex\");\r\n}\r\n\r\n/**\r\n * Verifies a provider signature over the raw request body. Both of our\r\n * providers use the same scheme: HMAC-SHA256 over \"<t>.<body>\", hex encoded,\r\n * with the timestamp no more than `toleranceSec` away from `now`.\r\n */\r\nexport function verify(\r\n  secret: string,\r\n  header: string | undefined,\r\n  body: Buffer,\r\n  now: Date,\r\n  toleranceSec = 300,\r\n): void {\r\n  const { timestamp, signatures } = parseHeader(header);\r\n  const skew = Math.abs(now.getTime() / 1000 - timestamp);\r\n  if (skew > toleranceSec) throw new SignatureError(`timestamp outside tolerance (${Math.round(skew)}s)`);\r\n  const expected = Buffer.from(sign(secret, timestamp, body), \"hex\");\r\n  const ok = signatures.some((candidate) => {\r\n    const given = Buffer.from(candidate, \"hex\");\r\n    return give"]
[13.913103, "o", "n.length === expected.length && timingSafeEqual(given, expected);\r\n  });\r\n  if (!ok) throw new SignatureError(\"signature mismatch\");\r\n}\r\n"]
[13.913139, "o", "import { createServer } from \"node:http\";\r\nimport { readFileSync } from \"node:fs\";\r\nimport { handle } from \"./app.ts\";\r\n\r\n/**\r\n * Two ways in:\r\n *   node src/server.ts                       listen on $PORT (default 8080)\r\n *   node src/server.ts replay <request.json> [--now ISO]\r\n *       run one captured request through the router and print the response.\r\n *       request.json is {\"method\",\"path\",\"headers\",{\"body\"|\"body_base64\"}}.\r\n */\r\nconst [, , command, file, flag, nowArg] = process.argv;\r\n\r\nif (command === \"replay\") {\r\n  const captured = JSON.parse(readFileSync(file, \"utf8\"));\r\n  const body = captured.body_base64 !== undefined\r\n    ? Buffer.from(captured.body_base64, \"base64\")\r\n    : Buffer.from(typeof captured.body === \"string\" ? captured.body : JSON.stringify(captured.body));\r\n  const now = flag === \"--now\" && nowArg ? new Date(nowArg) : new Date();\r\n  const res = handle({ method: captured.method, path: captured.path, headers: captured.headers ?? {}, body }, { now });\r\n  process.stdout.write(JSON.strin"]
[13.913657, "o", "gify(res) + \"\\n\");\r\n} else {\r\n  const port = Number(process.env.PORT ?? 8080);\r\n  createServer((req, res) => {\r\n    const chunks: Buffer[] = [];\r\n    req.on(\"data\", (c: Buffer) => chunks.push(c));\r\n    req.on(\"end\", () => {\r\n      const headers: Record<string, string | undefined> = {};\r\n      for (const [k, v] of Object.entries(req.headers)) headers[k] = Array.isArray(v) ? v.join(\",\") : v;\r\n      const out = handle({ method: req.method ?? \"GET\", path: (req.url ?? \"/\").split(\"?\")[0], headers, body: Buffer.concat(chunks) });\r\n      res.writeHead(out.status, { \"content-type\": \"application/json\" });\r\n      res.end(JSON.stringify(out.body));\r\n    });\r\n  }).listen(port, () => console.log(`listening on ${port}`));\r\n}\r\n"]
