[69.291666, "i", ".AUDIT_LOG = auditPath;\n  t.after(() => {\n    if (previousAudit === undefined) delete process.env.AUDIT_LOG;\n    else process.env.AUDIT_LOG = previousAudit;\n    rmSync(dir, { recursive: true, force: true });\n  });\n  const file = join(dir, \"customers.json\");\n  return {\n    file,\n    customers: () => JSON.parse(readFileSync(file, \"utf8\")) as Customer[],\n    audit: () => existsSync(auditPath)\n      ? readFileSync(auditPath, \"utf8\").trim().split(\"\\n\").map((line) => JSON.parse(line) as AuditEntry)\n      : [],\n    request(body: Buffer, signature: string | undefined) {\n      return handle({ method: \"POST\", path: \"/webhooks/veriform\", headers: { \"Veriform-Signature\": signature }, body },\n        { now: NOW, dataDir: dir, secrets: SECRETS });\n    },\n    send(event: object) {\n      const body = Buffer.from(JSON.stringify(event));\n      return this.request(body, `t=${T},v1=${sign(SECRETS.veriform, T, body)}`);\n    },\n    view(id: string) {\n      return handle({ method: \"GET\", path: `/internal/customers/${id}`, headers: "]
[69.291837, "i", "{}, body: Buffer.alloc(0) },\n        { now: NOW, dataDir: dir, secrets: SECRETS });\n    },\n  };\n}\n\nfunction completed(result: \"clear\" | \"consider\" | \"rejected\" = \"clear\", reference = \"cus_1002\") {\n  return {\n    id: \"evt_v1\", type: \"check.completed\", created: T - 3600,\n    data: { check: {\n      id: \"chk_v1\", reference, result, completed_at: \"2026-11-16T09:00:00Z\",\n      reasons: result === \"clear\" ? [] : [\n        { code: \"DOC_EXPIRED\", message: \"Passport 533401187 expired on 2025-04-30\", internal: \"do not copy\" },\n        { code: \"NAME_MISMATCH\", message: \"Document name does not match applicant: Daniel Okafor\" },\n        { code: \"NEW_PROVIDER_CODE\", message: \"Provider's new explanation, kept verbatim.\" },\n      ],\n      applicant: { full_name: \"Daniel Okafor\", date_of_birth: \"1991-07-22\" },\n      document: { number: \"533401187\" },\n      liveness: { selfie_url: \"https://files.veriform.example/private.jpg\" },\n    } },\n  };\n}\n\nfor (const [result, status] of [[\"clear\", \"verified\"], [\"consider\", \"manual_review\"]"]
