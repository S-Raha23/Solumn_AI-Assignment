[69.292175, "i", "ing\")).status, 404);\n  assert.equal(readFileSync(f.file, \"utf8\"), before);\n  assert.deepEqual(f.audit(), []);\n});\n\ntest(\"duplicate review decision does not update the customer or append another audit entry\", (t) => {\n  const f = fixture(t);\n  const event = completed(\"consider\");\n  assert.equal(f.send(event).status, 200);\n  const before = readFileSync(f.file, \"utf8\");\n  const audit = f.audit();\n  event.data.check.id = \"chk_changed\";\n  event.data.check.completed_at = NOW.toISOString();\n  assert.equal(f.send(event).status, 200);\n  assert.equal(readFileSync(f.file, \"utf8\"), before);\n  assert.deepEqual(f.audit(), audit);\n});\n\ntest(\"unrelated event types are ignored even without check details\", (t) => {\n  const f = fixture(t);\n  const before = readFileSync(f.file, \"utf8\");\n  for (const type of [\"check.started\", \"check.reminder\", \"future.event\"]) {\n    assert.equal(f.send({ id: `evt_${type}`, type }).status, 200);\n  }\n  assert.equal(readFileSync(f.file, \"utf8\"), before);\n  assert.deepEqual(f.audit(), []);\n});\n\nfor ("]
