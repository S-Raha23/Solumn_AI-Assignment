[69.351385, "o", "test(\"successful decisions retain only the last 50 processed event ids\", (t) => {\r\n\u001b[?2004l\r"]
[69.351408, "o", "\u001b[?2004h"]
[69.351534, "o", ">   const f = fixture(t);\r\n\u001b[?2004l\r"]
[69.351596, "o", "\u001b[?2004h"]
[69.35161, "o", "> "]
[69.351725, "o", "  const customers = f.customers();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.352046, "o", "  const customer = customers.find((c) => c.id === \"cus_1002\")!;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.352397, "o", "  customer.processed_events = Array.from({ length: 50 }, (_, i) => `evt_old_${i}`);\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.352465, "o", "> "]
[69.352719, "o", "  const previous = [...customer.processed_events];\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.352758, "o", "> "]
[69.352953, "o", "  writeFileSync(f.file, JSON.stringify(customers));\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.35298, "o", "> "]
[69.353275, "o", "  assert.equal(f.send(completed()).status, 200);\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.353301, "o", "> "]
[69.353863, "o", "  assert.deepEqual(f.customers().find((c) => c.id === customer.id)!.processed_events, [...previous.slice(1), \"evt_v1\"]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.353892, "o", "> });\r\n\u001b[?2004l\r"]
