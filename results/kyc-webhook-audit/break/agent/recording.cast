[69.983256, "o", "\u001b[32m✔ verify accepts a good signature and rejects tampering and stale timestamps \u001b[90m(2.024368ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ settled payment credits the balance once and is audited \u001b[90m(14.260986ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ bad signature, unknown customer and unknown route \u001b[90m(1.930832ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ customer view shows KYC status only \u001b[90m(1.289662ms)\u001b[39m\u001b[39m\r\n"]
[70.030886, "o", "\u001b[32m✔ clear saves verified and audits all reason explanations, but not the raw check \u001b[90m(14.332723ms)\u001b[39m\u001b[39m\r\n"]
[70.04225, "o", "\u001b[32m✔ consider saves manual_review and audits all reason explanations, but not the raw check \u001b[90m(3.337973ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejected saves rejected and audits all reason explanations, but not the raw check \u001b[90m(2.094768ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authentication errors and invalid JSON have no side effects \u001b[90m(2.480587ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ unknown reference returns 404 without writes or audit \u001b[90m(3.047454ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ duplicate review decision does not update the customer or append another audit entry \u001b[90m(3.938187ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ unrelated event types are ignored even without check details \u001b[90m(2.854347ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ final decision for cus_1001 cannot be changed \u001b[90m(2.49532ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ final decision for cus_1005 cannot be changed \u001b[90m(2.417445ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ manual_review allows clear \u001b[90m(4.197025ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ manual_review allows consider \u001b[90m(2.233803ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ manual_review allows rejected \u001b[90m(2.145713ms)\u001b[39m\u001b[39m\r"]
[70.043175, "o", "\n\u001b[32m✔ older checks are ignored by instant, not timestamp spelling or event creation time \u001b[90m(3.381892ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ successful decisions retain only the last 50 processed event ids \u001b[90m(3.612293ms)\u001b[39m\u001b[39m\r\n"]
