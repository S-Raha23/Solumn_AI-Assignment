[90.567177, "o", "\u001b[1mdiff --git a/docs/operations.md b/docs/operations.md\u001b[m\u001b[m\r\n\u001b[1mindex f5a025b..2c531bb 100755\u001b[m\u001b[m\r\n\u001b[1m--- a/docs/operations.md\u001b[m\u001b[m\r\n\u001b[1m+++ b/docs/operations.md\u001b[m\u001b[m\r\n\u001b[36m@@ -23,6 +23,7 @@\u001b[m \u001b[mCustomers live in `$APP_DATA/customers.json` (default `data/`). `kyc_status` mov\u001b[m\u001b[m\r\n | Route | Provider | Secret (`config/secrets.json`) | Header |\u001b[m\u001b[m\r\n | --- | --- | --- | --- |\u001b[m\u001b[m\r\n | `POST /webhooks/paylark` | Paylark (card top-ups) | `paylark` | `Paylark-Signature` |\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m| `POST /webhooks/veriform` | Veriform (identity checks) | `veriform` | `Veriform-Signature` |\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n Both providers sign `\"<t>.<raw body>\"` with HMAC-SHA256 (`src/signature.ts`) and retry any\u001b[m\u001b[m\r\n non-2xx response, so handlers must be idempotent and must answer 2xx only once the change is\u001b[m\u001b[m\r\n\u001b[1mdiff --git a/src/app.ts b/src/app.ts\u001b[m\u001b[m\r\n\u001b[1mindex 3da3eb6..67a2ea1 100755\u001b[m\u001b[m\r\n\u001b[1m--- a/src/app.ts\u001b[m\u001b[m\r\n\u001b[1m+++ b/src/app.ts\u001b[m\u001b[m\r\n\u001b[36m@@ -2,6 +2,7 @@\u001b[m \u001b[mimport { readFileSync } from \"no"]
[90.567377, "o", "de:fs\";\u001b[m\u001b[m\r\n import { join } from \"node:path\";\u001b[m\u001b[m\r\n import { CustomerStore, UnknownCustomer, dataDir } from \"./customers.ts\";\u001b[m\u001b[m\r\n import { paylarkWebhook } from \"./webhooks/paylark.ts\";\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { veriformWebhook } from \"./webhooks/veriform.ts\";\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n export type Request = {\u001b[m\u001b[m\r\n   method: string;\u001b[m\u001b[m\r\n\u001b[36m@@ -40,6 +41,7 @@\u001b[m \u001b[mconst routes: Array<{ method: string; pattern: RegExp; handler: Handler }> = [\u001b[m\u001b[m\r\n   { method: \"GET\", pattern: /^\\/healthz$/, handler: () => ({ status: 200, body: { ok: true } }) },\u001b[m\u001b[m\r\n   { method: \"GET\", pattern: /^\\/internal\\/customers\\/[^/]+$/, handler: customerView },\u001b[m\u001b[m\r\n   { method: \"POST\", pattern: /^\\/webhooks\\/paylark$/, handler: paylarkWebhook },\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  { method: \"POST\", pattern: /^\\/webhooks\\/veriform$/, handler: veriformWebhook },\u001b[m\u001b[m\r\n ];\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n /** Routes one request. Normalises header names to lower case first. */\u001b[m\u001b[m\r\n"]
