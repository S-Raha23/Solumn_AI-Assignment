[76.179743, "i", "cat > helpdesk/escalation.py <<'PY'\n\"\"\"Prepare vendor cases and escalate hardware faults through the workflow.\"\"\"\nfrom __future__ import annotations\n\nfrom datetime import datetime\n\nfrom . import vendors, workflow\nfrom .similarity import similar_tickets\nfrom .store import Store\n\n\ndef prepare_case(store: Store, ticket: dict, *, by: str) -> tuple[dict, dict]:\n    \"\"\"Validate an escalation and return (vendor, case), without side effects.\"\"\"\n    staff = store.staff(by)\n    device = store.device_for(ticket)\n    if device is None:\n        raise vendors.VendorError(f\"{ticket['id']} has no device\")\n    vendor = vendors.vendor(device.get(\"vendor_id\"), directory=store.directory)\n    for field in vendor[\"required_device_fields\"]:\n        if not device.get(field):\n            raise vendors.VendorError(f\"{device['id']} is missing required device field: {field}\")\n    current = ticket[\"status\"]\n    if \"escalated\" not in workflow.TRANSITIONS.get(current, set()):\n        raise workflow.WorkflowError(f\"{ticket['id']} is {curren"]
[76.17989, "i", "t}; it cannot become escalated\")\n\n    account = store.account(device[\"account_id\"])\n    work_notes = sorted(\n        (note for note in ticket.get(\"notes\", []) if note[\"kind\"] == \"work\"),\n        key=lambda note: datetime.fromisoformat(note[\"at\"]),\n    )\n    case = {\n        \"case_ref\": \"TF-\" + ticket[\"id\"],\n        \"opened_for\": {\n            \"account\": account[\"name\"],\n            \"site\": account[\"site\"],\n            \"contact\": ticket[\"requester\"],\n        },\n        \"device\": {field: device[field] for field in (\"model\", *vendor[\"required_device_fields\"])},\n        \"problem\": {\n            \"subject\": ticket[\"subject\"],\n            \"description\": ticket[\"body\"],\n            \"reported_at\": ticket[\"opened_at\"],\n        },\n        \"steps_taken\": [note[\"body\"] for note in work_notes],\n        \"prior_cases\": [\n            {\"ticket\": other[\"id\"], \"resolution\": other[\"resolution\"]}\n            for _, other in similar_tickets(store, ticket, k=3)\n        ],\n        \"handled_by\": {field: staff[field] for field in (\"nam"]
[76.179903, "i", "e\", \"email\")},\n    }\n    return vendor, case\n\n\ndef escalate(store: Store, ticket: dict, *, by: str, at: str) -> tuple[dict, str]:\n    \"\"\"File a case, then update and save the ticket. Return (vendor, case number).\"\"\"\n    vendor, case = prepare_case(store, ticket, by=by)\n    number = vendors.submit_case(vendor[\"id\"], case, submitted_at=at, directory=store.directory)\n    workflow.change_status(store, ticket, \"escalated\", by=by, at=at)\n    ticket[\"vendor_case\"] = {\"vendor\": vendor[\"id\"], \"number\": number, \"submitted_at\": at}\n    workflow.add_note(\n        store, ticket, kind=\"system\", author=\"system\",\n        body=f\"Escalated to {vendor['name']} as {number}\", at=at,\n    )\n    store.save_tickets()\n    return vendor, number\nPY\npython - <<'PY'\nfrom pathlib import Path\np = Path('helpdesk/cli.py')\ns = p.read_text().replace('import argparse\\n', 'import argparse\\nimport json\\n').replace('from . import workflow', 'from . import escalation, workflow')\ns = s.replace('\\ndef build_parser()', '''\ndef cmd_escalate(store: Store"]
[76.179911, "i", ", args) -> int:\n    ticket = store.ticket(args.ticket)\n    if args.dry_run:\n        _, case = escalation.prepare_case(store, ticket, by=args.by)\n        print(json.dumps(case, indent=2, ensure_ascii=False))\n    else:\n        vendor, number = escalation.escalate(store, ticket, by=args.by, at=_now(args.now))\n        print(f\"{ticket['id']} escalated to {vendor['name']}: {number}\")\n    return 0\n\n\ndef build_parser()''')\ns = s.replace('    return parser\\n', '''    p = sub.add_parser(\"escalate\", help=\"file a vendor case and escalate a hardware ticket\")\n    p.add_argument(\"ticket\")\n    p.add_argument(\"--by\", required=True)\n    p.add_argument(\"--now\")\n    p.add_argument(\"--dry-run\", action=\"store_true\")\n    p.set_defaults(func=cmd_escalate)\n    return parser\n''')\np.write_text(s)\np = Path('docs/overview.md')\ns = p.read_text().replace('python -m helpdesk resolve TICKET --by STAFF --resolution TEXT\\n', 'python -m helpdesk resolve TICKET --by STAFF --resolution TEXT\\npython -m helpdesk escalate TICKET --by STAFF [--now IS"]
[76.179918, "i", "O-8601] [--dry-run]\\n')\ns = s.replace('Every command that writes accepts', 'Escalation files a vendor case for the device, attaches up to three similar earlier resolved\\ntickets and their fixes, and moves the ticket to `escalated`. Use `--dry-run` to validate and\\nprint the case JSON without filing it or changing the ticket.\\n\\nEvery command that writes accepts')\np.write_text(s)\nPY\n"]
