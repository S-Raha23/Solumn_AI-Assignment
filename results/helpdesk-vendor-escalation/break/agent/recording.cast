[145.382548, "o", "usage: helpdesk escalate [-h] --by BY [--now NOW] [--dry-run] ticket\r\n\r\npositional arguments:\r\n  ticket\r\n\r\noptions:\r\n  -h, --help  show this help message and exit\r\n  --by BY\r\n  --now NOW\r\n  --dry-run\r\n"]
[145.561404, "o", "{\r\n  \"case_ref\": \"TF-HD-3301\",\r\n  \"opened_for\": {\r\n    \"account\": \"Calder Street Dental\",\r\n    \"site\": \"22 Calder Street, Leeds\",\r\n    \"contact\": {\r\n      \"name\": \"Hannah Whitlock\",\r\n      \"email\": \"reception@calderstreetdental.example\",\r\n      \"phone\": \"0113 496 0182\"\r\n    }\r\n  },\r\n  \"device\": {\r\n    \"model\": \"Kestrel LP-440\",\r\n    \"serial\": \"KLP440-7C21904\",\r\n    \"firmware\": \"3.2.1\"\r\n  },\r\n  \"problem\": {\r\n    \"subject\": \"Label printer prints blank labels after ribbon change\",\r\n    \"description\": \"Since we swapped the ribbon on Monday the label printer at reception feeds labels but they come out completely blank. We have tried two new ribbons.\",\r\n    \"reported_at\": \"2026-11-02T08:50:00Z\"\r\n  },\r\n  \"steps_taken\": [\r\n    \"Reloaded the ribbon, ink side confirmed facing the media. Labels still blank.\",\r\n    \"Ran media calibration and a factory reset. Print head self-test fails with code H-07.\"\r\n  ],\r\n  \"prior_cases\": [\r\n    {\r\n      \"ticket\": \"HD-3127\",\r\n      \"resolution\": \"Priya Okonkwo had loaded the ribbon in"]
[145.56145, "o", "k side out. Reloaded it with her and ran media calibration (hold FEED for 5 seconds).\"\r\n    },\r\n    {\r\n      \"ticket\": \"HD-3050\",\r\n      \"resolution\": \"Wrong media type in the driver after Gethin reinstalled the till PC. Switched from direct thermal to thermal transfer and reprinted.\"\r\n    },\r\n    {\r\n      \"ticket\": \"HD-2954\",\r\n      \"resolution\": \"Print head was dirty. Cleaned the head with an isopropyl swab and raised darkness to 12.\"\r\n    }\r\n  ],\r\n  \"handled_by\": {\r\n    \"name\": \"Imogen Hart\",\r\n    \"email\": \"imogen.hart@tesselfieldworks.example\"\r\n  }\r\n}\r\n"]
