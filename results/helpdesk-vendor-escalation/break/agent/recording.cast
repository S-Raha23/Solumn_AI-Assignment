[22.710801, "o", "\"\"\"Finds earlier tickets that look like the one an agent is working on.\r\n\r\nPowers the \"suggested fixes\" panel (`python -m helpdesk suggest`). Staff see\r\nmatches from every client, because the same printer fails the same way no\r\nmatter whose counter it sits on.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport math\r\nimport re\r\nfrom collections import Counter\r\n\r\nfrom .store import Store\r\n\r\nSTOPWORDS = frozenset(\r\n    \"a an and are as at be been but by can cannot for from had has have if in is it its \"\r\n    \"no not of on or our so that the their them then there this to us was we when will with\".split()\r\n)\r\nSAME_MODEL_BONUS = 0.15\r\n\r\n\r\ndef tokens(text: str) -> list[str]:\r\n    return [w for w in re.findall(r\"[a-z0-9][a-z0-9-]+\", text.lower()) if w not in STOPWORDS]\r\n\r\n\r\ndef _document(ticket: dict) -> list[str]:\r\n    return tokens(f\"{ticket['subject']} {ticket['subject']} {ticket['body']}\")\r\n\r\n\r\ndef _vector(words: list[str], idf: dict[str, float]) -> dict[str, float]:\r\n    counts = Counter(words)\r\n    return {word"]
[22.711623, "o", ": (1 + math.log(n)) * idf.get(word, 0.0) for word, n in counts.items()}\r\n\r\n\r\ndef _cosine(a: dict[str, float], b: dict[str, float]) -> float:\r\n    dot = sum(weight * b.get(word, 0.0) for word, weight in a.items())\r\n    norm = math.sqrt(sum(w * w for w in a.values())) * math.sqrt(sum(w * w for w in b.values()))\r\n    return dot / norm if norm else 0.0\r\n\r\n\r\ndef similar_tickets(store: Store, ticket: dict, k: int = 3, resolved_only: bool = True) -> list[tuple[float, dict]]:\r\n    \"\"\"The `k` tickets most similar to `ticket`, best first, as (score, ticket).\r\n\r\n    Similarity is TF-IDF cosine over subject and body, plus a small bonus when\r\n    both tickets are about the same device model. The ticket itself and\r\n    tickets opened after it are never returned.\r\n    \"\"\"\r\n    corpus = store.tickets()\r\n    documents = {t[\"id\"]: _document(t) for t in corpus}\r\n    doc_freq = Counter(word for words in documents.values() for word in set(words))\r\n    idf = {word: math.log((1 + len(corpus)) / (1 + n)) + 1 for word, n in doc_freq."]
[22.711668, "o", "items()}\r\n\r\n    target = _vector(_document(ticket), idf)\r\n    target_device = store.device_for(ticket)\r\n    scored = []\r\n    for other in corpus:\r\n        if other[\"id\"] == ticket[\"id\"] or other[\"opened_at\"] >= ticket[\"opened_at\"]:\r\n            continue\r\n        if resolved_only and other[\"status\"] != \"resolved\":\r\n            continue\r\n        score = _cosine(target, _vector(documents[other[\"id\"]], idf))\r\n        other_device = store.device_for(other)\r\n        if target_device and other_device and target_device[\"model\"] == other_device[\"model\"]:\r\n            score += SAME_MODEL_BONUS\r\n        if score > 0:\r\n            scored.append((round(score, 4), other))\r\n    scored.sort(key=lambda pair: (-pair[0], pair[1][\"id\"]))\r\n    return scored[:k]\r\n\"\"\"Hardware vendors and their partner portals.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport os\r\nfrom pathlib import Path\r\n\r\nfrom .store import data_dir\r\n\r\n\r\nclass VendorError(Exception):\r\n    \"\"\"A vendor is unknown, or its portal rejected a case.\"\"\"\r\n\r\n\r\n"]
[22.711949, "o", "def portal_root() -> Path:\r\n    return Path(os.environ.get(\"VENDOR_PORTAL_ROOT\", \"/var/tmp/vendor-portal\"))\r\n\r\n\r\ndef load_vendors(directory: Path | None = None) -> dict[str, dict]:\r\n    path = (Path(directory) if directory else data_dir()) / \"vendors.json\"\r\n    return {vendor[\"id\"]: vendor for vendor in json.loads(path.read_text(encoding=\"utf-8\"))}\r\n\r\n\r\ndef vendor(vendor_id: str, directory: Path | None = None) -> dict:\r\n    try:\r\n        return load_vendors(directory)[vendor_id]\r\n    except KeyError:\r\n        raise VendorError(f\"unknown vendor: {vendor_id}\") from None\r\n\r\n\r\ndef submit_case(vendor_id: str, case: dict, *, submitted_at: str, directory: Path | None = None) -> str:\r\n    \"\"\"Files a support case on a vendor's partner portal and returns its case number.\r\n\r\n    There is no network in this image: the portal is a stand-in that stores\r\n    each case exactly as posted under <portal root>/<vendor id>/.\r\n    \"\"\"\r\n    entry = vendor(vendor_id, directory)\r\n    missing = [name for name in (\"case_ref\", \"device\","]
[22.711964, "o", " \"problem\") if not case.get(name)]\r\n    if missing:\r\n        raise VendorError(f\"{entry['name']} portal rejected the case: missing {', '.join(missing)}\")\r\n    inbox = portal_root() / vendor_id\r\n    inbox.mkdir(parents=True, exist_ok=True)\r\n    number = f\"{entry['case_prefix']}-{len(list(inbox.glob('*.json'))) + 1:06d}\"\r\n    request = {\r\n        \"portal\": entry[\"portal_url\"],\r\n        \"case_number\": number,\r\n        \"received_at\": submitted_at,\r\n        \"case\": case,\r\n    }\r\n    (inbox / f\"{number}.json\").write_text(json.dumps(request, indent=2, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\r\n    return number\r\n\u001b[?2004hroot@a152dd6cafc5:/app# "]
