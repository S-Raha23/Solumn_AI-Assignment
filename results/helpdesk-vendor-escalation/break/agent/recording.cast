[16.203851, "o", "\"\"\"Command line for helpdesk staff: python -m helpdesk <command>.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport sys\r\nfrom datetime import datetime, timezone\r\n\r\nfrom . import workflow\r\nfrom .similarity import similar_tickets\r\nfrom .store import NotFound, Store\r\nfrom .vendors import VendorError\r\n\r\n\r\ndef _now(value: str | None) -> str:\r\n    if value:\r\n        return value\r\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n\r\n\r\ndef cmd_list(store: Store, args) -> int:\r\n    for ticket in store.tickets(account_id=args.account, status=args.status):\r\n        account = store.account(ticket[\"account_id\"])\r\n        print(f\"{ticket['id']}  {ticket['status']:<11}  {account['name']:<26}  {ticket['subject']}\")\r\n    return 0\r\n\r\n\r\ndef cmd_show(store: Store, args) -> int:\r\n    ticket = store.ticket(args.ticket)\r\n    account = store.account(ticket[\"account_id\"])\r\n    device = store.device_for(ticket)\r\n    print(f\"{ticket['id']}  [{ticket['status']}]  {ticket['subject']}\")\r\n    print(f\"acco"]
[16.203931, "o", "unt:   {account['name']}\")\r\n    print(f\"requester: {ticket['requester']['name']} <{ticket['requester']['email']}> {ticket['requester']['phone']}\")\r\n    if device:\r\n        print(f\"device:    {device['model']}  serial {device['serial']}  ({device['vendor_id']})\")\r\n    print(f\"opened:    {ticket['opened_at']}\")\r\n    print()\r\n    print(ticket[\"body\"])\r\n    for note in ticket.get(\"notes\", []):\r\n        print(f\"\\n-- {note['at']} {note['kind']} ({note['author']})\\n{note['body']}\")\r\n    if ticket.get(\"resolution\"):\r\n        print(f\"\\nresolution: {ticket['resolution']}\")\r\n    return 0\r\n\r\n\r\ndef cmd_suggest(store: Store, args) -> int:\r\n    ticket = store.ticket(args.ticket)\r\n    matches = similar_tickets(store, ticket, k=args.k)\r\n    if not matches:\r\n        print(\"no similar resolved tickets\")\r\n        return 0\r\n    for score, other in matches:\r\n        account = store.account(other[\"account_id\"])\r\n        print(f\"{other['id']}  {score:.2f}  {account['name']}: {other['subject']}\")\r\n        print(f\"    fix: {other['res"]
[16.203942, "o", "olution']}\")\r\n    return 0\r\n\r\n\r\ndef cmd_note(store: Store, args) -> int:\r\n    ticket = store.ticket(args.ticket)\r\n    workflow.add_note(store, ticket, kind=args.kind, author=args.by, body=args.body, at=_now(args.now))\r\n    store.save_tickets()\r\n    return 0\r\n\r\n\r\ndef cmd_status(store: Store, args) -> int:\r\n    ticket = store.ticket(args.ticket)\r\n    workflow.change_status(store, ticket, args.status, by=args.by, at=_now(args.now))\r\n    store.save_tickets()\r\n    return 0\r\n\r\n\r\ndef cmd_resolve(store: Store, args) -> int:\r\n    ticket = store.ticket(args.ticket)\r\n    workflow.resolve(store, ticket, by=args.by, resolution=args.resolution, at=_now(args.now))\r\n    store.save_tickets()\r\n    return 0\r\n\r\n\r\ndef build_parser() -> argparse.ArgumentParser:\r\n    parser = argparse.ArgumentParser(prog=\"helpdesk\")\r\n    sub = parser.add_subparsers(dest=\"command\", required=True)\r\n\r\n    p = sub.add_parser(\"list\", help=\"list tickets\")\r\n    p.add_argument(\"--account\")\r\n    p.add_argument(\"--status\", choices=sorted(workflow.TRANSITIONS"]
[16.203951, "o", "))\r\n    p.set_defaults(func=cmd_list)\r\n\r\n    p = sub.add_parser(\"show\", help=\"show one ticket\")\r\n    p.add_argument(\"ticket\")\r\n    p.set_defaults(func=cmd_show)\r\n\r\n    p = sub.add_parser(\"suggest\", help=\"similar resolved tickets and what fixed them\")\r\n    p.add_argument(\"ticket\")\r\n    p.add_argument(\"-k\", type=int, default=3)\r\n    p.set_defaults(func=cmd_suggest)\r\n\r\n    p = sub.add_parser(\"note\", help=\"add a note to a ticket\")\r\n    p.add_argument(\"ticket\")\r\n    p.add_argument(\"--kind\", choices=(\"work\", \"customer\"), default=\"work\")\r\n    p.add_argument(\"--by\", required=True)\r\n    p.add_argument(\"--body\", required=True)\r\n    p.add_argument(\"--now\")\r\n    p.set_defaults(func=cmd_note)\r\n\r\n    p = sub.add_parser(\"status\", help=\"change a ticket's status\")\r\n    p.add_argument(\"ticket\")\r\n    p.add_argument(\"status\", choices=(\"open\", \"in_progress\"))\r\n    p.add_argument(\"--by\", required=True)\r\n    p.add_argument(\"--now\")\r\n    p.set_defaults(func=cmd_status)\r\n\r\n    p = sub.add_parser(\"resolve\", help=\"resolve a ticket\")\r\n "]
[16.203974, "o", "   p.add_argument(\"ticket\")\r\n    p.add_argument(\"--by\", required=True)\r\n    p.add_argument(\"--resolution\", required=True)\r\n    p.add_argument(\"--now\")\r\n    p.set_defaults(func=cmd_resolve)\r\n    return parser\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    args = build_parser().parse_args(argv)\r\n    try:\r\n        return args.func(Store(), args)\r\n    except (NotFound, workflow.WorkflowError, VendorError) as exc:\r\n        print(f\"error: {exc}\", file=sys.stderr)\r\n        return 1\r\n\"\"\"JSON-file backed store for accounts, devices, staff and tickets.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport os\r\nfrom pathlib import Path\r\n\r\n\r\nclass NotFound(KeyError):\r\n    \"\"\"Raised when a record id does not exist.\"\"\"\r\n\r\n    def __str__(self) -> str:  # KeyError would add quotes\r\n        return str(self.args[0])\r\n\r\n\r\ndef data_dir() -> Path:\r\n    return Path(os.environ.get(\"HELPDESK_DATA\", Path(__file__).resolve().parent.parent / \"data\"))\r\n\r\n\r\nclass Store:\r\n    \"\"\"All helpdesk records, loaded from one dir"]
[16.203993, "o", "ectory.\r\n\r\n    Tessel runs the helpdesk for several client organisations (\"accounts\").\r\n    Every ticket and every device belongs to exactly one account.\r\n    \"\"\"\r\n\r\n    FILES = (\"accounts\", \"devices\", \"staff\", \"tickets\")\r\n\r\n    def __init__(self, directory: Path | None = None):\r\n        self.directory = Path(directory) if directory else data_dir()\r\n        for name in self.FILES:\r\n            path = self.directory / f\"{name}.json\"\r\n            records = json.loads(path.read_text(encoding=\"utf-8\"))\r\n            setattr(self, f\"_{name}\", {record[\"id\"]: record for record in records})\r\n\r\n    # -- lookups ---------------------------------------------------------\r\n    def _get(self, kind: str, record_id: str) -> dict:\r\n        try:\r\n            return getattr(self, f\"_{kind}\")[record_id]\r\n        except KeyError:\r\n            raise NotFound(f\"no such {kind.rstrip('s')}: {record_id}\") from None\r\n\r\n    def account(self, account_id: str) -> dict:\r\n        return self._get(\"accounts\", account_id)\r\n\r\n    def device(sel"]
[16.20452, "o", "f, device_id: str) -> dict:\r\n        return self._get(\"devices\", device_id)\r\n\r\n    def staff(self, staff_id: str) -> dict:\r\n        return self._get(\"staff\", staff_id)\r\n\r\n    def ticket(self, ticket_id: str) -> dict:\r\n        return self._get(\"tickets\", ticket_id)\r\n\r\n    def tickets(self, *, account_id: str | None = None, status: str | None = None) -> list[dict]:\r\n        \"\"\"Tickets ordered by opening time, optionally narrowed to an account or status.\"\"\"\r\n        rows = self._tickets.values()\r\n        if account_id is not None:\r\n            rows = [t for t in rows if t[\"account_id\"] == account_id]\r\n        if status is not None:\r\n            rows = [t for t in rows if t[\"status\"] == status]\r\n        return sorted(rows, key=lambda t: (t[\"opened_at\"], t[\"id\"]))\r\n\r\n    def device_for(self, ticket: dict) -> dict | None:\r\n        return self.device(ticket[\"device_id\"]) if ticket.get(\"device_id\") else None\r\n\r\n    # -- writes ----------------------------------------------------------\r\n    def save_tickets(self) -> N"]
[16.204933, "o", "one:\r\n        \"\"\"Writes tickets back atomically, in id order.\"\"\"\r\n        path = self.directory / \"tickets.json\"\r\n        tmp = path.with_suffix(\".json.tmp\")\r\n        rows = [self._tickets[key] for key in sorted(self._tickets)]\r\n        tmp.write_text(json.dumps(rows, indent=2, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\r\n        tmp.replace(path)\r\n\"\"\"Ticket lifecycle: notes and status changes.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom .store import Store\r\n\r\nTRANSITIONS = {\r\n    \"open\": {\"in_progress\", \"resolved\"},\r\n    \"in_progress\": {\"open\", \"escalated\", \"resolved\"},\r\n    \"escalated\": {\"in_progress\", \"resolved\"},\r\n    \"resolved\": set(),\r\n}\r\nNOTE_KINDS = (\"work\", \"customer\", \"system\")\r\n\r\n\r\nclass WorkflowError(Exception):\r\n    \"\"\"An action is not allowed for the ticket in its current state.\"\"\"\r\n\r\n\r\ndef add_note(store: Store, ticket: dict, *, kind: str, author: str, body: str, at: str) -> dict:\r\n    \"\"\"Appends a note. `author` is a staff id, or \"system\".\"\"\"\r\n    if kind not in NOTE_KINDS:\r\n        raise"]
[16.204965, "o", " WorkflowError(f\"unknown note kind: {kind}\")\r\n    if not body.strip():\r\n        raise WorkflowError(\"a note needs a body\")\r\n    if author != \"system\":\r\n        store.staff(author)\r\n    note = {\"at\": at, \"kind\": kind, \"author\": author, \"body\": body.strip()}\r\n    ticket.setdefault(\"notes\", []).append(note)\r\n    return note\r\n\r\n\r\ndef change_status(store: Store, ticket: dict, new_status: str, *, by: str, at: str) -> None:\r\n    \"\"\"Moves a ticket to `new_status` and leaves a system note about it.\"\"\"\r\n    current = ticket[\"status\"]\r\n    if new_status not in TRANSITIONS.get(current, set()):\r\n        raise WorkflowError(f\"{ticket['id']} is {current}; it cannot become {new_status}\")\r\n    store.staff(by)\r\n    ticket[\"status\"] = new_status\r\n    add_note(store, ticket, kind=\"system\", author=\"system\", body=f\"Status {current} -> {new_status} by {by}\", at=at)\r\n\r\n\r\ndef resolve(store: Store, ticket: dict, *, by: str, resolution: str, at: str) -> None:\r\n    \"\"\"Closes a ticket with the fix that worked.\"\"\"\r\n    if not resolution.s"]
[16.204979, "o", "trip():\r\n        raise WorkflowError(\"a resolution is required to resolve a ticket\")\r\n    change_status(store, ticket, \"resolved\", by=by, at=at)\r\n    ticket[\"resolution\"] = resolution.strip()\r\n    ticket[\"resolved_at\"] = at\r\n\u001b[?2004hroot@a152dd6cafc5:/app# "]
