[129.779331, "o", "\u001b[1mdiff --git a/docs/overview.md b/docs/overview.md\u001b[m\u001b[m\r\n\u001b[1mindex aa78206..1297ae3 100755\u001b[m\u001b[m\r\n\u001b[1m--- a/docs/overview.md\u001b[m\u001b[m\r\n\u001b[1m+++ b/docs/overview.md\u001b[m\u001b[m\r\n\u001b[36m@@ -38,8 +38,13 @@\u001b[m \u001b[mpython -m helpdesk suggest TICKET [-k N]\u001b[m\u001b[m\r\n python -m helpdesk note TICKET --by STAFF --body TEXT [--kind work|customer]\u001b[m\u001b[m\r\n python -m helpdesk status TICKET open|in_progress --by STAFF\u001b[m\u001b[m\r\n python -m helpdesk resolve TICKET --by STAFF --resolution TEXT\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mpython -m helpdesk escalate TICKET --by STAFF [--now ISO-8601] [--dry-run]\u001b[m\u001b[m\r\n ```\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mEscalation files a vendor case for the device, attaches up to three similar earlier resolved\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mtickets and their fixes, and moves the ticket to `escalated`. Use `--dry-run` to validate and\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mprint the case JSON without filing it or changing the ticket.\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[m\r\n Every command that writes accepts `--now ISO-8601` to pin the clock. Errors print\u001b[m\u001b[m\r\n `error: ...` on st"]
[129.779582, "o", "derr and exit 1.\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n\u001b[1mdiff --git a/helpdesk/cli.py b/helpdesk/cli.py\u001b[m\u001b[m\r\n\u001b[1mindex b251de9..9752039 100755\u001b[m\u001b[m\r\n\u001b[1m--- a/helpdesk/cli.py\u001b[m\u001b[m\r\n\u001b[1m+++ b/helpdesk/cli.py\u001b[m\u001b[m\r\n\u001b[36m@@ -2,10 +2,11 @@\u001b[m\u001b[m\r\n from __future__ import annotations\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n import argparse\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport json\u001b[m\u001b[m\r\n import sys\u001b[m\u001b[m\r\n from datetime import datetime, timezone\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n\u001b[31m-from . import workflow\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom . import escalation, workflow\u001b[m\u001b[m\r\n from .similarity import similar_tickets\u001b[m\u001b[m\r\n from .store import NotFound, Store\u001b[m\u001b[m\r\n from .vendors import VendorError\u001b[m\u001b[m\r\n\u001b[36m@@ -77,6 +78,17 @@\u001b[m \u001b[mdef cmd_resolve(store: Store, args) -> int:\u001b[m\u001b[m\r\n     return 0\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n:\u001b[K"]
