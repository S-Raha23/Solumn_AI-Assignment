[144.924694, "o", " \u001b[31mM\u001b[m tests/test_helpdesk.py\r\n\u001b[31m??\u001b[m helpdesk/escalation.py\r\n"]
[144.925956, "o", "\"\"\"Prepare vendor cases and escalate hardware faults through the workflow.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom datetime import datetime\r\n\r\nfrom . import vendors, workflow\r\nfrom .similarity import similar_tickets\r\nfrom .store import Store\r\n\r\n\r\ndef prepare_case(store: Store, ticket: dict, *, by: str) -> tuple[dict, dict]:\r\n    \"\"\"Validate an escalation and return (vendor, case), without side effects.\"\"\"\r\n    staff = store.staff(by)\r\n    device = store.device_for(ticket)\r\n    if device is None:\r\n        raise vendors.VendorError(f\"{ticket['id']} has no device\")\r\n    vendor = vendors.vendor(device.get(\"vendor_id\"), directory=store.directory)\r\n    for field in vendor[\"required_device_fields\"]:\r\n        if not device.get(field):\r\n            raise vendors.VendorError(f\"{device['id']} is missing required device field: {field}\")\r\n    current = ticket[\"status\"]\r\n    if \"escalated\" not in workflow.TRANSITIONS.get(current, set()):\r\n        raise workflow.WorkflowError(f\"{ticket['id']} is {current}; it cannot "]
[144.925988, "o", "become escalated\")\r\n\r\n    account = store.account(device[\"account_id\"])\r\n    work_notes = sorted(\r\n        (note for note in ticket.get(\"notes\", []) if note[\"kind\"] == \"work\"),\r\n        key=lambda note: datetime.fromisoformat(note[\"at\"]),\r\n    )\r\n    case = {\r\n        \"case_ref\": \"TF-\" + ticket[\"id\"],\r\n        \"opened_for\": {\r\n            \"account\": account[\"name\"],\r\n            \"site\": account[\"site\"],\r\n            \"contact\": ticket[\"requester\"],\r\n        },\r\n        \"device\": {field: device[field] for field in (\"model\", *vendor[\"required_device_fields\"])},\r\n        \"problem\": {\r\n            \"subject\": ticket[\"subject\"],\r\n            \"description\": ticket[\"body\"],\r\n            \"reported_at\": ticket[\"opened_at\"],\r\n        },\r\n        \"steps_taken\": [note[\"body\"] for note in work_notes],\r\n        \"prior_cases\": [\r\n            {\"ticket\": other[\"id\"], \"resolution\": other[\"resolution\"]}\r\n            for _, other in similar_tickets(store, ticket, k=3)\r\n        ],\r\n        \"handled_by\": {field: staff[field] for fie"]
[144.926001, "o", "ld in (\"name\", \"email\")},\r\n    }\r\n    return vendor, case\r\n\r\n\r\ndef escalate(store: Store, ticket: dict, *, by: str, at: str) -> tuple[dict, str]:\r\n    \"\"\"File a case, then update and save the ticket. Return (vendor, case number).\"\"\"\r\n    vendor, case = prepare_case(store, ticket, by=by)\r\n    number = vendors.submit_case(vendor[\"id\"], case, submitted_at=at, directory=store.directory)\r\n    workflow.change_status(store, ticket, \"escalated\", by=by, at=at)\r\n    ticket[\"vendor_case\"] = {\"vendor\": vendor[\"id\"], \"number\": number, \"submitted_at\": at}\r\n    workflow.add_note(\r\n        store, ticket, kind=\"system\", author=\"system\",\r\n        body=f\"Escalated to {vendor['name']} as {number}\", at=at,\r\n    )\r\n    store.save_tickets()\r\n    return vendor, number\r\n"]
