[?2004l"""Command line for helpdesk staff: python -m helpdesk <command>."""
from __future__ import annotations

import argparse
import sys
from datetime import datetime, timezone

from . import workflow
from .similarity import similar_tickets
from .store import NotFound, Store
from .vendors import VendorError


def _now(value: str | None) -> str:
    if value:
        return value
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def cmd_list(store: Store, args) -> int:
    for ticket in store.tickets(account_id=args.account, status=args.status):
        account = store.account(ticket["account_id"])
        print(f"{ticket['id']}  {ticket['status']:<11}  {account['name']:<26}  {ticket['subject']}")
    return 0


def cmd_show(store: Store, args) -> int:
    ticket = store.ticket(args.ticket)
    account = store.account(ticket["account_id"])
    device = store.device_for(ticket)
    print(f"{ticket['id']}  [{ticket['status']}]  {ticket['subject']}")
    print(f"account:   {account['name']}")
    print(f"requester: {ticket['requester']['name']} <{ticket['requester']['email']}> {ticket['requester']['phone']}")
    if device:
        print(f"device:    {device['model']}  serial {device['serial']}  ({device['vendor_id']})")
    print(f"opened:    {ticket['opened_at']}")
    print()
    print(ticket["body"])
    for note in ticket.get("notes", []):
        print(f"\n-- {note['at']} {note['kind']} ({note['author']})\n{note['body']}")
    if ticket.get("resolution"):
        print(f"\nresolution: {ticket['resolution']}")
    return 0


def cmd_suggest(store: Store, args) -> int:
    ticket = store.ticket(args.ticket)
    matches = similar_tickets(store, ticket, k=args.k)
    if not matches:
        print("no similar resolved tickets")
        return 0
    for score, other in matches:
        account = store.account(other["account_id"])
        print(f"{other['id']}  {score:.2f}  {account['name']}: {other['subject']}")
        print(f"    fix: {other['resolution']}")
    return 0


def cmd_note(store: Store, args) -> int:
    ticket = store.ticket(args.ticket)
    workflow.add_note(store, ticket, kind=args.kind, author=args.by, body=args.body, at=_now(args.now))
    store.save_tickets()
    return 0


def cmd_status(store: Store, args) -> int:
    ticket = store.ticket(args.ticket)
    workflow.change_status(store, ticket, args.status, by=args.by, at=_now(args.now))
    store.save_tickets()
    return 0


def cmd_resolve(store: Store, args) -> int:
    ticket = store.ticket(args.ticket)
    workflow.resolve(store, ticket, by=args.by, resolution=args.resolution, at=_now(args.now))
    store.save_tickets()
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="helpdesk")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("list", help="list tickets")
    p.add_argument("--account")
    p.add_argument("--status", choices=sorted(workflow.TRANSITIONS))
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("show", help="show one ticket")
    p.add_argument("ticket")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("suggest", help="similar resolved tickets and what fixed them")
    p.add_argument("ticket")
    p.add_argument("-k", type=int, default=3)
    p.set_defaults(func=cmd_suggest)

    p = sub.add_parser("note", help="add a note to a ticket")
    p.add_argument("ticket")
    p.add_argument("--kind", choices=("work", "customer"), default="work")
    p.add_argument("--by", required=True)
    p.add_argument("--body", required=True)
    p.add_argument("--now")
    p.set_defaults(func=cmd_note)

    p = sub.add_parser("status", help="change a ticket's status")
    p.add_argument("ticket")
    p.add_argument("status", choices=("open", "in_progress"))
    p.add_argument("--by", required=True)
    p.add_argument("--now")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("resolve", help="resolve a ticket")
    p.add_argument("ticket")
    p.add_argument("--by", required=True)
    p.add_argument("--resolution", required=True)
    p.add_argument("--now")
    p.set_defaults(func=cmd_resolve)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(Store(), args)
    except (NotFound, workflow.WorkflowError, VendorError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
"""JSON-file backed store for accounts, devices, staff and tickets."""
from __future__ import annotations

import json
import os
from pathlib import Path


class NotFound(KeyError):
    """Raised when a record id does not exist."""

    def __str__(self) -> str:  # KeyError would add quotes
        return str(self.args[0])


def data_dir() -> Path:
    return Path(os.environ.get("HELPDESK_DATA", Path(__file__).resolve().parent.parent / "data"))


class Store:
    """All helpdesk records, loaded from one directory.

    Tessel runs the helpdesk for several client organisations ("accounts").
    Every ticket and every device belongs to exactly one account.
    """

    FILES = ("accounts", "devices", "staff", "tickets")

    def __init__(self, directory: Path | None = None):
        self.directory = Path(directory) if directory else data_dir()
        for name in self.FILES:
            path = self.directory / f"{name}.json"
            records = json.loads(path.read_text(encoding="utf-8"))
            setattr(self, f"_{name}", {record["id"]: record for record in records})

    # -- lookups ---------------------------------------------------------
    def _get(self, kind: str, record_id: str) -> dict:
        try:
            return getattr(self, f"_{kind}")[record_id]
        except KeyError:
            raise NotFound(f"no such {kind.rstrip('s')}: {record_id}") from None

    def account(self, account_id: str) -> dict:
        return self._get("accounts", account_id)

    def device(self, device_id: str) -> dict:
        return self._get("devices", device_id)

    def staff(self, staff_id: str) -> dict:
        return self._get("staff", staff_id)

    def ticket(self, ticket_id: str) -> dict:
        return self._get("tickets", ticket_id)

    def tickets(self, *, account_id: str | None = None, status: str | None = None) -> list[dict]:
        """Tickets ordered by opening time, optionally narrowed to an account or status."""
        rows = self._tickets.values()
        if account_id is not None:
            rows = [t for t in rows if t["account_id"] == account_id]
        if status is not None:
            rows = [t for t in rows if t["status"] == status]
        return sorted(rows, key=lambda t: (t["opened_at"], t["id"]))

    def device_for(self, ticket: dict) -> dict | None:
        return self.device(ticket["device_id"]) if ticket.get("device_id") else None

    # -- writes ----------------------------------------------------------
    def save_tickets(self) -> None:
        """Writes tickets back atomically, in id order."""
        path = self.directory / "tickets.json"
        tmp = path.with_suffix(".json.tmp")
        rows = [self._tickets[key] for key in sorted(self._tickets)]
        tmp.write_text(json.dumps(rows, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        tmp.replace(path)
"""Ticket lifecycle: notes and status changes."""
from __future__ import annotations

from .store import Store

TRANSITIONS = {
    "open": {"in_progress", "resolved"},
    "in_progress": {"open", "escalated", "resolved"},
    "escalated": {"in_progress", "resolved"},
    "resolved": set(),
}
NOTE_KINDS = ("work", "customer", "system")


class WorkflowError(Exception):
    """An action is not allowed for the ticket in its current state."""


def add_note(store: Store, ticket: dict, *, kind: str, author: str, body: str, at: str) -> dict:
    """Appends a note. `author` is a staff id, or "system"."""
    if kind not in NOTE_KINDS:
        raise WorkflowError(f"unknown note kind: {kind}")
    if not body.strip():
        raise WorkflowError("a note needs a body")
    if author != "system":
        store.staff(author)
    note = {"at": at, "kind": kind, "author": author, "body": body.strip()}
    ticket.setdefault("notes", []).append(note)
    return note


def change_status(store: Store, ticket: dict, new_status: str, *, by: str, at: str) -> None:
    """Moves a ticket to `new_status` and leaves a system note about it."""
    current = ticket["status"]
    if new_status not in TRANSITIONS.get(current, set()):
        raise WorkflowError(f"{ticket['id']} is {current}; it cannot become {new_status}")
    store.staff(by)
    ticket["status"] = new_status
    add_note(store, ticket, kind="system", author="system", body=f"Status {current} -> {new_status} by {by}", at=at)


def resolve(store: Store, ticket: dict, *, by: str, resolution: str, at: str) -> None:
    """Closes a ticket with the fix that worked."""
    if not resolution.strip():
        raise WorkflowError("a resolution is required to resolve a ticket")
    change_status(store, ticket, "resolved", by=by, at=at)
    ticket["resolution"] = resolution.strip()
    ticket["resolved_at"] = at
[?2004hroot@a152dd6cafc5:/app# cat helpdesk/similarity.py helpdesk/vendors.py tests/test_helpdesk.py
[?2004l"""Finds earlier tickets that look like the one an agent is working on.

Powers the "suggested fixes" panel (`python -m helpdesk suggest`). Staff see
matches from every client, because the same printer fails the same way no
matter whose counter it sits on.
"""
from __future__ import annotations

import math
import re
from collections import Counter

from .store import Store

STOPWORDS = frozenset(
    "a an and are as at be been but by can cannot for from had has have if in is it its "
    "no not of on or our so that the their them then there this to us was we when will with".split()
)
SAME_MODEL_BONUS = 0.15


def tokens(text: str) -> list[str]:
    return [w for w in re.findall(r"[a-z0-9][a-z0-9-]+", text.lower()) if w not in STOPWORDS]


def _document(ticket: dict) -> list[str]:
    return tokens(f"{ticket['subject']} {ticket['subject']} {ticket['body']}")


def _vector(words: list[str], idf: dict[str, float]) -> dict[str, float]:
    counts = Counter(words)
    return {word: (1 + math.log(n)) * idf.get(word, 0.0) for word, n in counts.items()}


def _cosine(a: dict[str, float], b: dict[str, float]) -> float:
    dot = sum(weight * b.get(word, 0.0) for word, weight in a.items())
    norm = math.sqrt(sum(w * w for w in a.values())) * math.sqrt(sum(w * w for w in b.values()))
    return dot / norm if norm else 0.0


def similar_tickets(store: Store, ticket: dict, k: int = 3, resolved_only: bool = True) -> list[tuple[float, dict]]:
    """The `k` tickets most similar to `ticket`, best first, as (score, ticket).

    Similarity is TF-IDF cosine over subject and body, plus a small bonus when
    both tickets are about the same device model. The ticket itself and
    tickets opened after it are never returned.
    """
    corpus = store.tickets()
    documents = {t["id"]: _document(t) for t in corpus}
    doc_freq = Counter(word for words in documents.values() for word in set(words))
    idf = {word: math.log((1 + len(corpus)) / (1 + n)) + 1 for word, n in doc_freq.items()}

    target = _vector(_document(ticket), idf)
    target_device = store.device_for(ticket)
    scored = []
    for other in corpus:
        if other["id"] == ticket["id"] or other["opened_at"] >= ticket["opened_at"]:
            continue
        if resolved_only and other["status"] != "resolved":
            continue
        score = _cosine(target, _vector(documents[other["id"]], idf))
        other_device = store.device_for(other)
        if target_device and other_device and target_device["model"] == other_device["model"]:
            score += SAME_MODEL_BONUS
        if score > 0:
            scored.append((round(score, 4), other))
    scored.sort(key=lambda pair: (-pair[0], pair[1]["id"]))
    return scored[:k]
"""Hardware vendors and their partner portals."""
from __future__ import annotations

import json
import os
from pathlib import Path

from .store import data_dir


class VendorError(Exception):
    """A vendor is unknown, or its portal rejected a case."""


def portal_root() -> Path:
    return Path(os.environ.get("VENDOR_PORTAL_ROOT", "/var/tmp/vendor-portal"))


def load_vendors(directory: Path | None = None) -> dict[str, dict]:
    path = (Path(directory) if directory else data_dir()) / "vendors.json"
    return {vendor["id"]: vendor for vendor in json.loads(path.read_text(encoding="utf-8"))}


def vendor(vendor_id: str, directory: Path | None = None) -> dict:
    try:
        return load_vendors(directory)[vendor_id]
    except KeyError:
        raise VendorError(f"unknown vendor: {vendor_id}") from None


def submit_case(vendor_id: str, case: dict, *, submitted_at: str, directory: Path | None = None) -> str:
    """Files a support case on a vendor's partner portal and returns its case number.

    There is no network in this image: the portal is a stand-in that stores
    each case exactly as posted under <portal root>/<vendor id>/.
    """
    entry = vendor(vendor_id, directory)
    missing = [name for name in ("case_ref", "device", "problem") if not case.get(name)]
    if missing:
        raise VendorError(f"{entry['name']} portal rejected the case: missing {', '.join(missing)}")
    inbox = portal_root() / vendor_id
    inbox.mkdir(parents=True, exist_ok=True)
    number = f"{entry['case_prefix']}-{len(list(inbox.glob('*.json'))) + 1:06d}"
    request = {
        "portal": entry["portal_url"],
        "case_number": number,
        "received_at": submitted_at,
        "case": case,
    }
    (inbox / f"{number}.json").write_text(json.dumps(request, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    return number
import contextlib
import io
import os
import shutil
import tempfile
import unittest
from pathlib import Path

from helpdesk import cli, workflow
from helpdesk.similarity import similar_tickets, tokens
from helpdesk.store import NotFound, Store
from helpdesk.vendors import VendorError, submit_case

DATA = Path(__file__).resolve().parent.parent / "data"


class HelpdeskCase(unittest.TestCase):
    def setUp(self):
        self.tmp = Path(tempfile.mkdtemp(prefix="helpdesk-"))
        shutil.copytree(DATA, self.tmp / "data")
        os.environ["HELPDESK_DATA"] = str(self.tmp / "data")
        os.environ["VENDOR_PORTAL_ROOT"] = str(self.tmp / "portal")
        self.store = Store()

    def tearDown(self):
        os.environ.pop("HELPDESK_DATA", None)
        os.environ.pop("VENDOR_PORTAL_ROOT", None)
        shutil.rmtree(self.tmp, ignore_errors=True)

    def run_cli(self, *argv):
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            code = cli.main(list(argv))
        return code, out.getvalue(), err.getvalue()


class StoreTests(HelpdeskCase):
    def test_tickets_filter_by_account_and_status(self):
        calder = self.store.tickets(account_id="acct-calder")
        self.assertEqual([t["id"] for t in calder], ["HD-2954", "HD-3012", "HD-3260", "HD-3301", "HD-3310"])
        self.assertEqual(len(self.store.tickets(status="resolved")), 5)

    def test_unknown_ticket(self):
        with self.assertRaises(NotFound):
            self.store.ticket("HD-0000")


class WorkflowTests(HelpdeskCase):
    def test_resolve_records_resolution_and_note(self):
        ticket = self.store.ticket("HD-3260")
        workflow.resolve(self.store, ticket, by="st-03", resolution="Account created.", at="2026-11-05T09:00:00Z")
        self.assertEqual(ticket["status"], "resolved")
        self.assertEqual(ticket["notes"][-1]["body"], "Status open -> resolved by st-03")

    def test_illegal_transition(self):
        with self.assertRaises(workflow.WorkflowError):
            workflow.change_status(self.store, self.store.ticket("HD-3260"), "escalated", by="st-01", at="x")

    def test_resolved_ticket_is_final(self):
        with self.assertRaises(workflow.WorkflowError):
            workflow.change_status(self.store, self.store.ticket("HD-2954"), "open", by="st-01", at="x")


class SimilarityTests(HelpdeskCase):
    def test_tokens_drop_stopwords(self):
        self.assertEqual(tokens("The printer is not on-line"), ["printer", "on-line"])

    def test_suggest_ranks_blank_label_tickets_first(self):
        matches = similar_tickets(self.store, self.store.ticket("HD-3301"))
        self.assertEqual([t["id"] for _, t in matches], ["HD-3127", "HD-3050", "HD-2954"])
        self.assertTrue(all(t["status"] == "resolved" for _, t in matches))

    def test_cli_suggest_shows_the_fix(self):
        code, out, _ = self.run_cli("suggest", "HD-3301", "-k", "1")
        self.assertEqual(code, 0)
        self.assertIn("HD-3127", out)
        self.assertIn("fix: Priya Okonkwo had loaded the ribbon ink side out.", out)


class VendorTests(HelpdeskCase):
    def test_submit_case_numbers_and_records(self):
        case = {"case_ref": "TF-X", "device": {"serial": "S"}, "problem": {"subject": "s"}}
        first = submit_case("orbic-net", case, submitted_at="2026-11-05T09:00:00Z")
        second = submit_case("orbic-net", case, submitted_at="2026-11-05T09:01:00Z")
        self.assertEqual((first, second), ("ORB-000001", "ORB-000002"))
        self.assertTrue((self.tmp / "portal/orbic-net/ORB-000002.json").exists())

    def test_portal_rejects_incomplete_case(self):
        with self.assertRaises(VendorError):
            submit_case("kestrel-print", {"case_ref": "TF-X"}, submitted_at="x")


class CliTests(HelpdeskCase):
    def test_note_and_status_persist(self):
        code, _, _ = self.run_cli("note", "HD-3260", "--by", "st-03", "--body", "Waiting on start date", "--now", "2026-11-05T09:00:00Z")
        self.assertEqual(code, 0)
        code, _, _ = self.run_cli("status", "HD-3260", "in_progress", "--by", "st-03", "--now", "2026-11-05T09:01:00Z")
        self.assertEqual(code, 0)
        ticket = Store().ticket("HD-3260")
        self.assertEqual(ticket["status"], "in_progress")
        self.assertEqual(len(ticket["notes"]), 2)

    def test_errors_exit_1(self):
        code, _, err = self.run_cli("show", "HD-0000")
        self.assertEqual(code, 1)
        self.assertIn("error: no such ticket: HD-0000", err)


if __name__ == "__main__":
    unittest.main()
