[74.729309, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('lib/leavedesk/requests.rb')\ns = p.read_text()\nneedle = '    # Declines a pending request and tells the employee.\\n'\naddition = '''    # Approves a pending request, then tells the employee and the team calendar.\n    def approve(store, chat, request_id, by:, now:)\n      request = store.request(request_id)\n      ensure_pending!(request)\n      ensure_decider!(store, request, by)\n      type = request[\"type\"]\n      rule = Policy::TYPES.fetch(type) { raise PolicyError, \"unknown leave type: #{type}\" }\n      if rule[:allowance]\n        left = store.balance(request[\"employee\"], type).to_f\n        if request[\"days\"] > left\n          raise PolicyError, \"not enough #{type} leave: #{request['days']} requested, #{left} left\"\n        end\n      end\n\n      request.merge!(\"status\" => \"approved\", \"decided_by\" => by, \"decided_at\" => now.utc.strftime(\"%Y-%m-%dT%H:%M:%SZ\"))\n      store.adjust_balance(request[\"employee\"], type, -request[\"days\"]) if rule[:allowance]\n      store.save"]
[74.72937, "i", "\n\n      employee = store.employee(request[\"employee\"])\n      begin\n        chat.direct(employee, Cards.leave_card(request, store, title: \"Your leave is approved\",\n                                                               fields: %i[type dates days status approver balance cover]))\n        # The calendar is company-wide: share planning details, not private leave information.\n        chat.post(\"team-calendar\", Cards.leave_card(request, store,\n                                                   title: \"#{employee['name']} is off #{Cards.format_dates(request)}\",\n                                                   fields: %i[employee team dates days cover]))\n      rescue ChatError => e\n        warn \"warning: #{request['id']} approved, but chat notification failed: #{e.message}\"\n      end\n      request\n    end\n\n'''\nassert needle in s\np.write_text(s.replace(needle, addition + needle))\np = Path('bin/leavedesk')\ns = p.read_text().replace('# leavedesk decline REQUEST', '# leavedesk approve REQUEST --by ID [--now TIME"]
[74.729394, "i", "]\\n# leavedesk decline REQUEST', 1)\nneedle = '  when \"decline\"\\n'\naddition = '''  when \"approve\"\n    id = argv.shift\n    o = parse(argv, by: :value, now: :value)\n    Requests.approve(store, chat, id, by: o.fetch(:by), now: now_from(o[:now]))\n    puts \"#{id} approved\"\n'''\ns = s.replace(needle, addition + needle).replace('submit|decline|balance|calendar', 'submit|approve|decline|balance|calendar')\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('bin/leavedesk decline LV-0144', 'bin/leavedesk approve LV-0144 --by e-200\\nbin/leavedesk decline LV-0144', 1)\ns += '\\nApproval re-checks the allowance and debits the balance, messages the employee, and posts\\nplanning details to `#team-calendar`. If chat is unavailable, the approval is still saved;\\nthe command prints a warning and succeeds.\\n'\np.write_text(s)\nPY\n"]
