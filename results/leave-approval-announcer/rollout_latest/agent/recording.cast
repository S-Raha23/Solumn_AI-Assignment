[99.085239, "o", "  def test_parental_allowance_and_fractional_days_can_use_exact_remaining_balance\r\n\u001b[?2004l\r"]
[99.088917, "o", "\u001b[?2004h>     request = @store.request(\"LV-0144\")\r\n\u001b[?2004l\r\u001b[?2004h>     request.merge!(\"type\" => \"parental\", \"days\" => 2.5, \"half_end\" => true)\r\n\u001b[?2004l\r\u001b[?2004h>     @store.balances[\"e-202\"][\"parental\"] = 2.5\r\n\u001b[?2004l\r\u001b[?2004h>     @store.save\r\n\u001b[?2004l\r\u001b[?2004h>     approve\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal 0.0, reload_store.balance(\"e-202\", \"parental\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal 19.0, reload_store.balance(\"e-202\", \"annual\")\r\n\u001b[?2004l\r\u001b[?2004h>     card = posts(\"team-calendar\").last[\"card\"]\r\n\u001b[?2004l\r\u001b[?2004h>     assert_includes card[\"title\"], \"(am)\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert_includes card[\"fields\"], { \"label\" => \"Working days\", \"value\" => \"2.5\" }\r\n\u001b[?2004l\r\u001b[?2004h>   end\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   def test_unauthorized_deciders_do_not_change_state_or_notify\r\n\u001b[?2004l\r\u001b[?2004h>     before = saved_files\r\n\u001b[?2004l\r"]
[99.089, "o", "e-203\"], [\"LV-0144\", \"e-200\"], [\"LV-0141\", \"e-200\"],\r\n     [\"LV-0145\", \"e-300\"], [\"missing\", \"e-200\"]].each do |id, by|\r\n      out, err, status = cli(\"approve\", id, \"--by\", by)\r\n      assert_equal 1, status.exitstatus\r\n      assert_empty out\r\n      assert_match(/^error: /, err)\r\n      assert_equal before, saved_files\r\n    end\r\n    refute Dir.exist?(@outbox)\r\n  end\r\n\r\n  def test_cli_requires_approver_and_valid_timestamp\r\n    [[\"approve\", \"LV-0144\"], [\"approve\", \"LV-0144\", \"--by\", \"e-200\", \"--now\", \"bad\"]].each do |args|\r\n      _, err, status = cli(*args)\r\n      assert_equal 64, status.exitstatu\u001b[?2004h"]
