[99.109031, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   def test_cli_approval_prints_confirmation_and_uses_supplied_time\r\n\u001b[?2004l\r\u001b[?2004h>     out, err, status = cli(\"approve\", \"LV-0144\", \"--by\", \"e-200\", \"--now\", NOW.iso8601)\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal 0, status.exitstatus\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal \"LV-0144 approved\\n\", out\r\n\u001b[?2004l\r\u001b[?2004h>     assert_empty err\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal \"2026-11-16T08:30:45Z\", reload_store.request(\"LV-0144\")[\"decided_at\"]\r\n\u001b[?2004l\r\u001b[?2004h>   end\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   def test_cli_chat_outage_warns_but_succeeds_and_saves\r\n\u001b[?2004l\r\u001b[?2004h>     out, err, status = cli(\"approve\", \"LV-0144\", \"--by\", \"e-200\", fail_chat: true)\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal 0, status.exitstatus\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal \"LV-0144 approved\\n\", out\r\n\u001b[?2004l\r\u001b[?2004h>     assert_match(/warning:.*chat is unavailable/, err)\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal \"approved\", reload_store.request(\"LV-0144\")[\"status\"]\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal 14.0, rel"]
