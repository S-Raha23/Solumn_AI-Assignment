[74.974051, "i", "-11-16T09:34:56Z\", request[\"decided_at\"]\n    before[\"e-202\"][\"annual\"] -= 5.0\n    assert_equal before, saved.balances\n    dm = posts(\"dm-e-202\").last\n    assert_equal \"@anouk\", dm[\"to\"]\n    assert_equal \"Your leave is approved\", dm[\"card\"][\"title\"]\n    assert_includes dm[\"card\"][\"fields\"], { \"label\" => \"Balance after\", \"value\" => \"14\" }\n  end\n\n  def test_approve_announces_only_planning_details\n    request = approve(\"LV-0142\", by: \"e-300\")\n    message = posts(\"team-calendar\").fetch(0)\n    assert_equal \"#team-calendar\", message[\"channel\"]\n    assert_equal \"Ines Carvalho is off #{Leavedesk::Cards.format_dates(request)}\", message[\"card\"][\"title\"]\n    assert_equal [\n      { \"label\" => \"Employee\", \"value\" => \"Ines Carvalho\" },\n      { \"label\" => \"Team\", \"value\" => \"Design\" },\n      { \"label\" => \"Dates\", \"value\" => \"Mon 23 Nov - Fri 27 Nov\" },\n      { \"label\" => \"Working days\", \"value\" => \"5\" },\n      { \"label\" => \"Cover\", \"value\" => \"Tom Lyle\" }\n    ], message[\"card\"][\"fields\"]\n    refute_includes JSON.generate(mes"]
[74.974065, "i", "sage), request[\"reason\"]\n    refute_includes JSON.generate(message), \"Medical\"\n    assert_equal [], posts(\"people-ops\")\n  end\n\n  def test_approve_people_team_can_decide_and_missing_cover_is_shown\n    request = approve(\"LV-0143\", by: \"e-101\")\n    assert_equal \"approved\", request[\"status\"]\n    assert_equal \"e-101\", request[\"decided_by\"]\n    assert_includes posts(\"team-calendar\").last[\"card\"][\"fields\"],\n                    { \"label\" => \"Cover\", \"value\" => \"None arranged\" }\n  end\n\n  def test_approve_fractional_days_with_exact_balance_and_formatted_dates\n    request = @store.request(\"LV-0144\")\n    request[\"half_start\"] = true\n    request[\"half_end\"] = true\n    request[\"days\"] = 4.0\n    @store.balances[\"e-202\"][\"annual\"] = 4.0\n    request[\"days\"] = 4.5\n    request[\"half_end\"] = false\n    @store.balances[\"e-202\"][\"annual\"] = 4.5\n    approve\n    assert_equal 0.0, Leavedesk::Store.new(@store.dir).balance(\"e-202\", \"annual\")\n    card = posts(\"team-calendar\").last[\"card\"]\n    assert_equal \"Anouk de Vries is off Mon 7 Dec"]
[74.974101, "i", " (pm) - Fri 11 Dec\", card[\"title\"]\n    assert_includes card[\"fields\"], { \"label\" => \"Working days\", \"value\" => \"4.5\" }\n  end\n\n  def test_approve_rechecks_allowances_before_changing_anything\n    %w[annual parental].each do |type|\n      [4.5, nil].each do |left|\n        @store.request(\"LV-0144\")[\"type\"] = type\n        @store.balances[\"e-202\"][type] = left\n        @store.save\n        before = Marshal.load(Marshal.dump([@store.requests, @store.balances]))\n        error = assert_raises(Leavedesk::PolicyError) { approve }\n        assert_match \"not enough #{type} leave\", error.message\n        assert_equal before, [@store.requests, @store.balances]\n        saved = Leavedesk::Store.new(@store.dir)\n        assert_equal before, [saved.requests, saved.balances]\n      end\n    end\n    assert_empty Dir.glob(File.join(@outbox, \"**\", \"*.json\"))\n  end\n\n  def test_approve_without_allowance_does_not_change_balances\n    %w[medical compassionate unpaid].each do |type|\n      @store.request(\"LV-0144\").merge!(\"type\" => type, \"status\""]
[74.974112, "i", " => \"pending\")\n      before = Marshal.load(Marshal.dump(@store.balances))\n      approve\n      assert_equal before, Leavedesk::Store.new(@store.dir).balances\n    end\n  end\n\n  def test_approve_refusals_have_no_side_effects\n    before = Marshal.load(Marshal.dump([@store.requests, @store.balances]))\n    [[\"LV-0144\", \"e-203\", Leavedesk::NotAllowed],\n     [\"LV-0144\", \"e-300\", Leavedesk::NotAllowed],\n     [\"LV-0144\", \"e-202\", Leavedesk::NotAllowed],\n     [\"LV-0141\", \"e-200\", Leavedesk::NotAllowed],\n     [\"LV-0145\", \"e-300\", Leavedesk::NotAllowed],\n     [\"LV-9999\", \"e-200\", Leavedesk::NotFound],\n     [\"LV-0144\", \"e-999\", Leavedesk::NotFound]].each do |id, by, error|\n      assert_raises(error) { approve(id, by: by) }\n      assert_equal before, [@store.requests, @store.balances]\n      saved = Leavedesk::Store.new(@store.dir)\n      assert_equal before, [saved.requests, saved.balances]\n    end\n    assert_empty Dir.glob(File.join(@outbox, \"**\", \"*.json\"))\n  end\n\n  def test_approve_twice_does_not_debit_or_notify_again\n    "]
