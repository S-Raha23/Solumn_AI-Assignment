[99.104912, "o", "\u001b[?2004h>     before = saved_files\r\n\u001b[?2004l\r\u001b[?2004h>     assert_raises(Leavedesk::PolicyError) { approve }\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal before, saved_files\r\n\u001b[?2004l\r\u001b[?2004h>     refute Dir.exist?(@outbox)\r\n\u001b[?2004l\r\u001b[?2004h>   end\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   def test_calendar_delivery_failure_does_not_undo_approval\r\n\u001b[?2004l\r\u001b[?2004h>     chat = Object.new\r\n\u001b[?2004l\r\u001b[?2004h>     chat.define_singleton_method(:direct) { |_employee, _card| }\r\n\u001b[?2004l\r\u001b[?2004h>     chat.define_singleton_method(:post) { |_channel, _card| raise Leavedesk::ChatError, \"calendar unavailable\" }\r\n\u001b[?2004l\r\u001b[?2004h>     _, err = capture_io { approve(chat: chat) }\r\n\u001b[?2004l\r\u001b[?2004h>     assert_match(/warning:.*calendar unavailable/, err)\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal \"approved\", reload_store.request(\"LV-0144\")[\"status\"]\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal 14.0, reload_store.balance(\"e-202\", \"annual\")\r\n\u001b[?2004l\r\u001b[?2004h>   end\r\n\u001b[?2004l\r"]
