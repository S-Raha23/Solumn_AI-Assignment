[99.100807, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>                                         reason: \"Holiday\", today: Date.new(2026, 11, 16))\r\n\u001b[?2004l\r\u001b[?2004h>     @store.adjust_balance(\"e-202\", \"annual\", -15.0)\r\n\u001b[?2004l\r\u001b[?2004h>     @store.save\r\n\u001b[?2004l\r\u001b[?2004h>     @store = reload_store\r\n\u001b[?2004l\r\u001b[?2004h>     before = saved_files\r\n\u001b[?2004l\r\u001b[?2004h>     error = assert_raises(Leavedesk::PolicyError) { approve(request[\"id\"]) }\r\n\u001b[?2004l\r\u001b[?2004h>     assert_match(/not enough annual leave/, error.message)\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal before, saved_files\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal \"pending\", @store.request(request[\"id\"])[\"status\"]\r\n\u001b[?2004l\r\u001b[?2004h>     refute @store.request(request[\"id\"]).key?(\"decided_by\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert_empty posts(\"dm-e-202\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert_empty posts(\"team-calendar\")\r\n\u001b[?2004l\r\u001b[?2004h>   end\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
