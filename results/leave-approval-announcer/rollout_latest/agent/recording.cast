[62.836353, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('lib/leavedesk/requests.rb')\ns = p.read_text()\nmarker = '    # Declines a pending request and tells the employee.\\n'\naddition = '''    # Approves a pending request, tells the employee and announces the absence.\n    def approve(store, chat, request_id, by:, now:)\n      request = store.request(request_id)\n      ensure_pending!(request)\n      ensure_decider!(store, request, by)\n      employee = store.employee(request[\"employee\"])\n      type = request[\"type\"]\n      allowance = Policy::TYPES.fetch(type)[:allowance]\n      if allowance\n        left = store.balance(employee[\"id\"], type).to_f\n        if request[\"days\"] > left\n          raise PolicyError, \"not enough #{type} leave: #{request['days']} requested, #{left} left\"\n        end\n      end\n\n      request.merge!(\"status\" => \"approved\", \"decided_by\" => by,\n                     \"decided_at\" => now.utc.strftime(\"%Y-%m-%dT%H:%M:%SZ\"))\n      store.adjust_balance(employee[\"id\"], type, -request[\"days\"]) if allowance\n   "]
[62.836542, "i", "   store.save\n\n      begin\n        chat.direct(employee, Cards.leave_card(request, store, title: \"Your leave is approved\"))\n        chat.post(\"team-calendar\", Cards.leave_card(request, store,\n                  title: \"#{employee['name']} is off #{Cards.format_dates(request)}\",\n                  fields: %i[employee team dates days cover]))\n      rescue ChatError => e\n        warn \"warning: #{request['id']} approved, but notification failed: #{e.message}\"\n      end\n      request\n    end\n\n'''\nassert marker in s\np.write_text(s.replace(marker, addition + marker))\np = Path('bin/leavedesk')\ns = p.read_text().replace('# leavedesk decline REQUEST', '# leavedesk approve REQUEST --by ID [--now TIME]\\n# leavedesk decline REQUEST')\ns = s.replace('  when \"decline\"\\n', '''  when \"approve\"\n    id = argv.shift\n    o = parse(argv, by: :value, now: :value)\n    Requests.approve(store, chat, id, by: o.fetch(:by), now: now_from(o[:now]))\n    puts \"#{id} approved\"\n  when \"decline\"\n''')\ns = s.replace('submit|decline|balance|calendar"]
[62.83656, "i", "', 'submit|approve|decline|balance|calendar')\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('bin/leavedesk decline LV-0144', 'bin/leavedesk approve LV-0144 --by e-200\\nbin/leavedesk decline LV-0144')\ns += '\\nApprovals deduct allowance-backed leave from the current balance, notify the employee, and\\nannounce dates and cover in `#team-calendar` (without private leave details). If chat is down,\\nthe approval is still saved and the command succeeds with a warning.\\n'\np.write_text(s)\nPY\n"]
