[74.980386, "o", "\u001b[?2004l\r\u001b[?2004h>                    RbConfig.ruby, File.expand_path(\"../bin/leavedesk\", __dir__), *args)\r\n\u001b[?2004l\r\u001b[?2004h>   end\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   def test_approve_saves_decision_and_debits_only_the_requested_balance\r\n\u001b[?2004l\r\u001b[?2004h>     before = Marshal.load(Marshal.dump(@store.balances))\r\n\u001b[?2004l\r\u001b[?2004h>     request = approve(now: Time.iso8601(\"2026-11-16T11:34:56+02:00\"))\r\n\u001b[?2004l\r\u001b[?2004h>     saved = Leavedesk::Store.new(@store.dir)\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal \"approved\", request[\"status\"]\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal request, saved.request(\"LV-0144\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert_equal \"e-200\", request[\"decided_by\"]\r\n\u001b[?2004l\rb\u001b[?2004h>     assert_equal \"2026-11-16T09:34:56Z\", request[\"decided_at\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.980685, "o", ">     before[\"e-202\"][\"annual\"] -= 5.0\r\n\u001b[?2004l\r"]
