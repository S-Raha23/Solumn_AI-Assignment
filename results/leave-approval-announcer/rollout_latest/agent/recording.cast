[75.033571, "o", "      assert_empty stdout\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.033679, "o", "      assert_match(/\\\\Ausage error: /, stderr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.033811, "o", "    end\r\n\u001b[?2004l\r\u001b[?2004h>   end\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
