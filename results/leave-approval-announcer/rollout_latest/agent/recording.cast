[85.474656, "o", "\r\u001b[K\u001b[?1l\u001b>"]
[85.479686, "o", "\u001b[?1h\u001b=\r README.md                 |   5 \u001b[32m++++\u001b[m\u001b[m\r\n bin/leavedesk             |   8 \u001b[32m++++\u001b[m\u001b[31m-\u001b[m\u001b[m\r\n lib/leavedesk/requests.rb |  32 \u001b[32m++++++++++++++++++++\u001b[m\u001b[m\r\n test/leavedesk_test.rb    | 203 \u001b[32m++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++\u001b[m\u001b[m\r\n 4 files changed, 247 insertions(+), 1 deletion(-)\u001b[m\r\n"]
[85.480088, "o", "\r\u001b[K\u001b[?1l\u001b>"]
[85.484456, "o", "\u001b[?1h\u001b=\r\u001b[1mdiff --git a/README.md b/README.md\u001b[m\u001b[m\r\n\u001b[1mindex 045fd7a..073ad2e 100755\u001b[m\u001b[m\r\n\u001b[1m--- a/README.md\u001b[m\u001b[m\r\n\u001b[1m+++ b/README.md\u001b[m\u001b[m\r\n\u001b[36m@@ -4,6 +4,7 @@\u001b[m \u001b[mLeave requests for Quillmark staff, run from the command line and by the chat bo\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n ```\u001b[m\u001b[m\r\n bin/leavedesk submit  --employee e-202 --type annual --from 2027-01-04 --to 2027-01-08 --reason \"Skiing\" --cover e-203\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mbin/leavedesk approve LV-0144 --by e-200\u001b[m\u001b[m\r\n bin/leavedesk decline LV-0144 --by e-200 --note \"Release week\"\u001b[m\u001b[m\r\n bin/leavedesk balance e-202\u001b[m\u001b[m\r\n bin/leavedesk calendar --from 2026-12-01 --to 2026-12-31\u001b[m\u001b[m\r\n\u001b[36m@@ -29,3 +30,7 @@\u001b[m \u001b[memployee's line manager or by anyone in the People team.\u001b[m\u001b[m\r\n messages. Cards are built by `lib/leavedesk/cards.rb`. There is no network here: every message\u001b[m\u001b[m\r\n is written as it would be sent to `$CHAT_OUTBOX/<channel>/` or `$CHAT_OUTBOX/dm-<employee id>/`\u001b[m\u001b[m\r\n (default `/var/tmp/chat-outbox`). `CHAT_FAIL=1` makes every post raise `ChatE"]
[85.484599, "o", "rror`.\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mApproval re-checks the allowance and debits the balance, messages the employee, and posts\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mplanning details to `#team-calendar`. If chat is unavailable, the approval is still saved;\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mthe command prints a warning and succeeds.\u001b[m\u001b[m\r\n\u001b[1mdiff --git a/bin/leavedesk b/bin/leavedesk\u001b[m\u001b[m\r\n\u001b[1mindex 9e600e8..72c39ec 100755\u001b[m\u001b[m\r\n\u001b[1m--- a/bin/leavedesk\u001b[m\u001b[m\r\n\u001b[1m+++ b/bin/leavedesk\u001b[m\u001b[m\r\n\u001b[36m@@ -3,6 +3,7 @@\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n # leavedesk submit  --employee ID --type TYPE --from DATE --to DATE [--reason TEXT] [--cover ID]\u001b[m\u001b[m\r\n #                   [--half-start] [--half-end] [--today DATE]\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m# leavedesk approve REQUEST --by ID [--now TIME]\u001b[m\u001b[m\r\n # leavedesk decline REQUEST --by ID [--note TEXT] [--now TIME]\u001b[m\u001b[m\r\n # leavedesk balance EMPLOYEE\u001b[m\u001b[m\r\n # leavedesk calendar --from DATE --to DATE\u001b[m\u001b[m\r\n\u001b[36m@@ -40,6 +41,11 @@\u001b[m \u001b[mdef run(argv)\u001b[m\u001b[m\r\n                                      last_day: o.fetch(:to"]
[85.48462, "o", "), reason: o[:reason], cover: o[:cover],\u001b[m\u001b[m\r\n                                      half_start: !!o[:half_start], half_end: !!o[:half_end], today: today)\u001b[m\u001b[m\r\n     puts \"#{r['id']} submitted (#{Cards.format_days(r['days'])} working days)\"\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  when \"approve\"\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    id = argv.shift\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    o = parse(argv, by: :value, now: :value)\u001b[m\u001b[m\r\n:\u001b[K"]
