[98.610025, "o", " \u001b[31mM\u001b[m README.md\r\n \u001b[31mM\u001b[m bin/leavedesk\r\n \u001b[31mM\u001b[m lib/leavedesk/requests.rb\r\n \u001b[31mM\u001b[m test/leavedesk_test.rb\r\n"]
[98.612824, "o", "\u001b[1mdiff --git a/bin/leavedesk b/bin/leavedesk\u001b[m\r\n\u001b[1mindex 9e600e8..72c39ec 100755\u001b[m\r\n\u001b[1m--- a/bin/leavedesk\u001b[m\r\n\u001b[1m+++ b/bin/leavedesk\u001b[m\r\n\u001b[36m@@ -3,6 +3,7 @@\u001b[m\r\n \u001b[m\r\n"]
[98.612959, "o", " # leavedesk submit  --employee ID --type TYPE --from DATE --to DATE [--reason TEXT] [--cover ID]\u001b[m\r\n #                   [--half-start] [--half-end] [--today DATE]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m# leavedesk approve REQUEST --by ID [--now TIME]\u001b[m\r\n # leavedesk decline REQUEST --by ID [--note TEXT] [--now TIME]\u001b[m\r\n # leavedesk balance EMPLOYEE\u001b[m\r\n # leavedesk calendar --from DATE --to DATE\u001b[m\r\n"]
[98.613008, "o", "\u001b[36m@@ -40,6 +41,11 @@\u001b[m \u001b[mdef run(argv)\u001b[m\r\n                                      last_day: o.fetch(:to), reason: o[:reason], cover: o[:cover],\u001b[m\r\n                                      half_start: !!o[:half_start], half_end: !!o[:half_end], today: today)\u001b[m\r\n     puts \"#{r['id']} submitted (#{Cards.format_days(r['days'])} working days)\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  when \"approve\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    id = argv.shift\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    o = parse(argv, by: :value, now: :value)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    Requests.approve(store, chat, id, by: o.fetch(:by), now: now_from(o[:now]))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    puts \"#{id} approved\"\u001b[m\r\n   when \"decline\"\u001b[m\r\n     id = argv.shift\u001b[m\r\n     o = parse(argv, by: :value, note: :value, now: :value)\u001b[m\r\n\u001b[36m@@ -57,7 +63,7 @@\u001b[m \u001b[mdef run(argv)\u001b[m\r\n          .sort_by { |r| [r[\"first_day\"], r[\"id\"]] }\u001b[m\r\n          .each { |r| puts \"#{Cards.format_dates(r)}  #{store.employee(r['employee'])['name']}\" }\u001b[m\r\n   else\u001b[m\r\n\u001b[31m-    warn \"usage: leavedesk submit|decline|balance|calendar ...\""]
[98.613054, "o", "\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    warn \"usage: leavedesk submit|approve|decline|balance|calendar ...\"\u001b[m\r\n     return 64\u001b[m\r\n   end\u001b[m\r\n   0\u001b[m\r\n"]
[98.613369, "o", "\u001b[1mdiff --git a/lib/leavedesk/requests.rb b/lib/leavedesk/requests.rb\u001b[m\r\n\u001b[1mindex a1f67c7..b30847a 100755\u001b[m\r\n\u001b[1m--- a/lib/leavedesk/requests.rb\u001b[m\r\n\u001b[1m+++ b/lib/leavedesk/requests.rb\u001b[m\r\n\u001b[36m@@ -52,6 +52,38 @@\u001b[m \u001b[mmodule Leavedesk\u001b[m\r\n       raise NotAllowed, \"#{request['id']} is already #{request['status']}\"\u001b[m\r\n     end\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    # Approves a pending request, then tells the employee and the team calendar.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    def approve(store, chat, request_id, by:, now:)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      request = store.request(request_id)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      ensure_pending!(request)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      ensure_decider!(store, request, by)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      type = request[\"type\"]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      rule = Policy::TYPES.fetch(type) { raise PolicyError, \"unknown leave type: #{type}\" }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if rule[:allowance]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        left = store.balance(request[\"employee\"], type).to_f\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        if request[\"days\"] > left\u001b[m\r\n\u001b[32m+\u001b[m\u001b["]
[98.613425, "o", "32m          raise PolicyError, \"not enough #{type} leave: #{request['days']} requested, #{left} left\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        end\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      end\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      request.merge!(\"status\" => \"approved\", \"decided_by\" => by, \"decided_at\" => now.utc.strftime(\"%Y-%m-%dT%H:%M:%SZ\"))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      store.adjust_balance(request[\"employee\"], type, -request[\"days\"]) if rule[:allowance]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      store.save\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      employee = store.employee(request[\"employee\"])\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      begin\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        chat.direct(employee, Cards.leave_card(request, store, title: \"Your leave is approved\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                                                               fields: %i[type dates days status approver balance cover]))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        # The calendar is company-wide: share planning details, not private leave information.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        chat.post(\"team-calendar\", Cards.leave_card(request, store,\u001b[m"]
[98.613471, "o", "\r\n\u001b[32m+\u001b[m\u001b[32m                                                   title: \"#{employee['name']} is off #{Cards.format_dates(request)}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                                                   fields: %i[employee team dates days cover]))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      rescue ChatError => e\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        warn \"warning: #{request['id']} approved, but chat notification failed: #{e.message}\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      end\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      request\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    end\u001b[m\r\n\u001b[32m+\u001b[m\r\n     # Declines a pending request and tells the employee.\u001b[m\r\n     def decline(store, chat, request_id, by:, note:, now:)\u001b[m\r\n       request = store.request(request_id)\u001b[m\r\n"]
