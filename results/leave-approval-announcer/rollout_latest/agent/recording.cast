[15.129088, "o", "# frozen_string_literal: true\r\n\r\nrequire \"json\"\r\nrequire \"yaml\"\r\nrequire \"date\"\r\n\r\nmodule Leavedesk\r\n  class NotFound < StandardError; end\r\n\r\n  # Employees, leave requests and balances, read from $LEAVEDESK_DATA.\r\n  class Store\r\n    attr_reader :dir, :employees, :requests, :balances\r\n\r\n    def self.default_dir\r\n      ENV.fetch(\"LEAVEDESK_DATA\", File.expand_path(\"../../data\", __dir__))\r\n    end\r\n\r\n    def initialize(dir = self.class.default_dir)\r\n      @dir = dir\r\n      @employees = YAML.safe_load_file(File.join(dir, \"employees.yml\")).to_h { |e| [e[\"id\"], e] }\r\n      @requests = JSON.parse(File.read(File.join(dir, \"requests.json\"))).to_h { |r| [r[\"id\"], r] }\r\n      @balances = JSON.parse(File.read(File.join(dir, \"balances.json\")))\r\n    end\r\n\r\n    def employee(id)\r\n      @employees.fetch(id) { raise NotFound, \"no such employee: #{id}\" }\r\n    end\r\n\r\n    def request(id)\r\n      @requests.fetch(id) { raise NotFound, \"no such request: #{id}\" }\r\n    end\r\n\r\n    def manager_of(employee_id)\r\n      manager_id = employee("]
[15.12951, "o", "employee_id)[\"manager\"]\r\n      manager_id && employee(manager_id)\r\n    end\r\n\r\n    def people_team?(employee_id)\r\n      employee(employee_id)[\"team\"] == \"People\"\r\n    end\r\n\r\n    # Remaining days of a leave type for an employee, or nil for types\r\n    # without an allowance.\r\n    def balance(employee_id, type)\r\n      @balances.dig(employee_id, type)\r\n    end\r\n\r\n    def adjust_balance(employee_id, type, delta)\r\n      current = balance(employee_id, type)\r\n      return if current.nil?\r\n\r\n      @balances[employee_id][type] = (current + delta).round(1)\r\n    end\r\n\r\n    def next_request_id\r\n      highest = @requests.keys.map { |id| id.delete_prefix(\"LV-\").to_i }.max || 0\r\n      format(\"LV-%04d\", highest + 1)\r\n    end\r\n\r\n    def add_request(request)\r\n      @requests[request[\"id\"]] = request\r\n    end\r\n\r\n    def save\r\n      write(\"requests.json\", @requests.values.sort_by { |r| r[\"id\"] })\r\n      write(\"balances.json\", @balances)\r\n    end\r\n\r\n    private\r\n\r\n    def write(name, value)\r\n      path = File.join(@dir, name)\r\n    "]
[15.129523, "o", "  File.write(\"#{path}.tmp\", JSON.pretty_generate(value) + \"\\n\")\r\n      File.rename(\"#{path}.tmp\", path)\r\n    end\r\n  end\r\nend\r\n# frozen_string_literal: true\r\n\r\nrequire \"date\"\r\nrequire \"yaml\"\r\n\r\nmodule Leavedesk\r\n  class PolicyError < StandardError; end\r\n\r\n  # Leave types and how many working days a request uses.\r\n  module Policy\r\n    TYPES = {\r\n      \"annual\" => { allowance: true, notice_days: 14 },\r\n      \"medical\" => { allowance: false, notice_days: 0 },\r\n      \"compassionate\" => { allowance: false, notice_days: 0 },\r\n      \"parental\" => { allowance: true, notice_days: 28 },\r\n      \"unpaid\" => { allowance: false, notice_days: 14 }\r\n    }.freeze\r\n\r\n    module_function\r\n\r\n    def holidays(dir)\r\n      YAML.safe_load_file(File.join(dir, \"holidays.yml\"), permitted_classes: [Date]).map { |d| Date.parse(d.to_s) }\r\n    end\r\n\r\n    # Working days from first to last (inclusive), skipping weekends and bank\r\n    # holidays. A half day at either end counts 0.5.\r\n    def working_days(first, last, holidays, half_start: fals"]
[15.130656, "o", "e, half_end: false)\r\n      raise PolicyError, \"leave ends before it starts\" if last < first\r\n\r\n      days = (first..last).count { |d| !d.saturday? && !d.sunday? && !holidays.include?(d) }\r\n      days -= 0.5 if half_start && working?(first, holidays)\r\n      days -= 0.5 if half_end && working?(last, holidays) && (last != first || !half_start)\r\n      days.to_f\r\n    end\r\n\r\n    def working?(day, holidays)\r\n      !day.saturday? && !day.sunday? && !holidays.include?(day)\r\n    end\r\n\r\n    # Checks a new request against the leave rules. Returns the working days.\r\n    def check!(store, employee_id, type, first, last, today:, half_start: false, half_end: false)\r\n      rule = TYPES.fetch(type) { raise PolicyError, \"unknown leave type: #{type}\" }\r\n      days = working_days(first, last, holidays(store.dir), half_start: half_start, half_end: half_end)\r\n      raise PolicyError, \"request covers no working days\" if days.zero?\r\n      if (first - today).to_i < rule[:notice_days]\r\n        raise PolicyError, \"#{type} leave needs #{"]
[15.130679, "o", "rule[:notice_days]} days' notice\"\r\n      end\r\n      if rule[:allowance]\r\n        left = store.balance(employee_id, type).to_f\r\n        raise PolicyError, \"not enough #{type} leave: #{days} requested, #{left} left\" if days > left\r\n      end\r\n      overlapping = store.requests.values.find do |r|\r\n        r[\"employee\"] == employee_id && %w[pending approved].include?(r[\"status\"]) &&\r\n          Date.parse(r[\"first_day\"]) <= last && Date.parse(r[\"last_day\"]) >= first\r\n      end\r\n      raise PolicyError, \"overlaps #{overlapping['id']}\" if overlapping\r\n\r\n      days\r\n    end\r\n  end\r\nend\r\n# frozen_string_literal: true\r\n\r\nrequire \"date\"\r\n\r\nmodule Leavedesk\r\n  # Builds the chat cards leavedesk posts. A card is\r\n  #   { \"title\" => String, \"fields\" => [{ \"label\" => String, \"value\" => String }], \"footer\" => String }\r\n  module Cards\r\n    DEFAULT_FIELDS = %i[employee team type dates days reason cover balance].freeze\r\n\r\n    LABELS = {\r\n      employee: \"Employee\", team: \"Team\", type: \"Leave type\", dates: \"Dates\", days: \"Working"]
[15.130689, "o", " days\",\r\n      reason: \"Reason\", cover: \"Cover\", balance: \"Balance after\", status: \"Status\", approver: \"Approved by\"\r\n    }.freeze\r\n\r\n    module_function\r\n\r\n    # \"Mon 7 Dec\" or \"Mon 7 Dec - Fri 11 Dec\", with \"(pm)\" / \"(am)\" on half days.\r\n    def format_dates(request)\r\n      first = Date.parse(request[\"first_day\"])\r\n      last = Date.parse(request[\"last_day\"])\r\n      start = first.strftime(\"%a %-d %b\") + (request[\"half_start\"] ? \" (pm)\" : \"\")\r\n      finish = last.strftime(\"%a %-d %b\") + (request[\"half_end\"] ? \" (am)\" : \"\")\r\n      first == last ? start : \"#{start} - #{finish}\"\r\n    end\r\n\r\n    def format_days(days)\r\n      (days % 1).zero? ? days.to_i.to_s : days.to_s\r\n    end\r\n\r\n    def field_value(name, request, store)\r\n      employee = store.employee(request[\"employee\"])\r\n      case name\r\n      when :employee then employee[\"name\"]\r\n      when :team then employee[\"team\"]\r\n      when :type then request[\"type\"].capitalize\r\n      when :dates then format_dates(request)\r\n      when :days then format_days(request[\""]
[15.130699, "o", "days\"])\r\n      when :reason then request[\"reason\"].to_s.empty? ? \"-\" : request[\"reason\"]\r\n      when :cover then request[\"cover\"] ? store.employee(request[\"cover\"])[\"name\"] : \"None arranged\"\r\n      when :balance\r\n        left = store.balance(request[\"employee\"], request[\"type\"])\r\n        left.nil? ? \"n/a\" : format_days(left)\r\n      when :status then request[\"status\"].capitalize\r\n      when :approver then request[\"decided_by\"] ? store.employee(request[\"decided_by\"])[\"name\"] : \"-\"\r\n      else raise ArgumentError, \"unknown card field #{name}\"\r\n      end\r\n    end\r\n\r\n    # A card about one leave request.\r\n    def leave_card(request, store, title:, fields: DEFAULT_FIELDS, footer: nil)\r\n      {\r\n        \"title\" => title,\r\n        \"fields\" => fields.map { |f| { \"label\" => LABELS.fetch(f), \"value\" => field_value(f, request, store) } },\r\n        \"footer\" => footer || \"leavedesk #{request['id']}\"\r\n      }\r\n    end\r\n  end\r\nend\r\n# frozen_string_literal: true\r\n\r\nrequire \"json\"\r\nrequire \"yaml\"\r\nrequire \"fileutils\"\r\n\r\nmodule"]
[15.130708, "o", " Leavedesk\r\n  class ChatError < StandardError; end\r\n\r\n  # Posts cards to channels and direct messages on the company chat.\r\n  #\r\n  # There is no network in this image: every post is written, exactly as it\r\n  # would be sent, to $CHAT_OUTBOX/<channel or dm-employee id>/NNNNN.json\r\n  # (default /var/tmp/chat-outbox).\r\n  class Chat\r\n    def self.channels(dir = File.expand_path(\"../../config\", __dir__))\r\n      YAML.safe_load_file(File.join(dir, \"channels.yml\"))\r\n    end\r\n\r\n    def initialize(root: ENV.fetch(\"CHAT_OUTBOX\", \"/var/tmp/chat-outbox\"), now: -> { Time.now.utc })\r\n      @root = root\r\n      @now = now\r\n    end\r\n\r\n    def post(channel, card)\r\n      raise ChatError, \"unknown channel ##{channel}\" unless self.class.channels.key?(channel)\r\n\r\n      deliver(channel, { \"channel\" => \"##{channel}\", \"card\" => card })\r\n    end\r\n\r\n    def direct(employee, card)\r\n      deliver(\"dm-#{employee['id']}\", { \"to\" => employee[\"chat_handle\"], \"card\" => card })\r\n    end\r\n\r\n    private\r\n\r\n    def deliver(box, message)\r\n      rai"]
[15.130725, "o", "se ChatError, \"chat is unavailable\" if ENV.fetch(\"CHAT_FAIL\", \"\") == \"1\"\r\n\r\n      dir = File.join(@root, box)\r\n      FileUtils.mkdir_p(dir)\r\n      seq = Dir.children(dir).size + 1\r\n      record = message.merge(\"posted_at\" => @now.call.strftime(\"%Y-%m-%dT%H:%M:%SZ\"))\r\n      File.write(File.join(dir, format(\"%05d.json\", seq)), JSON.pretty_generate(record) + \"\\n\")\r\n    end\r\n  end\r\nend\r\n\u001b[?2004hroot@7ac0737ca68c:/app# "]
