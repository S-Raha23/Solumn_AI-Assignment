[16.895345, "o", "# frozen_string_literal: true\r\n\r\nrequire \"date\"\r\nrequire \"time\"\r\nrequire_relative \"store\"\r\nrequire_relative \"policy\"\r\nrequire_relative \"cards\"\r\nrequire_relative \"chat\"\r\n\r\nmodule Leavedesk\r\n  class NotAllowed < StandardError; end\r\n\r\n  # Submitting and deciding leave requests.\r\n  module Requests\r\n    module_function\r\n\r\n    # Files a request and asks the employee's manager to decide it. The\r\n    # manager gets the full card by direct message; #people-ops gets a copy.\r\n    def submit(store, chat, employee_id:, type:, first_day:, last_day:, reason:, cover: nil,\r\n               half_start: false, half_end: false, today:)\r\n      employee = store.employee(employee_id)\r\n      store.employee(cover) if cover\r\n      first = Date.parse(first_day)\r\n      last = Date.parse(last_day)\r\n      days = Policy.check!(store, employee_id, type, first, last, today: today,\r\n                                                                  half_start: half_start, half_end: half_end)\r\n      request = {\r\n        \"id\" => store.next_reques"]
[16.896211, "o", "t_id, \"employee\" => employee_id, \"type\" => type,\r\n        \"first_day\" => first.iso8601, \"last_day\" => last.iso8601, \"half_start\" => half_start,\r\n        \"half_end\" => half_end, \"days\" => days, \"reason\" => reason.to_s.strip, \"cover\" => cover,\r\n        \"status\" => \"pending\", \"submitted_at\" => today.iso8601\r\n      }\r\n      store.add_request(request)\r\n      store.save\r\n      card = Cards.leave_card(request, store, title: \"Leave request from #{employee['name']}\")\r\n      manager = store.manager_of(employee_id)\r\n      chat.direct(manager, card) if manager\r\n      chat.post(\"people-ops\", card)\r\n      request\r\n    end\r\n\r\n    def ensure_decider!(store, request, by)\r\n      decider = store.employee(by)\r\n      return decider if store.manager_of(request[\"employee\"])&.fetch(\"id\") == by || store.people_team?(by)\r\n\r\n      raise NotAllowed, \"#{decider['name']} cannot decide #{request['id']}\"\r\n    end\r\n\r\n    def ensure_pending!(request)\r\n      return if request[\"status\"] == \"pending\"\r\n\r\n      raise NotAllowed, \"#{request['id']} "]
[16.89627, "o", "is already #{request['status']}\"\r\n    end\r\n\r\n    # Declines a pending request and tells the employee.\r\n    def decline(store, chat, request_id, by:, note:, now:)\r\n      request = store.request(request_id)\r\n      ensure_pending!(request)\r\n      ensure_decider!(store, request, by)\r\n      request.merge!(\"status\" => \"declined\", \"decided_by\" => by, \"decided_at\" => now.utc.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\r\n                     \"decision_note\" => note.to_s.strip)\r\n      store.save\r\n      employee = store.employee(request[\"employee\"])\r\n      chat.direct(employee, Cards.leave_card(request, store, title: \"Your leave request was declined\",\r\n                                                             fields: %i[type dates days status approver],\r\n                                                             footer: request[\"decision_note\"]))\r\n      request\r\n    end\r\n  end\r\nend\r\n#!/usr/bin/env ruby\r\n# frozen_string_literal: true\r\n\r\n# leavedesk submit  --employee ID --type TYPE --from DATE --to DATE [--reason TEXT] [--cover "]
[16.896479, "o", "ID]\r\n#                   [--half-start] [--half-end] [--today DATE]\r\n# leavedesk decline REQUEST --by ID [--note TEXT] [--now TIME]\r\n# leavedesk balance EMPLOYEE\r\n# leavedesk calendar --from DATE --to DATE\r\nrequire \"optparse\"\r\nrequire \"time\"\r\nrequire_relative \"../lib/leavedesk/requests\"\r\n\r\ninclude Leavedesk\r\n\r\ndef parse(argv, spec)\r\n  opts = {}\r\n  OptionParser.new do |o|\r\n    spec.each do |name, kind|\r\n      flag = \"--#{name.to_s.tr('_', '-')}\"\r\n      kind == :flag ? o.on(flag) { opts[name] = true } : o.on(\"#{flag} VALUE\") { |v| opts[name] = v }\r\n    end\r\n  end.parse!(argv)\r\n  opts\r\nend\r\n\r\ndef now_from(value)\r\n  value ? Time.iso8601(value).utc : Time.now.utc\r\nend\r\n\r\ndef run(argv)\r\n  command = argv.shift\r\n  store = Store.new\r\n  chat = Chat.new\r\n  case command\r\n  when \"submit\"\r\n    o = parse(argv, employee: :value, type: :value, from: :value, to: :value, reason: :value, cover: :value,\r\n                    half_start: :flag, half_end: :flag, today: :value)\r\n    today = o[:today] ? Date.parse(o[:today]) : Date.to"]
[16.896829, "o", "day\r\n    r = Requests.submit(store, chat, employee_id: o.fetch(:employee), type: o.fetch(:type), first_day: o.fetch(:from),\r\n                                     last_day: o.fetch(:to), reason: o[:reason], cover: o[:cover],\r\n                                     half_start: !!o[:half_start], half_end: !!o[:half_end], today: today)\r\n    puts \"#{r['id']} submitted (#{Cards.format_days(r['days'])} working days)\"\r\n  when \"decline\"\r\n    id = argv.shift\r\n    o = parse(argv, by: :value, note: :value, now: :value)\r\n    Requests.decline(store, chat, id, by: o.fetch(:by), note: o[:note], now: now_from(o[:now]))\r\n    puts \"#{id} declined\"\r\n  when \"balance\"\r\n    employee = store.employee(argv.shift.to_s)\r\n    (store.balances[employee[\"id\"]] || {}).each { |type, left| puts \"#{type}: #{Cards.format_days(left)}\" }\r\n  when \"calendar\"\r\n    o = parse(argv, from: :value, to: :value)\r\n    first = Date.parse(o.fetch(:from))\r\n    last = Date.parse(o.fetch(:to))\r\n    store.requests.values.select { |r| r[\"status\"] == \"approved\" }\r\n  "]
[16.896854, "o", "       .select { |r| Date.parse(r[\"first_day\"]) <= last && Date.parse(r[\"last_day\"]) >= first }\r\n         .sort_by { |r| [r[\"first_day\"], r[\"id\"]] }\r\n         .each { |r| puts \"#{Cards.format_dates(r)}  #{store.employee(r['employee'])['name']}\" }\r\n  else\r\n    warn \"usage: leavedesk submit|decline|balance|calendar ...\"\r\n    return 64\r\n  end\r\n  0\r\nrescue KeyError, OptionParser::ParseError, Date::Error, ArgumentError => e\r\n  warn \"usage error: #{e.message}\"\r\n  64\r\nrescue NotFound, PolicyError, NotAllowed, ChatError => e\r\n  warn \"error: #{e.message}\"\r\n  1\r\nend\r\n\r\nexit run(ARGV.dup)\r\n\u001b[?2004hroot@1c7d56cb26bb:/app# "]
