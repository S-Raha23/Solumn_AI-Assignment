 [m
[32m+[m[32m    # Approves a pending request, then tells the employee and the team calendar.[m
[32m+[m[32m    def approve(store, chat, request_id, by:, now:)[m
[32m+[m[32m      request = store.request(request_id)[m
[32m+[m[32m      ensure_pending!(request)[m
[32m+[m[32m      ensure_decider!(store, request, by)[m
[32m+[m[32m      type = request["type"][m
[32m+[m[32m      rule = Policy::TYPES.fetch(type) { raise PolicyError, "unknown leave type: #{type}" }[m
[32m+[m[32m      if rule[:allowance][m
[32m+[m[32m        left = store.balance(request["employee"], type).to_f[m
[32m+[m[32m        if request["days"] > left[m
[32m+[m[32m          raise PolicyError, "not enough #{type} leave: #{request['days']} requested, #{left} left"[m
[32m+[m[32m        end[m
[32m+[m[32m      end[m
[32m+[m
[32m+[m[32m      request.merge!("status" => "approved", "decided_by" => by, "decided_at" => now.utc.strftime("%Y-%m-%dT%H:%M:%SZ"))[m
[32m+[m[32m      store.adjust_balance(request["employee"], type, -request["days"]) if rule[:allowance][m
[32m+[m[32m      store.save[m
[32m+[m
[32m+[m[32m      employee = store.employee(request["employee"])[m
[32m+[m[32m      begin[m
[32m+[m[32m        chat.direct(employee, Cards.leave_card(request, store, title: "Your leave is approved",[m
[32m+[m[32m                                                               fields: %i[type dates days status approver balance cover]))[m
[32m+[m[32m        # The calendar is company-wide: share planning details, not private leave information.[m
[32m+[m[32m        chat.post("team-calendar", Cards.leave_card(request, store,[m
[32m+[m[32m                                                   title: "#{employee['name']} is off #{Cards.format_dates(request)}",[m
[32m+[m[32m                                                   fields: %i[employee team dates days cover]))[m
[32m+[m[32m      rescue ChatError => e[m
[32m+[m[32m        warn "warning: #{request['id']} approved, but chat notification failed: #{e.message}"[m
[32m+[m[32m      end[m
[32m+[m[32m      request[m
[32m+[m[32m    end[m
[32m+[m
     # Declines a pending request and tells the employee.[m
     def decline(store, chat, request_id, by:, note:, now:)[m
       request = store.request(request_id)[m
