[238.747241, "o", "\u001b[?2004h> "]
[238.747671, "o", "    if len(readSMS(t, outbox)) != 0 { t.Fatal(\"sent during quiet hours\") }\r\n\u001b[?2004l\r\r\nfun\u001b[?2004h> "]
[238.748385, "o", "    runReminder(t, \"2026-11-17T08:00:00Z\", 0, \"reminded ap-506\\nreminded ap-501\\nreminded ap-502\\nreminded ap-507\\nreminded ap-505\\nsent 5\\n\")\r\n\u001b[?2004l\r"]
[238.749093, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func TestRemindQuietHoldExpiresAndUsesEachClinic(t *testing.T) {\r\n\u001b[?2004l\r"]
