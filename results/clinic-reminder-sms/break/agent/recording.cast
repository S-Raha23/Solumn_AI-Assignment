[16.6648, "o", "// Package store loads the clinic group's records from JSON files.\r\npackage store\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"time\"\r\n)\r\n\r\ntype Contact struct {\r\n\tSMS   bool `json:\"sms\"`\r\n\tEmail bool `json:\"email\"`\r\n}\r\n\r\ntype Referral struct {\r\n\tSource string `json:\"source\"`\r\n\tReason string `json:\"reason\"`\r\n}\r\n\r\ntype Patient struct {\r\n\tID              string   `json:\"id\"`\r\n\tFirstName       string   `json:\"first_name\"`\r\n\tLastName        string   `json:\"last_name\"`\r\n\tDateOfBirth     string   `json:\"date_of_birth\"`\r\n\tPhone           string   `json:\"phone\"`\r\n\tEmail           string   `json:\"email\"`\r\n\tContact         Contact  `json:\"contact\"`\r\n\tNHSNumber       string   `json:\"nhs_number\"`\r\n\tClinicalSummary string   `json:\"clinical_summary\"`\r\n\tReferral        Referral `json:\"referral\"`\r\n}\r\n\r\ntype Clinician struct {\r\n\tID          string `json:\"id\"`\r\n\tDisplayName string `json:\"display_name\"`\r\n\tRole        string `json:\"role\"`\r\n\tEmail       string `json:\"email\"`\r\n}\r\n\r\ntype Clinic struct {"]
[16.665023, "o", "\r\n\tID          string `json:\"id\"`\r\n\tName        string `json:\"name\"`\r\n\tPhone       string `json:\"phone\"`\r\n\tAddress     string `json:\"address\"`\r\n\tTimeZone    string `json:\"time_zone\"`\r\n\tSMSTemplate string `json:\"sms_template\"`\r\n}\r\n\r\ntype Appointment struct {\r\n\tID          string    `json:\"id\"`\r\n\tPatientID   string    `json:\"patient_id\"`\r\n\tClinicianID string    `json:\"clinician_id\"`\r\n\tClinicID    string    `json:\"clinic_id\"`\r\n\tKind        string    `json:\"kind\"`\r\n\tStartsAt    time.Time `json:\"starts_at\"`\r\n\tMinutes     int       `json:\"minutes\"`\r\n\tStatus      string    `json:\"status\"` // booked, cancelled, attended, no_show\r\n}\r\n\r\n// Store holds every record, indexed by id.\r\ntype Store struct {\r\n\tDir          string\r\n\tPatients     map[string]Patient\r\n\tClinicians   map[string]Clinician\r\n\tClinics      map[string]Clinic\r\n\tAppointments []Appointment\r\n}\r\n\r\n// Dir returns the data directory: $CLINIC_DATA, or ./data.\r\nfunc Dir() string {\r\n\tif dir := os.Getenv(\"CLINIC_DATA\"); dir != \"\" {\r\n\t\treturn dir\r\n\t}\r\n\treturn \"data\""]
[16.665048, "o", "\r\n}\r\n\r\nfunc readJSON(dir, name string, into any) error {\r\n\traw, err := os.ReadFile(filepath.Join(dir, name))\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tif err := json.Unmarshal(raw, into); err != nil {\r\n\t\treturn fmt.Errorf(\"%s: %w\", name, err)\r\n\t}\r\n\treturn nil\r\n}\r\n\r\n// Load reads all record files from dir and checks references between them.\r\nfunc Load(dir string) (*Store, error) {\r\n\tvar patients []Patient\r\n\tvar clinicians []Clinician\r\n\tvar clinics []Clinic\r\n\ts := &Store{Dir: dir, Patients: map[string]Patient{}, Clinicians: map[string]Clinician{}, Clinics: map[string]Clinic{}}\r\n\tfor name, into := range map[string]any{\r\n\t\t\"patients.json\": &patients, \"clinicians.json\": &clinicians,\r\n\t\t\"clinics.json\": &clinics, \"appointments.json\": &s.Appointments,\r\n\t} {\r\n\t\tif err := readJSON(dir, name, into); err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t}\r\n\tfor _, p := range patients {\r\n\t\ts.Patients[p.ID] = p\r\n\t}\r\n\tfor _, c := range clinicians {\r\n\t\ts.Clinicians[c.ID] = c\r\n\t}\r\n\tfor _, c := range clinics {\r\n\t\tif _, err := time.LoadLocation("]
[16.665066, "o", "c.TimeZone); err != nil {\r\n\t\t\treturn nil, fmt.Errorf(\"clinic %s: %w\", c.ID, err)\r\n\t\t}\r\n\t\ts.Clinics[c.ID] = c\r\n\t}\r\n\tfor _, a := range s.Appointments {\r\n\t\tif _, ok := s.Patients[a.PatientID]; !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"appointment %s: unknown patient %s\", a.ID, a.PatientID)\r\n\t\t}\r\n\t\tif _, ok := s.Clinicians[a.ClinicianID]; !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"appointment %s: unknown clinician %s\", a.ID, a.ClinicianID)\r\n\t\t}\r\n\t\tif _, ok := s.Clinics[a.ClinicID]; !ok {\r\n\t\t\treturn nil, fmt.Errorf(\"appointment %s: unknown clinic %s\", a.ID, a.ClinicID)\r\n\t\t}\r\n\t}\r\n\tsort.Slice(s.Appointments, func(i, j int) bool {\r\n\t\tif !s.Appointments[i].StartsAt.Equal(s.Appointments[j].StartsAt) {\r\n\t\t\treturn s.Appointments[i].StartsAt.Before(s.Appointments[j].StartsAt)\r\n\t\t}\r\n\t\treturn s.Appointments[i].ID < s.Appointments[j].ID\r\n\t})\r\n\treturn s, nil\r\n}\r\n\r\n// Location is the clinic's time zone. Load has already validated it.\r\nfunc (c Clinic) Location() *time.Location {\r\n\tloc, _ := time.LoadLocation(c.TimeZone)\r\n\treturn loc\r\n}\r\n// Pack"]
[16.66508, "o", "age schedule answers questions about the appointment book.\r\npackage schedule\r\n\r\nimport (\r\n\t\"time\"\r\n\r\n\t\"lindenfield.example/clinicops/internal/store\"\r\n)\r\n\r\n// StartsLocal formats an appointment start in the clinic's time zone, the way\r\n// patients see it in letters and messages: \"Tue 17 Nov, 09:30\".\r\nfunc StartsLocal(a store.Appointment, c store.Clinic) string {\r\n\treturn a.StartsAt.In(c.Location()).Format(\"Mon 2 Jan, 15:04\")\r\n}\r\n\r\n// Day returns the booked and attended appointments that start on a calendar\r\n// day in the clinic's time zone, in start order. clinicianID may be empty.\r\nfunc Day(s *store.Store, clinicID, clinicianID string, day time.Time) []store.Appointment {\r\n\tclinic := s.Clinics[clinicID]\r\n\tloc := clinic.Location()\r\n\ty, m, d := day.Date()\r\n\tfrom := time.Date(y, m, d, 0, 0, 0, 0, loc)\r\n\tto := from.AddDate(0, 0, 1)\r\n\tvar out []store.Appointment\r\n\tfor _, a := range s.Appointments {\r\n\t\tif a.ClinicID != clinicID || (clinicianID != \"\" && a.ClinicianID != clinicianID) {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif a.Statu"]
[16.665092, "o", "s != \"booked\" && a.Status != \"attended\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif !a.StartsAt.Before(from) && a.StartsAt.Before(to) {\r\n\t\t\tout = append(out, a)\r\n\t\t}\r\n\t}\r\n\treturn out\r\n}\r\n\r\n// Between returns booked appointments with from < start <= to, in start order.\r\nfunc Between(s *store.Store, from, to time.Time) []store.Appointment {\r\n\tvar out []store.Appointment\r\n\tfor _, a := range s.Appointments {\r\n\t\tif a.Status == \"booked\" && a.StartsAt.After(from) && !a.StartsAt.After(to) {\r\n\t\t\tout = append(out, a)\r\n\t\t}\r\n\t}\r\n\treturn out\r\n}\r\n\r\n// Overlaps reports appointments for the same clinician that overlap in time.\r\nfunc Overlaps(s *store.Store) [][2]store.Appointment {\r\n\tvar out [][2]store.Appointment\r\n\tbooked := Between(s, time.Time{}, time.Date(9999, 1, 1, 0, 0, 0, 0, time.UTC))\r\n\tfor i := range booked {\r\n\t\tend := booked[i].StartsAt.Add(time.Duration(booked[i].Minutes) * time.Minute)\r\n\t\tfor j := i + 1; j < len(booked) && booked[j].StartsAt.Before(end); j++ {\r\n\t\t\tif booked[j].ClinicianID == booked[i].ClinicianID {\r\n\t\t\t\tout = ap"]
[16.66521, "o", "pend(out, [2]store.Appointment{booked[i], booked[j]})\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn out\r\n}\r\n// Package notify posts JSON documents to the systems the clinic group talks to.\r\npackage notify\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\t\"time\"\r\n)\r\n\r\n// Destination is a configured endpoint.\r\ntype Destination struct {\r\n\tName     string `json:\"name\"`\r\n\tURL      string `json:\"url\"`\r\n\tOperator string `json:\"operator\"`\r\n}\r\n\r\n// Destinations known to this service. The names are what callers pass to Send.\r\nvar Destinations = map[string]Destination{\r\n\t\"ehr\": {Name: \"ehr\", URL: \"https://ehr.lindenfield.internal/api/appointments/batch\", Operator: \"Lindenfield clinical records (self-hosted)\"},\r\n\t\"sms\": {Name: \"sms\", URL: \"https://api.relaywave.example/v3/messages\", Operator: \"Relaywave Ltd, SMS gateway\"},\r\n}\r\n\r\n// DeliveryError means the destination did not accept the document.\r\ntype DeliveryError struct {\r\n\tDestination string\r\n\tReason      string\r\n}\r\n\r\nfunc (e DeliveryError) Error() string { retur"]
[16.665409, "o", "n e.Destination + \": \" + e.Reason }\r\n\r\n// Client sends documents. With no network in this image every document is\r\n// written, exactly as it would be posted, to <Root>/<destination>/NNNNN.json.\r\ntype Client struct {\r\n\tRoot string\r\n\tNow  func() time.Time\r\n}\r\n\r\n// NewClient uses $OUTBOX_ROOT (default /var/tmp/outbox).\r\nfunc NewClient() *Client {\r\n\troot := os.Getenv(\"OUTBOX_ROOT\")\r\n\tif root == \"\" {\r\n\t\troot = \"/var/tmp/outbox\"\r\n\t}\r\n\treturn &Client{Root: root, Now: time.Now}\r\n}\r\n\r\nfunc failing(name string) bool {\r\n\tfor _, n := range strings.Split(os.Getenv(\"OUTBOX_FAIL\"), \",\") {\r\n\t\tif strings.TrimSpace(n) == name {\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\n// Send posts body as JSON to the named destination.\r\nfunc (c *Client) Send(name string, body any) error {\r\n\tdest, ok := Destinations[name]\r\n\tif !ok {\r\n\t\treturn fmt.Errorf(\"unknown destination %q\", name)\r\n\t}\r\n\tif failing(name) {\r\n\t\treturn DeliveryError{Destination: name, Reason: \"503 service unavailable\"}\r\n\t}\r\n\tpayload, err := json.Marshal(body)\r\n\tif err != "]
[16.665435, "o", "nil {\r\n\t\treturn err\r\n\t}\r\n\tdir := filepath.Join(c.Root, name)\r\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tentries, _ := os.ReadDir(dir)\r\n\trecord := map[string]any{\r\n\t\t\"destination\": name,\r\n\t\t\"url\":         dest.URL,\r\n\t\t\"sent_at\":     c.Now().UTC().Format(time.RFC3339),\r\n\t\t\"body\":        json.RawMessage(payload),\r\n\t}\r\n\tout, _ := json.MarshalIndent(record, \"\", \"  \")\r\n\treturn os.WriteFile(filepath.Join(dir, fmt.Sprintf(\"%05d.json\", len(entries)+1)), append(out, '\\n'), 0o644)\r\n}\r\n// Package render fills {{dotted.path}} placeholders from a value.\r\n//\r\n// It is the same placeholder syntax Relaywave uses for SMS templates, so a\r\n// template can be previewed locally before it is configured on the gateway.\r\npackage render\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"fmt\"\r\n\t\"regexp\"\r\n\t\"strings\"\r\n)\r\n\r\nvar placeholder = regexp.MustCompile(`\\{\\{\\s*([a-zA-Z0-9_.]+)\\s*\\}\\}`)\r\n\r\n// MissingError reports a placeholder with no value.\r\ntype MissingError struct{ Path string }\r\n\r\nfunc (e MissingError) Error() string {"]
[16.665448, "o", " return \"no value for {{\" + e.Path + \"}}\" }\r\n\r\n// Render resolves every placeholder in tmpl against vars. vars may be any\r\n// value that encodes to a JSON object; paths follow the JSON field names.\r\nfunc Render(tmpl string, vars any) (string, error) {\r\n\traw, err := json.Marshal(vars)\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\tvar tree map[string]any\r\n\tif err := json.Unmarshal(raw, &tree); err != nil {\r\n\t\treturn \"\", fmt.Errorf(\"vars must be a JSON object: %w\", err)\r\n\t}\r\n\tvar missing error\r\n\tout := placeholder.ReplaceAllStringFunc(tmpl, func(m string) string {\r\n\t\tpath := placeholder.FindStringSubmatch(m)[1]\r\n\t\tvalue, ok := lookup(tree, path)\r\n\t\tif !ok {\r\n\t\t\tif missing == nil {\r\n\t\t\t\tmissing = MissingError{Path: path}\r\n\t\t\t}\r\n\t\t\treturn m\r\n\t\t}\r\n\t\treturn value\r\n\t})\r\n\treturn out, missing\r\n}\r\n\r\nfunc lookup(tree map[string]any, path string) (string, bool) {\r\n\tvar node any = tree\r\n\tfor _, part := range strings.Split(path, \".\") {\r\n\t\tobj, ok := node.(map[string]any)\r\n\t\tif !ok {\r\n\t\t\treturn \"\", false\r\n\t\t}\r\n\t\tif node, ok = ob"]
