[238.763453, "o", "func TestRemindFailedDeliveryExitAndRetry(t *testing.T) {\r\n\u001b[?2004l\r"]
[238.763577, "o", "\u001b[?2004h> "]
[238.763969, "o", "    s, outbox := reminderFixture(t)\r\n\u001b[?2004l\r"]
[238.764018, "o", "\u001b[?2004h> "]
[238.76433, "o", "    now := \"2026-11-16T16:00:00Z\"\r\n\u001b[?2004l\r"]
[238.764491, "o", "\u001b[?2004h> "]
[238.764709, "o", "    t.Setenv(\"OUTBOX_FAIL\", \"sms\")\r\n\u001b[?2004l\r"]
[238.764746, "o", "\u001b[?2004h> "]
[238.765342, "o", "    runReminder(t, now, 3, \"sent 0\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.766007, "o", "    history, err := loadReminderHistory(filepath.Join(s.Dir, \"reminders_sent.json\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.767232, "o", "> "]
[238.767855, "o", "    if err != nil || len(history) != 0 { t.Fatalf(\"failed sends recorded: %+v, %v\", history, err) }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.768386, "o", "    if len(readSMS(t, outbox)) != 0 { t.Fatal(\"unexpected messages\") }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.769331, "o", "    t.Setenv(\"OUTBOX_FAIL\", \"\")\r\n\u001b[?2004l\r"]
[238.769421, "o", "\u001b[?2004h>     runReminder(t, now, 0, \"reminded ap-506\\nreminded ap-501\\nreminded ap-502\\nreminded ap-507\\nreminded ap-505\\nsent 5\\n\")\r\n\u001b[?2004l\r"]
[238.769436, "o", "\u001b[?2004h"]
[238.769849, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.773174, "o", "func TestRemindContinuesAfterFailedSend(t *testing.T) {\r\n\u001b[?2004l\r\u001b[?2004h>     s, _ := reminderFixture(t)\r\n\u001b[?2004l\r\u001b[?2004h>     var attempted []string\r\n\u001b[?2004l\r"]
[238.775235, "o", "\u001b[?2004h>     sender := reminderSendFunc(func(destination string, body any) error {\r\n\u001b[?2004l\r\u001b[?2004h>         msg := body.(reminderMessage)\r\n\u001b[?2004l\r\u001b[?2004h>         attempted = append(attempted, msg.Vars.Appointment.ID)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.777799, "o", "        if msg.Reference == \"appt-ap-501\" { return notify.DeliveryError{Destination: destination, Reason: \"temporary error\"} }\r\n"]
[238.777957, "o", "\u001b[?2004l\r\u001b[?2004h>         return nil\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h>     var out bytes.Buffer\r\n\u001b[?2004l\r\u001b[?2004h>     args := []string{\"--now\", \"2026-11-16T16:00:00Z\"}\r\n\u001b[?2004l\r\u001b[?2004h>     err := remind(s, args, &out, sender)\r\n\u001b[?2004l\r\u001b[?2004h>     if !errors.Is(err, errReminderDelivery) || len(attempted) != 5 {\r\n\u001b[?2004l\r\u001b[?2004h>         t.Fatalf(\"attempts = %v, error = %v\", attempted, err)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.778021, "o", "    if out.String() != \"reminded ap-506\\nreminded ap-502\\nreminded ap-507\\nreminded ap-505\\nsent 4\\n\" { t.Fatalf(\"output: %s\", &out) }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.778455, "o", "    history, err := loadReminderHistory(filepath.Join(s.Dir, \"reminders_sent.json\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.778871, "o", "    if err != nil || len(history) != 4 { t.Fatalf(\"history: %+v, %v\", history, err) }\r\n\u001b[?2004l\r"]
[238.779163, "o", "\u001b[?2004h> "]
[238.779447, "o", "    for _, r := range history { if r.AppointmentID == \"ap-501\" { t.Fatal(\"failed delivery recorded\") } }\r\n\u001b[?2004l\r"]
[238.779858, "o", "\u001b[?2004h>     out.Reset()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.780786, "o", "    sender = reminderSendFunc(func(_ string, body any) error {\r\n\u001b[?2004l\r\u001b[?2004h>         if body.(reminderMessage).Reference != \"appt-ap-501\" { t.Fatal(\"retried successful send\") }\r\n\u001b[?2004l\r\u001b[?2004h>         return nil\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.780837, "o", "> "]
[238.78136, "o", "    if err := remind(s, args, &out, sender); err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.781788, "o", "    if out.String() != \"reminded ap-501\\nsent 1\\n\" { t.Fatalf(\"retry output: %s\", &out) }\r\n\u001b[?2004l\r"]
[238.781851, "o", "\u001b[?2004h> }\r\n"]
[238.783185, "o", "\u001b[?2004l\r"]
[238.783295, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func TestRemindInvalidFlags(t *testing.T) {\r\n\u001b[?2004l\r\u001b[?2004h>     reminderFixture(t)\r\n\u001b[?2004l\r\u001b[?2004h>     for _, args := range [][]string{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.783443, "o", "        {\"--now\", \"invalid\"}, {\"--now\", \"\"}, {\"--now\"},\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.783737, "o", "> "]
[238.78377, "o", "        {\"--now\", \"2026-11-17\"}, {\"--unknown\"}, {\"extra\"},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.784309, "o", "        {\"--now\", \"2026-11-17T08:00:00Z\", \"extra\"},\r\n\u001b[?2004l\r\u001b[?2004h>     } {\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.784348, "o", "> "]
[238.784725, "o", "        var out, errOut bytes.Buffer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.785064, "o", "        if code := run(append([]string{\"remind\"}, args...), &out, &errOut); code != 64 || out.Len() != 0 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.785458, "o", "            t.Errorf(\"args %v: exit %d, output %q\", args, code, &out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.785681, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.785978, "o", "> \r\n\u001b[?2004l\r"]
[238.78994, "o", "\u001b[?2004h> "]
[238.790215, "o", "func TestRemindCorruptHistoryFailsClosed(t *testing.T) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.79035, "o", "    s, outbox := reminderFixture(t)"]
[238.790436, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.790827, "o", "    for _, raw := range []string{\"not JSON\", \"[{}]\", `[{\"appointment_id\":\"ap-501\",\"starts_at\":\"bad\"}]`} {\r\n\u001b[?2004l\r"]
[238.791075, "o", "\u001b[?2004h> "]
[238.791573, "o", "        if err := os.WriteFile(filepath.Join(s.Dir, \"reminders_sent.json\"), []byte(raw), 0600); err != nil { t.Fatal(err) }\r\n"]
[238.791676, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[238.791849, "o", "        runReminder(t, \"2026-11-16T16:00:00Z\", 1, \"\")\r\n\u001b[?2004l\r"]
[238.791877, "o", "\u001b[?2004h> "]
[238.79221, "o", "        if len(readSMS(t, outbox)) != 0 { t.Fatal(\"sent with unreadable history\") }\r\n\u001b[?2004l\r"]
[238.792335, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[238.792447, "o", "\u001b[?2004h> "]
[238.79253, "o", "func TestRemindDefaultClock(t *testing.T) {\r\n\u001b[?2004l\r"]
[238.792567, "o", "\u001b[?2004h> "]
[238.792683, "o", "    s, _ := reminderFixture(t)\r\n\u001b[?2004l\r"]
[238.792736, "o", "\u001b[?2004h> "]
[238.79307, "o", "    // Regardless of current local time, there are no appointments in range.\r\n\u001b[?2004l\r"]
[238.79318, "o", "\u001b[?2004h> "]
[238.793391, "o", "    writeReminderJSON(t, s.Dir, \"appointments.json\", []store.Appointment{})\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.793746, "o", ">     var out, errOut bytes.Buffer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.798086, "o", "    if code := run([]string{\"remind\"}, &out, &errOut); code != 0 || out.String() != \"sent 0\\n\" {\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.798315, "o", "> "]
[238.798411, "o", "        t.Fatalf(\"exit %d, stdout %q, stderr %q\", code, &out, &errOut)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.798509, "o", "    }\r\n\u001b[?2004l\r"]
[238.798672, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[238.798693, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[238.804904, "o", "\u001b[?2004hroot@ecc9498bdd21:/app# "]
[238.804971, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='docs/README.md'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.805331, "o", "s=open(p).read().replace('bin/clinicops overlaps\\n', 'bin/clinicops overlaps\\nbin/clinicops remind [--now RFC3339]\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.80561, "o", "s=s.replace('`64` usage.', '`64` usage. `remind` exits `3` if any SMS send fails (and continues with the other\\nappointments).')\r\n\u001b[?2004l\r"]
[238.805983, "o", "\u001b[?2004h> s += '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.80606, "o", "## Appointment reminders\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.806383, "o", "Run `clinicops remind` from cron every 15 minutes. `--now RFC3339` pins the clock\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.807173, "o", "for a replay or test. It sends SMS reminders for booked appointments starting in\r\n\u001b[?2004l\r\u001b[?2004h> `(now, now + 24 hours]` when the patient has SMS consent and a phone number, and\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.808587, "o", "> only between 08:00 (inclusive) and 21:00 (exclusive) in each appointment clinic's\r\n\u001b[?2004l\r\u001b[?2004h> time zone. Quiet-hour reminders wait until an eligible daytime run; appointments\r\n\u001b[?2004l\r\u001b[?2004h> that have already started are never reminded.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.808971, "o", "Relaywave receives the clinic's `sms_template` with nested `patient`, `appointment`,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.8092, "o", "`clinician` and `clinic` records in `vars`, plus `appointment.starts_local` (for\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.80931, "o", "> "]
[238.809521, "o", "example, `Tue 17 Nov, 09:30`). No local template export is required.\r\n\u001b[?2004l\r"]
[238.809666, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.812722, "o", "Successful deliveries are saved in `$CLINIC_DATA/reminders_sent.json`, keyed by\r\n\u001b[?2004l\r"]
[238.812856, "o", "\u001b[?2004h> "]
[238.813993, "o", "appointment ID and start instant, so moving an appointment to a new start makes it\r\n\u001b[?2004l\r\u001b[?2004h> eligible again. Keep this file between runs. Failed sends are not recorded and\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.817261, "o", "will be retried on the next eligible run. A `reminders_sent.lock` file serializes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[238.817762, "o", "overlapping runs. Output lists `reminded <id>` for each success in start-time\r\n\u001b[?2004l\r"]
[238.818193, "o", "\u001b[?2004h> order, followed by `sent <n>`.\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[238.818223, "o", "> PY\r\n\u001b[?2004l\r"]
[238.861355, "o", "\u001b[?2004h"]
[238.862072, "o", "root@ecc9498bdd21:/app# gofmt -w cmd/clinicops/remind_test.go\r\n\u001b[?2004l\r"]
[238.871916, "o", "\u001b[?2004hroot@ecc9498bdd21:/app# "]
[238.872114, "o", "go test ./...\r\n\u001b[?2004l\r"]
[239.429826, "o", "?   \tlindenfield.example/clinicops/internal/notify\t[no test files]\r\n?   \tlindenfield.example/clinicops/internal/schedule\t[no test files]\r\n?   \tlindenfield.example/clinicops/internal/store\t[no test files]\r\n"]
[239.617899, "o", "ok  \tlindenfield.example/clinicops/cmd/clinicops\t0.170s\r\nok  \tlindenfield.example/clinicops/internal/render\t(cached)\r\n\u001b[?2004hroot@ecc9498bdd21:/app# "]
[267.636469, "i", "git diff --stat; git diff -- cmd/clinicops/main.go docs/README.md; git status --short\n"]
[267.63727, "o", "git diff --stat; git diff -- cmd/clinicops/main.go docs/README.md; git status --short\r\n\u001b[?2004l\r"]
[267.65052, "o", "\u001b[?1h\u001b=\r cmd/clinicops/main.go |  9 \u001b[32m+++++++\u001b[m\u001b[31m--\u001b[m\u001b[m\r\n docs/README.md        | 24 \u001b[32m+++++++++++++++++++++++\u001b[m\u001b[31m-\u001b[m\u001b[m\r\n 2 files changed, 30 insertions(+), 3 deletions(-)\u001b[m\r\n"]
[267.650926, "o", "\r\u001b[K\u001b[?1l\u001b>"]
