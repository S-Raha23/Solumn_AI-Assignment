[97.858697, "o", "fs.SetOutput(io.Discard)\r\n\u001b[?2004l\r\u001b[?2004h> \u0007"]
[97.859704, "o", "nowText := fs.String(\"now\", time.Now().Format(time.RFC3339Nano), \"current time (RFC3339)\")\r\n\u001b[?2004l\r\u001b[?2004h> \u0007if err := fs.Parse(args); err != nil || fs.NArg() != 0 {\r\n\u001b[?2004l\r\u001b[?2004h> \u0007"]
