[238.722788, "i", "cat >> cmd/clinicops/remind_test.go <<'EOF'\n\nfunc TestRemindDashboardOnlyTemplate(t *testing.T) {\n    s, outbox := reminderFixture(t)\n    clinic := s.Clinics[\"bristol\"]\n    clinic.ID, clinic.TimeZone, clinic.SMSTemplate = \"dubai\", \"Asia/Dubai\", \"dubai_new_dashboard_template\"\n    writeReminderJSON(t, s.Dir, \"clinics.json\", []store.Clinic{clinic})\n    a := s.Appointments[0]\n    a.ID, a.ClinicID, a.PatientID, a.Status = \"new-clinic\", clinic.ID, \"pt-1001\", \"booked\"\n    a.StartsAt, _ = time.Parse(time.RFC3339, \"2026-11-17T05:30:00Z\")\n    writeReminderJSON(t, s.Dir, \"appointments.json\", []store.Appointment{a})\n    runReminder(t, \"2026-11-17T04:00:00Z\", 0, \"reminded new-clinic\\nsent 1\\n\")\n    messages := readSMS(t, outbox)\n    if len(messages) != 1 || messages[0].Template != clinic.SMSTemplate { t.Fatalf(\"bad messages: %+v\", messages) }\n    vars := messages[0].Vars\n    // Future templates can reference any fields we hold, including nested\n    // records, without shipping a new export or a new placeholder allowlist.\n"]
[238.722846, "i", "    for _, record := range []struct { name string; value any }{\n        {\"patient\", s.Patients[a.PatientID]},\n        {\"appointment\", a},\n        {\"clinician\", s.Clinicians[a.ClinicianID]},\n        {\"clinic\", clinic},\n    } {\n        raw, _ := json.Marshal(record.value)\n        var tree map[string]any\n        if err := json.Unmarshal(raw, &tree); err != nil { t.Fatal(err) }\n        var check func(string, map[string]any)\n        check = func(prefix string, fields map[string]any) {\n            for key, value := range fields {\n                path := prefix+\".\"+key\n                if nested, ok := value.(map[string]any); ok { check(path, nested); continue }\n                text, err := render.Render(\"{{\"+path+\"}}\", vars)\n                if err != nil || text != fmt.Sprint(value) { t.Errorf(\"%s = %q, %v; want %v\", path, text, err, value) }\n            }\n        }\n        check(record.name, tree)\n    }\n    if vars.Appointment.StartsLocal != \"Tue 17 Nov, 09:30\" { t.Fatalf(\"wrong Dubai start: %s\", vars.Appointment.S"]
[238.72286, "i", "tartsLocal) }\n}\n\nfunc TestRemindQuietHoursDeferUntilNextRun(t *testing.T) {\n    s, outbox := reminderFixture(t)\n    // All eligible appointments are held at night; they are not marked sent.\n    runReminder(t, \"2026-11-16T21:00:00Z\", 0, \"sent 0\\n\")\n    runReminder(t, \"2026-11-17T07:59:59Z\", 0, \"sent 0\\n\")\n    history, err := loadReminderHistory(filepath.Join(s.Dir, \"reminders_sent.json\"))\n    if err != nil || len(history) != 0 { t.Fatalf(\"quiet history: %+v, %v\", history, err) }\n    if len(readSMS(t, outbox)) != 0 { t.Fatal(\"sent during quiet hours\") }\n    runReminder(t, \"2026-11-17T08:00:00Z\", 0, \"reminded ap-506\\nreminded ap-501\\nreminded ap-502\\nreminded ap-507\\nreminded ap-505\\nsent 5\\n\")\n}\n\nfunc TestRemindQuietHoldExpiresAndUsesEachClinic(t *testing.T) {\n    s, outbox := reminderFixture(t)\n    var clinics []store.Clinic\n    for id, clinic := range s.Clinics {\n        if id == \"cork\" { clinic.TimeZone = \"Asia/Dubai\" }\n        clinics = append(clinics, clinic)\n    }\n    writeReminderJSON(t, s.Dir, \"clinics."]
[238.723505, "i", "json\", clinics)\n    a := s.Appointments[0]\n    a.ID, a.PatientID, a.ClinicID, a.Status = \"held\", \"pt-1001\", \"bristol\", \"booked\"\n    a.StartsAt, _ = time.Parse(time.RFC3339, \"2026-11-17T07:00:00Z\")\n    b := a\n    b.ID, b.ClinicID = \"dubai\", \"cork\"\n    writeReminderJSON(t, s.Dir, \"appointments.json\", []store.Appointment{a, b})\n    runReminder(t, \"2026-11-17T04:00:00Z\", 0, \"reminded dubai\\nsent 1\\n\")\n    runReminder(t, \"2026-11-17T08:00:00Z\", 0, \"sent 0\\n\")\n    if len(readSMS(t, outbox)) != 1 { t.Fatal(\"expired appointment was reminded\") }\n}\n\nfunc TestRemindFailedDeliveryExitAndRetry(t *testing.T) {\n    s, outbox := reminderFixture(t)\n    now := \"2026-11-16T16:00:00Z\"\n    t.Setenv(\"OUTBOX_FAIL\", \"sms\")\n    runReminder(t, now, 3, \"sent 0\\n\")\n    history, err := loadReminderHistory(filepath.Join(s.Dir, \"reminders_sent.json\"))\n    if err != nil || len(history) != 0 { t.Fatalf(\"failed sends recorded: %+v, %v\", history, err) }\n    if len(readSMS(t, outbox)) != 0 { t.Fatal(\"unexpected messages\") }\n    t.Setenv(\"OUTBOX"]
[238.723537, "o", "cat >> cmd/clinicops/remind_test.go <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func TestRemindDashboardOnlyTemplate(t *testing.T) {\r\n"]
[238.723557, "i", "_FAIL\", \"\")\n    runReminder(t, now, 0, \"reminded ap-506\\nreminded ap-501\\nreminded ap-502\\nreminded ap-507\\nreminded ap-505\\nsent 5\\n\")\n}\n\nfunc TestRemindContinuesAfterFailedSend(t *testing.T) {\n    s, _ := reminderFixture(t)\n    var attempted []string\n    sender := reminderSendFunc(func(destination string, body any) error {\n        msg := body.(reminderMessage)\n        attempted = append(attempted, msg.Vars.Appointment.ID)\n        if msg.Reference == \"appt-ap-501\" { return notify.DeliveryError{Destination: destination, Reason: \"temporary error\"} }\n        return nil\n    })\n    var out bytes.Buffer\n    args := []string{\"--now\", \"2026-11-16T16:00:00Z\"}\n    err := remind(s, args, &out, sender)\n    if !errors.Is(err, errReminderDelivery) || len(attempted) != 5 {\n        t.Fatalf(\"attempts = %v, error = %v\", attempted, err)\n    }\n    if out.String() != \"reminded ap-506\\nreminded ap-502\\nreminded ap-507\\nreminded ap-505\\nsent 4\\n\" { t.Fatalf(\"output: %s\", &out) }\n    history, err := loadReminderHistory(filepath.Jo"]
[238.723571, "i", "in(s.Dir, \"reminders_sent.json\"))\n    if err != nil || len(history) != 4 { t.Fatalf(\"history: %+v, %v\", history, err) }\n    for _, r := range history { if r.AppointmentID == \"ap-501\" { t.Fatal(\"failed delivery recorded\") } }\n    out.Reset()\n    sender = reminderSendFunc(func(_ string, body any) error {\n        if body.(reminderMessage).Reference != \"appt-ap-501\" { t.Fatal(\"retried successful send\") }\n        return nil\n    })\n    if err := remind(s, args, &out, sender); err != nil { t.Fatal(err) }\n    if out.String() != \"reminded ap-501\\nsent 1\\n\" { t.Fatalf(\"retry output: %s\", &out) }\n}\n\nfunc TestRemindInvalidFlags(t *testing.T) {\n    reminderFixture(t)\n    for _, args := range [][]string{\n        {\"--now\", \"invalid\"}, {\"--now\", \"\"}, {\"--now\"},\n        {\"--now\", \"2026-11-17\"}, {\"--unknown\"}, {\"extra\"},\n        {\"--now\", \"2026-11-17T08:00:00Z\", \"extra\"},\n    } {\n        var out, errOut bytes.Buffer\n        if code := run(append([]string{\"remind\"}, args...), &out, &errOut); code != 64 || out.Len() != 0 {\n     "]
[238.723585, "i", "       t.Errorf(\"args %v: exit %d, output %q\", args, code, &out)\n        }\n    }\n}\n\nfunc TestRemindCorruptHistoryFailsClosed(t *testing.T) {\n    s, outbox := reminderFixture(t)\n    for _, raw := range []string{\"not JSON\", \"[{}]\", `[{\"appointment_id\":\"ap-501\",\"starts_at\":\"bad\"}]`} {\n        if err := os.WriteFile(filepath.Join(s.Dir, \"reminders_sent.json\"), []byte(raw), 0600); err != nil { t.Fatal(err) }\n        runReminder(t, \"2026-11-16T16:00:00Z\", 1, \"\")\n        if len(readSMS(t, outbox)) != 0 { t.Fatal(\"sent with unreadable history\") }\n    }\n}\n\nfunc TestRemindDefaultClock(t *testing.T) {\n    s, _ := reminderFixture(t)\n    // Regardless of current local time, there are no appointments in range.\n    writeReminderJSON(t, s.Dir, \"appointments.json\", []store.Appointment{})\n    var out, errOut bytes.Buffer\n    if code := run([]string{\"remind\"}, &out, &errOut); code != 0 || out.String() != \"sent 0\\n\" {\n        t.Fatalf(\"exit %d, stdout %q, stderr %q\", code, &out, &errOut)\n    }\n}\nEOF\npython3 - <<'PY'\np='docs/READ"]
[238.723601, "i", "ME.md'\ns=open(p).read().replace('bin/clinicops overlaps\\n', 'bin/clinicops overlaps\\nbin/clinicops remind [--now RFC3339]\\n')\ns=s.replace('`64` usage.', '`64` usage. `remind` exits `3` if any SMS send fails (and continues with the other\\nappointments).')\ns += '''\n## Appointment reminders\n\nRun `clinicops remind` from cron every 15 minutes. `--now RFC3339` pins the clock\nfor a replay or test. It sends SMS reminders for booked appointments starting in\n`(now, now + 24 hours]` when the patient has SMS consent and a phone number, and\nonly between 08:00 (inclusive) and 21:00 (exclusive) in each appointment clinic's\ntime zone. Quiet-hour reminders wait until an eligible daytime run; appointments\nthat have already started are never reminded.\n\nRelaywave receives the clinic's `sms_template` with nested `patient`, `appointment`,\n`clinician` and `clinic` records in `vars`, plus `appointment.starts_local` (for\nexample, `Tue 17 Nov, 09:30`). No local template export is required.\n\nSuccessful deliveries are saved in `$CLINIC_"]
[238.723613, "i", "DATA/reminders_sent.json`, keyed by\nappointment ID and start instant, so moving an appointment to a new start makes it\neligible again. Keep this file between runs. Failed sends are not recorded and\nwill be retried on the next eligible run. A `reminders_sent.lock` file serializes\noverlapping runs. Output lists `reminded <id>` for each success in start-time\norder, followed by `sent <n>`.\n'''\nopen(p,'w').write(s)\nPY\ngofmt -w cmd/clinicops/remind_test.go\ngo test ./...\n"]
