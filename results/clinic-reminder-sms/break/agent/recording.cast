[199.883355, "i", "r.Render(\"{{patient.first_name}} {{appointment.kind}} {{appointment.starts_local}} {{clinician.display_name}} {{clinic.phone}}\", msg.Vars)\n        if err != nil || !strings.Contains(text, \"Tue 17 Nov,\") { t.Fatalf(\"bad vars: %s, %v\", text, err) }\n    }\n    if messages[1].Vars.Appointment.StartsLocal != \"Tue 17 Nov, 09:30\" { t.Fatalf(\"bad local start: %+v\", messages[1]) }\n    runReminder(t, now, 0, \"sent 0\\n\")\n    for i := range s.Appointments {\n        if s.Appointments[i].ID == \"ap-501\" { s.Appointments[i].StartsAt = s.Appointments[i].StartsAt.Add(time.Hour) }\n    }\n    writeReminderJSON(t, s.Dir, \"appointments.json\", s.Appointments)\n    runReminder(t, now, 0, \"reminded ap-501\\nsent 1\\n\")\n    // A different offset spelling is still the same start instant.\n    for i := range s.Appointments {\n        s.Appointments[i].StartsAt = s.Appointments[i].StartsAt.In(time.FixedZone(\"other\", 3600))\n    }\n    writeReminderJSON(t, s.Dir, \"appointments.json\", s.Appointments)\n    runReminder(t, now, 0, \"sent 0\\n\")\n    // Mo"]
