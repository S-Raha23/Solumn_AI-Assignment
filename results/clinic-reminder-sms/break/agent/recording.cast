[117.374107, "o", "package main\r\n\r\nimport (\r\n\"encoding/json\"\r\n\"errors\"\r\n\"flag\"\r\n\"fmt\"\r\n\"io\"\r\n\"os\"\r\n\"path/filepath\"\r\n\"syscall\"\r\n\"time\"\r\n\r\n\"lindenfield.example/clinicops/internal/schedule\"\r\n\"lindenfield.example/clinicops/internal/store\"\r\n)\r\n\r\nvar errReminderDelivery = errors.New(\"reminder delivery failed\")\r\n\r\ntype reminderSender interface {\r\nSend(string, any) error\r\n}\r\n\r\ntype reminderAppointment struct {\r\nstore.Appointment\r\nStartsLocal string `json:\"starts_local\"`\r\n}\r\n"]
[117.374254, "o", "\r\n// Include the records, not just today's exported template's placeholders:\r\n// Relaywave templates are edited independently of this service.\r\ntype reminderVars struct {\r\nPatient     store.Patient       `json:\"patient\"`\r\nAppointment reminderAppointment `json:\"appointment\"`\r\nClinician   store.Clinician     `json:\"clinician\"`\r\nClinic      store.Clinic        `json:\"clinic\"`\r\n}\r\n\r\ntype reminderMessage struct {\r\nTo        string       `json:\"to\"`\r\nTemplate  string       `json:\"template\"`\r\nReference string       `json:\"reference\"`\r\nVars      reminderVars `json:\"vars\"`\r\n}\r\n\r\ntype sentReminder struct {\r\nAppointmentID string    `json:\"appointment_id\"`\r\nStartsAt      time.Time `json:\"starts_at\"`\r\nSentAt        time.Time `json:\"sent_at\"`\r\n"]
[117.374431, "o", "}\r\n\r\ntype reminderKey struct {\r\nid    string\r\nstart string\r\n}\r\n\r\nfunc reminderID(id string, start time.Time) reminderKey {\r\n// Compare instants, not the input's time-zone spelling, without losing\r\n// fractional seconds when a booking is moved.\r\n"]
[117.37445, "o", "return reminderKey{id, start.UTC().Format(time.RFC3339Nano)}\r\n}\r\n\r\n"]
[117.374592, "o", "func remind(s *store.Store, args []string, out io.Writer, client reminderSender) error {\r\nfs := flag.NewFlagSet(\"remind\", flag.ContinueOnError)\r\nfs.SetOutput(io.Discard)\r\nnowText := fs.String(\"now\", time.Now().Format(time.RFC3339Nano), \"current time (RFC3339)\")\r\nif err := fs.Parse(args); err != nil || fs.NArg() != 0 {\r\nreturn errUsage\r\n}\r\nnow, err := time.Parse(time.RFC3339, *nowText)\r\nif err != nil {\r\nreturn errUsage\r\n}\r\n\r\n// Cron runs can overlap. Hold the lock across reading history, sending,\r\n// and saving it, rather than merely protecting the file replacement.\r\nlock, err := os.OpenFile(filepath.Join(s.Dir, \"reminders_sent.lock\"), os.O_CREATE|os.O_RDWR, 0o600)\r\nif err != nil {\r\nreturn err\r\n}\r\ndefer lock.Close()\r\nif err := syscall.Flock(int(lock.Fd()), syscall.LOCK_EX); err != nil {\r\nreturn err\r\n}\r\ndefer syscall.Flock(int(lock.Fd()), syscall.LOCK_UN)\r\n\r\npath := filepath.Join(s.Dir, \"reminders_sent.json\")\r\nhistory, err := loadReminderHistory(path)\r\nif err != nil {\r\nreturn err\r\n}\r\nsent := make(map[reminderKe"]
[117.374607, "o", "y]bool, len(history))\r\nfor _, r := range history {\r\nsent[reminderID(r.AppointmentID, r.StartsAt)] = true\r\n}\r\n\r\nn := 0\r\nvar deliveryErrors error\r\nfor _, a := range schedule.Between(s, now, now.Add(24*time.Hour)) {\r\np := s.Patients[a.PatientID]\r\nif !p.Contact.SMS || p.Phone == \"\" || sent[reminderID(a.ID, a.StartsAt)] {\r\ncontinue\r\n}\r\nclinic := s.Clinics[a.ClinicID]\r\nloc := clinic.Location()\r\nhour := now.In(loc).Hour()\r\nif hour < 8 || hour >= 21 {\r\ncontinue\r\n}\r\nmessage := reminderMessage{\r\nTo: p.Phone, Template: clinic.SMSTemplate, Reference: \"appt-\" + a.ID,\r\nVars: reminderVars{\r\nPatient: p, Clinic: clinic, Clinician: s.Clinicians[a.ClinicianID],\r\nAppointment: reminderAppointment{a, a.StartsAt.In(loc).Format(\"Mon 2 Jan, 15:04\")},\r\n},\r\n}\r\nif err := client.Send(\"sms\", message); err != nil {\r\ndeliveryErrors = errors.Join(deliveryErrors, fmt.Errorf(\"appointment %s: %w\", a.ID, err))\r\ncontinue\r\n}\r\nn++\r\nfmt.Fprintf(out, \"reminded %s\\n\", a.ID)\r\nhistory = append(history, sentReminder{a.ID, a.StartsAt, now})\r\n"]
[117.374675, "o", "// Save each success so a later failed send does not lose earlier work.\r\nif err := saveReminderHistory(path, history); err != nil {\r\nfmt.Fprintf(out, \"sent %d\\n\", n)\r\nreturn errors.Join(deliveryResult(deliveryErrors), err)\r\n}\r\nsent[reminderID(a.ID, a.StartsAt)] = true\r\n}\r\nfmt.Fprintf(out, \"sent %d\\n\", n)\r\nreturn deliveryResult(deliveryErrors)\r\n}\r\n\r\nfunc deliveryResult(err error) error {\r\nif err == nil {\r\nreturn nil\r\n}\r\nreturn errors.Join(errReminderDelivery, err)\r\n}\r\n\r\nfunc loadReminderHistory(path string) ([]sentReminder, error) {\r\nraw, err := os.ReadFile(path)\r\nif errors.Is(err, os.ErrNotExist) {\r\nreturn nil, nil\r\n}\r\nif err != nil {\r\nreturn nil, err\r\n}\r\nvar history []sentReminder\r\nif err := json.Unmarshal(raw, &history); err != nil {\r\nreturn nil, fmt.Errorf(\"%s: %w\", path, err)\r\n}\r\n"]
[117.374939, "o", "for _, r := range history {\r\nif r.AppointmentID == \"\" || r.StartsAt.IsZero() {\r\nreturn nil, fmt.Errorf(\"%s: invalid reminder record\", path)\r\n}\r\n}\r\nreturn history, nil\r\n}\r\n\r\nfunc saveReminderHistory(path string, history []sentReminder) error {\r\nraw, err := json.MarshalIndent(history, \"\", \"  \")\r\nif err != nil {\r\nreturn err\r\n}\r\n// A failed write must not truncate the previous successful-send history.\r\nf, err := os.CreateTemp(filepath.Dir(path), \".reminders-*\")\r\nif err != nil {\r\nreturn err\r\n}\r\ndefer os.Remove(f.Name())\r\ndefer f.Close()\r\n"]
[117.375055, "o", "if _, err := f.Write(append(raw, '\\n')); err != nil {\r\nreturn err\r\n}\r\nif err := f.Sync(); err != nil {\r\nreturn err\r\n}\r\nif err := f.Close(); err != nil {\r\nreturn err\r\n"]
[117.37519, "o", "}\r\nreturn os.Rename(f.Name(), path)\r\n}\r\n"]
[117.378086, "o", "// Command clinicops runs the clinic group's scheduled jobs.\r\n//\r\n//\tclinicops agenda   --clinic ID --date YYYY-MM-DD [--clinician ID]\r\n//\tclinicops sync-ehr --clinic ID --date YYYY-MM-DD\r\n//\tclinicops overlaps\r\npackage main\r\n\r\nimport (\r\n\t\"errors\"\r\n\t\"flag\"\r\n\t\"fmt\"\r\n\t\"io\"\r\n\t\"os\"\r\n\t\"time\"\r\n\r\n\t_ \"time/tzdata\"\r\n\r\n\t\"lindenfield.example/clinicops/internal/notify\"\r\n\t"]
[117.378128, "o", "\"lindenfield.example/clinicops/internal/render\"\r\n\t\"lindenfield.example/clinicops/internal/schedule\"\r\n\t\"lindenfield.example/clinicops/internal/store\"\r\n)\r\n\r\nconst agendaLine = \"{{starts}}  {{minutes}}m  {{patient.first_name}} {{patient.last_name}} ({{patient.id}})  {{appointment.kind}}  [{{clinician.display_name}}]\"\r\n"]
[117.378642, "o", "\r\nvar errUsage = errors.New(\"usage\")\r\n\r\nfunc main() {\r\n\tos.Exit(run(os.Args[1:], os.Stdout, os.Stderr))\r\n}\r\n\r\nfunc run(args []string, stdout, stderr io.Writer) int {\r\n\tif len(args) == 0 {\r\n\t\tfmt.Fprintln(stderr, \"usage: clinicops agenda|sync-ehr|overlaps|remind [flags]\")\r\n\t\treturn 64\r\n\t}\r\n\ts, err := store.Load(store.Dir())\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(stderr, \"error:\", err)\r\n\t\treturn 1\r\n\t}\r\n\tswitch args[0] {\r\n\tcase \"agenda\":\r\n\t\terr = agenda(s, args[1:], stdout)\r\n\tcase \"sync-ehr\":\r\n\t\terr = syncEHR(s, args[1:], stdout, notify.NewClient())\r\n\tcase \"remind\":\r\n\t\terr = remind(s, args[1:], stdout, notify.NewClient())\r\n\tcase \"overlaps\":\r\n\t\tfor _, pair := range schedule.Overlaps(s) {\r\n\t\t\tfmt.Fprintf(stdout, \"%s overlaps %s (%s)\\n\", pair[0].ID, pair[1].ID, pair[0].ClinicianID)\r\n\t\t}\r\n\tdefault:\r\n\t\terr = errUsage\r\n\t}\r\n\tif errors.Is(err, errUsage) {\r\n\t\tfmt.Fprintln(stderr, \"usage: clinicops agenda|sync-ehr|overlaps|remind [flags]\")\r\n\t\treturn 64\r\n\t}\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(stderr, \"error:\", err)\r\n\t\tif errors.I"]
[117.378706, "o", "s(err, errReminderDelivery) {\r\n\t\t\treturn 3\r\n\t\t}\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc dayFlags(name string, args []string) (clinic, clinician string, day time.Time, err error) {\r\n\tfs := flag.NewFlagSet(name, flag.ContinueOnError)\r\n\tfs.SetOutput(io.Discard)\r\n\tfs.StringVar(&clinic, \"clinic\", \"\", \"clinic id\")\r\n\tfs.StringVar(&clinician, \"clinician\", \"\", \"clinician id\")\r\n\tdate := fs.String(\"date\", \"\", \"YYYY-MM-DD\")\r\n\tif err = fs.Parse(args); err != nil || clinic == \"\" {\r\n\t\treturn \"\", \"\", time.Time{}, errUsage\r\n\t}\r\n\tday, err = time.Parse(\"2006-01-02\", *date)\r\n\tif err != nil {\r\n\t\treturn \"\", \"\", time.Time{}, errUsage\r\n\t}\r\n\treturn clinic, clinician, day, nil\r\n}\r\n\r\n"]
