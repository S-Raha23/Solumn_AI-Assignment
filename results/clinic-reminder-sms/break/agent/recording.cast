[97.855137, "o", "\u001b[?2004h> \u0007"]
[97.85556, "o", "// Compare instants, not the input's time-zone spelling, without losing\r\n\u001b[?2004l\r"]
[97.855622, "o", "\u001b[?2004h> "]
[97.855894, "o", "\u0007// fractional seconds when a booking is moved.\r\n\u001b[?2004l\r"]
[97.856099, "o", "\u001b[?2004h> \u0007"]
