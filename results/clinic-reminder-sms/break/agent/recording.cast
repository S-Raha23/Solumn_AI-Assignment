[199.883241, "i", "nderJSON(t *testing.T, dir, name string, value any) {\n    t.Helper()\n    raw, err := json.Marshal(value)\n    if err != nil { t.Fatal(err) }\n    if err := os.WriteFile(filepath.Join(dir, name), raw, 0600); err != nil { t.Fatal(err) }\n}\n\nfunc runReminder(t *testing.T, now string, wantCode int, wantOutput string) {\n    t.Helper()\n    var out, errOut bytes.Buffer\n    code := run([]string{\"remind\", \"--now\", now}, &out, &errOut)\n    if code != wantCode || out.String() != wantOutput {\n        t.Fatalf(\"exit %d, stdout %q, stderr %q; want exit %d, stdout %q\", code, out.String(), errOut.String(), wantCode, wantOutput)\n    }\n    if wantCode == 0 && errOut.Len() != 0 { t.Fatalf(\"unexpected stderr: %s\", &errOut) }\n}\n\nfunc readSMS(t *testing.T, root string) []reminderMessage {\n    t.Helper()\n    files, err := filepath.Glob(filepath.Join(root, \"sms\", \"*.json\"))\n    if err != nil { t.Fatal(err) }\n    var messages []reminderMessage\n    for _, path := range files {\n        raw, err := os.ReadFile(path)\n        if err != nil {"]
