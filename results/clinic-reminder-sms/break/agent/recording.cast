[199.89026, "o", "> func reminderFixture(t *testing.T) (*store.Store, string) {\r\n\u001b[?2004l\r\u001b[?2004h>     t.Helper()\r\n\u001b[?2004l\r\u001b[?2004h>     outbox := setup(t)\r\n\u001b[?2004l\r\u001b[?2004h>     t.Setenv(\"OUTBOX_FAIL\", \"\")\r\n\u001b[?2004l\r\u001b[?2004h>     dir := t.TempDir()\r\n\u001b[?2004l\r\u001b[?2004h>     // Deliberately omit the stale sms_templates export.\r\n\u001b[?2004l\r\u001b[?2004h>     for _, name := range []string{\"patients.json\", \"clinicians.json\", \"clinics.json\", \"appointments.json\"} {\r\n\u001b[?2004l\r\u001b[?2004h>         raw, err := os.ReadFile(filepath.Join(os.Getenv(\"CLINIC_DATA\"), name))\r\n\u001b[?2004l\r\u001b[?2004h>         if err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.890959, "o", "        if err := os.WriteFile(filepath.Join(dir, name), raw, 0600); err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r"]
[199.890989, "o", "\u001b[?2004h"]
[199.891071, "o", ">     }\r\n\u001b[?2004l\r"]
[199.891118, "o", "\u001b[?2004h"]
[199.891284, "o", ">     t.Setenv(\"CLINIC_DATA\", dir)\r\n\u001b[?2004l\r= range []struct {\r\n        id str"]
[199.891332, "o", "\u001b[?2004h> "]
[199.891577, "o", "    s, err := store.Load(dir)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.891934, "o", "    if err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r"]
[199.892063, "o", "\u001b[?2004h>     return s, outbox\r\n"]
[199.89208, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[199.892109, "o", "}\r\n\u001b[?2004l\r"]
[199.892185, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.892638, "o", "func writeReminderJSON(t *testing.T, dir, name string, value any) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.892662, "o", "> "]
[199.892844, "o", "    t.Helper()\r\n\u001b[?2004l\r \u001b[?2004h> "]
[199.893093, "o", "    raw, err := json.Marshal(value)\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.89317, "o", "> "]
[199.893351, "o", "    if err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.894615, "o", "    if err := os.WriteFile(filepath.Join(dir, name), raw, 0600); err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.894644, "o", "> }\r\n\u001b[?2004l\r"]
[199.894654, "o", " \""]
[199.894839, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.895346, "o", "func runReminder(t *testing.T, now string, wantCode int, wantOutput string) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.895505, "o", "> "]
[199.895562, "o", "    t.Helper()\r\n\u001b[?2004l\r"]
[199.895619, "o", "\u001b[?2004h> "]
[199.895837, "o", "    var out, errOut bytes.Buffer\r\n\u001b[?2004l\r"]
[199.89597, "o", "\u001b[?2004h> "]
[199.896424, "o", "    code := run([]string{\"remind\", \"--now\", now}, &out, &errOut)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.897099, "o", "    if code != wantCode || out.String() != wantOutput {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.897129, "o", "> "]
[199.898479, "o", "        t.Fatalf(\"exit %d, stdout %q, stderr %q; want exit %d, stdout %q\", code, out.String(), errOut.String(), wantCode, wantOutput)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.899256, "o", "    if wantCode == 0 && errOut.Len() != 0 { t.Fatalf(\"unexpected stderr: %s\", &errOut) }\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.899468, "o", "> }\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[199.89965, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.899776, "o", "func readSMS(t *testing.T, root string) []reminderMessage {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.899895, "o", "    t.Helper()\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.899969, "o", "> "]
[199.900321, "o", "    files, err := filepath.Glob(filepath.Join(root, \"sms\", \"*.json\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.900784, "o", "    if err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r"]
[199.900831, "o", "\u001b[?2004h> "]
[199.901312, "o", "    var messages []reminderMessage\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.901398, "o", "> "]
[199.901658, "o", "    for _, path := range files {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.901781, "o", "> "]
[199.901952, "o", "        raw, err := os.ReadFile(path)\r\n\u001b[?2004l\rany) error\r\nfunc \u001b[?2004h> "]
[199.902312, "o", "        if err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r"]
[199.902361, "o", "\u001b[?2004h> "]
[199.902598, "o", "        var doc struct {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.903354, "o", "            Destination string `json:\"destination\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.903471, "o", "> "]
[199.903734, "o", "            Body reminderMessage `json:\"body\"`\r\n\u001b[?2004l\rs\u001b[?2004h"]
[199.90377, "o", "> "]
[199.903833, "o", "        }\r\n\u001b[?2004l\r"]
[199.903922, "o", "\u001b[?2004h> "]
[199.904787, "o", "        if err := json.Unmarshal(raw, &doc); err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r"]
[199.904822, "o", "\u001b[?2004h> "]
[199.90589, "o", "        if doc.Destination != \"sms\" { t.Fatalf(\"wrong destination: %s\", raw) }\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.905918, "o", "> "]
[199.90639, "o", "        messages = append(messages, doc.Body)\r\n\u001b[?2004l\r\u001b[?2004h>     }"]
[199.906471, "o", "\r\n\u001b[?2004l\r"]
[199.906581, "o", "\u001b[?2004h> "]
[199.906607, "o", "    return messages\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r "]
[199.906687, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.907404, "o", "func TestRemindCommandAndRescheduling(t *testing.T) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.907435, "o", "> "]
[199.908174, "o", "    s, outbox := reminderFixture(t)\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.908288, "o", "> "]
[199.908696, "o", "    now := \"2026-11-16T16:00:00Z\"\r\n\u001b[?2004l\r"]
[199.909011, "o", "\u001b[?2004h> "]
[199.910223, "o", "    runReminder(t, now, 0, \"reminded ap-506\\nreminded ap-501\\nreminded ap-502\\nreminded ap-507\\nreminded ap-505\\nsent 5\\n\")\r\n\u001b[?2004l\r"]
[199.910256, "o", "\u001b[?2004h> "]
[199.910644, "o", "    messages := readSMS(t, outbox)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.911305, "o", "    if len(messages) != 5 { t.Fatalf(\"got %d messages\", len(messages)) }\r\n\u001b[?2004l\r"]
[199.911419, "o", "\u001b[?2004h> "]
[199.911844, "o", "    for _, msg := range messages {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.912027, "o", "> "]
[199.91219, "o", "        a := msg.Vars.Appointment\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.912303, "o", "> "]
[199.914834, "o", "        if msg.To != s.Patients[a.PatientID].Phone || msg.Reference != \"appt-\"+a.ID || msg.Template != s.Clinics[a.ClinicID].SMSTemplate {\r\n\u001b[?2004l\r"]
[199.914884, "o", "\u001b[?2004h> "]
[199.915496, "o", "            t.Fatalf(\"bad envelope: %+v\", msg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.915666, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.917802, "o", "        text, err := render.Render(\"{{patient.first_name}} {{appointment.kind}} {{appointment.starts_local}} {{clinician.display_name}} {{clinic.phone}}\", msg.Vars)\r\n\u001b[?2004l\r"]
[199.917921, "o", "\u001b[?2004h> "]
[199.919109, "o", "        if err != nil || !strings.Contains(text, \"Tue 17 Nov,\") { t.Fatalf(\"bad vars: %s, %v\", text, err) }\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.919172, "o", "> "]
[199.91922, "o", "    }\r\n\u001b[?2004l\r"]
[199.919547, "o", "\u001b[?2004h> "]
[199.920654, "o", "    if messages[1].Vars.Appointment.StartsLocal != \"Tue 17 Nov, 09:30\" { t.Fatalf(\"bad local start: %+v\", messages[1]) }\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.920692, "o", "> "]
[199.921054, "o", "    runReminder(t, now, 0, \"sent 0\\n\")\r\n\u001b[?2004l\r"]
[199.921101, "o", "\u001b[?2004h> "]
[199.921457, "o", "    for i := range s.Appointments {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.921487, "o", "> "]
[199.922607, "o", "        if s.Appointments[i].ID == \"ap-501\" { s.Appointments[i].StartsAt = s.Appointments[i].StartsAt.Add(time.Hour) }\r\n\u001b[?2004l\r"]
[199.922661, "o", "\u001b[?2004h> "]
[199.922705, "o", "    }\r\n\u001b[?2004l\r.(\u001b[?2004h> "]
[199.923531, "o", "    writeReminderJSON(t, s.Dir, \"appointments.json\", s.Appointments)\r\n\u001b[?2004l\ro\u001b[?2004h"]
[199.923562, "o", "> "]
[199.924273, "o", "    runReminder(t, now, 0, \"reminded ap-501\\nsent 1\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.924386, "o", "> "]
[199.925114, "o", "    // A different offset spelling is still the same start instant.\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.925173, "o", "> "]
[199.925493, "o", "    for i := range s.Appointments {\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[199.926776, "o", "        s.Appointments[i].StartsAt = s.Appointments[i].StartsAt.In(time.FixedZone(\"other\", 3600))\r\n\u001b[?2004l\r"]
[199.92693, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[199.926965, "o", "\u001b[?2004h> "]
[199.927971, "o", "    writeReminderJSON(t, s.Dir, \"appointments.json\", s.Appointments)\r\n\u001b[?2004l\r"]
[199.928077, "o", "\u001b[?2004h> "]
[199.928767, "o", "    runReminder(t, now, 0, \"sent 0\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.92895, "o", "> "]
[199.929625, "o", "    // Moving back to an already reminded start must not send again.\r\n\u001b[?2004l\r"]
[199.929772, "o", "\u001b[?2004h> "]
[199.930227, "o", "    for i := range s.Appointments {\r\n\u001b[?2004l\r"]
[199.930298, "o", "\u001b[?2004h> "]
[199.930845, "o", "        if s.Appointments[i].ID == \"ap-501\" { s.Appointments[i].StartsAt = s.Appointments[i].StartsAt.Add(-time.Hour) }\r\n\u001b[?2004l\r"]
[199.930943, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.930958, "o", "> "]
[199.931373, "o", "    writeReminderJSON(t, s.Dir, \"appointments.json\", s.Appointments)\r\n\u001b[?2004l\r"]
[199.931466, "o", "\u001b[?2004h> "]
[199.931694, "o", "    runReminder(t, now, 0, \"sent 0\\n\")\r\n\u001b[?2004l\r"]
[199.931752, "o", "\u001b[?2004h> "]
[199.932194, "o", "    history, err := loadReminderHistory(filepath.Join(s.Dir, \"reminders_sent.json\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.932276, "o", "> "]
[199.932616, "o", "    if err != nil || len(history) != 6 { t.Fatalf(\"history = %+v, %v\", history, err) }\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.932838, "o", "> "]
[199.933007, "o", "    if len(readSMS(t, outbox)) != 6 { t.Fatal(\"duplicate delivery\") }\r\n\u001b[?2004l\r"]
[199.933171, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[199.933245, "o", "> "]
[199.933527, "o", "func TestRemindEligibilityBoundaries(t *testing.T) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.933577, "o", "> "]
[199.933776, "o", "    s, outbox := reminderFixture(t)\r\n\u001b[?2004l\r"]
[199.933862, "o", "\u001b[?2004h> "]
[199.934189, "o", "    now := time.Date(2026, 11, 16, 8, 0, 0, 0, time.UTC)\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.934229, "o", "> "]
[199.934432, "o", "    base := s.Appointments[0]\r\n\u001b[?2004l\r"]
[199.934476, "o", "\u001b[?2004h"]
[199.934558, "o", "> "]
[199.934893, "o", "    base.PatientID, base.ClinicID, base.Status = \"pt-1001\", \"bristol\", \"booked\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.934948, "o", "> "]
[199.935214, "o", "    var appointments []store.Appointment\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.935438, "o", "    for _, tc := range []struct {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.935598, "o", ">         id string\r\n\u001b[?2004l\r"]
[199.935758, "o", "\u001b[?2004h> "]
[199.93589, "o", "        delta time.Duration\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.935943, "o", "> "]
[199.936054, "o", "        status, patient string\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.93622, "o", ">     }{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.93655, "o", "        {\"b-upper\", 24*time.Hour, \"booked\", \"pt-1001\"},\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.936726, "o", "> "]
[199.936838, "o", "        {\"at-now\", 0, \"booked\", \"pt-1001\"},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.937168, "o", "        {\"past\", -time.Nanosecond, \"booked\", \"pt-1001\"},\r\n\u001b[?2004l\r"]
[199.937184, "o", "\u001b[?2004h"]
[199.937223, "o", "> "]
[199.937625, "o", "        {\"too-late\", 24*time.Hour+time.Nanosecond, \"booked\", \"pt-1001\"},\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.937678, "o", "> "]
[199.937972, "o", "        {\"a-lower\", time.Nanosecond, \"booked\", \"pt-1001\"},\r\n\u001b[?2004l\r"]
[199.938198, "o", "\u001b[?2004h> "]
[199.938354, "o", "        {\"cancelled\", time.Hour, \"cancelled\", \"pt-1001\"},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.938617, "o", "        {\"attended\", time.Hour, \"attended\", \"pt-1001\"},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.938869, "o", "        {\"no-show\", time.Hour, \"no_show\", \"pt-1001\"},\r\n\u001b[?2004l\r"]
[199.939007, "o", "\u001b[?2004h> "]
[199.939136, "o", "        {\"no-consent\", time.Hour, \"booked\", \"pt-1004\"},\r\n\u001b[?2004l\r"]
[199.939291, "o", "\u001b[?2004h> "]
[199.939419, "o", "        {\"no-phone\", time.Hour, \"booked\", \"pt-1006\"},\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.939528, "o", ">     } {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.939576, "o", ">         a := base\r\n\u001b[?2004l\r"]
[199.939588, "o", "\u001b[?2004h"]
[199.939685, "o", "> "]
[199.940055, "o", "        a.ID, a.StartsAt, a.Status, a.PatientID = tc.id, now.Add(tc.delta), tc.status, tc.patient\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.940113, "o", "> "]
[199.940322, "o", "        appointments = append(appointments, a)\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.940378, "o", "> "]
[199.940477, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.940759, "o", "    writeReminderJSON(t, s.Dir, \"appointments.json\", appointments)\r\n\u001b[?2004l\r"]
[199.940844, "o", "\u001b[?2004h> "]
[199.941198, "o", "    runReminder(t, now.Format(time.RFC3339), 0, \"reminded a-lower\\nreminded b-upper\\nsent 2\\n\")\r\n\u001b[?2004l\r"]
[199.94126, "o", "\u001b[?2004h> "]
[199.941605, "o", "    if len(readSMS(t, outbox)) != 2 { t.Fatal(\"unexpected deliveries\") }\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.941778, "o", "> }\r\n\u001b[?2004l\r"]
[199.941813, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.942079, "o", "type reminderSendFunc func(string, any) error\r\n\u001b[?2004l\r"]
[199.942235, "o", "\u001b[?2004h> "]
[199.942597, "o", "func (f reminderSendFunc) Send(destination string, body any) error { return f(destination, body) }\r\n\u001b[?2004l\r"]
[199.942635, "o", "\u001b[?2004h> "]
[199.942712, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.942892, "o", "func TestRemindQuietHours(t *testing.T) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.94299, "o", "> "]
[199.943109, "o", "    for _, tc := range []struct {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.943226, "o", "> "]
[199.943266, "o", "        zone, now string\r\n\u001b[?2004l\r"]
[199.943308, "o", "\u001b[?2004h> "]
[199.943481, "o", "        send bool\r\n\u001b[?2004l\r"]
[199.943518, "o", "\u001b[?2004h>     }{\r\n\u001b[?2004l\r"]
[199.943758, "o", "\u001b[?2004h> "]
[199.943779, "o", "        {\"Europe/London\", \"2026-11-17T07:59:59Z\", false},\r\n\u001b[?2004l\r"]
[199.943887, "o", "\u001b[?2004h> "]
[199.94414, "o", "        {\"Europe/London\", \"2026-11-17T08:00:00Z\", true},\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.944301, "o", "> "]
[199.944454, "o", "        {\"Europe/London\", \"2026-11-17T20:59:59Z\", true},\r\n\u001b[?2004l\r"]
[199.944603, "o", "\u001b[?2004h> "]
[199.944836, "o", "        {\"Europe/London\", \"2026-11-17T21:00:00Z\", false},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.945075, "o", "        {\"Europe/London\", \"2026-07-17T07:00:00Z\", true},\r\n\u001b[?2004l\r"]
