[?2004lpackage main

import (
	"bytes"
	"encoding/json"
	"os"
	"path/filepath"
	"strings"
	"testing"
)

func setup(t *testing.T) string {
	t.Helper()
	abs, _ := filepath.Abs("../../data")
	t.Setenv("CLINIC_DATA", abs)
	outbox := t.TempDir()
	t.Setenv("OUTBOX_ROOT", outbox)
	return outbox
}

func TestAgendaUsesClinicTime(t *testing.T) {
	setup(t)
	var out, errOut bytes.Buffer
	if code := run([]string{"agenda", "--clinic", "bristol", "--date", "2026-11-17", "--clinician", "cl-ruiz"}, &out, &errOut); code != 0 {
		t.Fatalf("exit %d: %s", code, errOut.String())
	}
	lines := strings.Split(strings.TrimSpace(out.String()), "\n")
	if len(lines) != 4 || !strings.HasPrefix(lines[1], "09:30  30m  Eleanor Pike (pt-1001)  follow-up") {
		t.Fatalf("unexpected agenda:\n%s", out.String())
	}
}

func TestSyncEHRSendsDay(t *testing.T) {
	outbox := setup(t)
	var out, errOut bytes.Buffer
	if code := run([]string{"sync-ehr", "--clinic", "cork", "--date", "2026-11-17"}, &out, &errOut); code != 0 {
		t.Fatalf("exit %d: %s", code, errOut.String())
	}
	raw, err := os.ReadFile(filepath.Join(outbox, "ehr", "00001.json"))
	if err != nil {
		t.Fatal(err)
	}
	var doc struct {
		Body struct {
			Entries []ehrEntry `json:"entries"`
		} `json:"body"`
	}
	if err := json.Unmarshal(raw, &doc); err != nil || len(doc.Body.Entries) != 3 {
		t.Fatalf("bad ehr batch: %v %s", err, raw)
	}
	if doc.Body.Entries[0].Patient.ID != "pt-1003" {
		t.Fatalf("first entry is %s", doc.Body.Entries[0].Patient.ID)
	}
}

func TestUsage(t *testing.T) {
	setup(t)
	var out, errOut bytes.Buffer
	if code := run([]string{"bogus"}, &out, &errOut); code != 64 {
		t.Fatalf("exit %d", code)
	}
}
// Package render fills {{dotted.path}} placeholders from a value.
//
// It is the same placeholder syntax Relaywave uses for SMS templates, so a
// template can be previewed locally before it is configured on the gateway.
package render

import (
	"encoding/json"
	"fmt"
	"regexp"
	"strings"
)

var placeholder = regexp.MustCompile(`\{\{\s*([a-zA-Z0-9_.]+)\s*\}\}`)

// MissingError reports a placeholder with no value.
type MissingError struct{ Path string }

func (e MissingError) Error() string { return "no value for {{" + e.Path + "}}" }

// Render resolves every placeholder in tmpl against vars. vars may be any
// value that encodes to a JSON object; paths follow the JSON field names.
func Render(tmpl string, vars any) (string, error) {
	raw, err := json.Marshal(vars)
	if err != nil {
		return "", err
	}
	var tree map[string]any
	if err := json.Unmarshal(raw, &tree); err != nil {
		return "", fmt.Errorf("vars must be a JSON object: %w", err)
	}
	var missing error
	out := placeholder.ReplaceAllStringFunc(tmpl, func(m string) string {
		path := placeholder.FindStringSubmatch(m)[1]
		value, ok := lookup(tree, path)
		if !ok {
			if missing == nil {
				missing = MissingError{Path: path}
			}
			return m
		}
		return value
	})
	return out, missing
}

func lookup(tree map[string]any, path string) (string, bool) {
	var node any = tree
	for _, part := range strings.Split(path, ".") {
		obj, ok := node.(map[string]any)
		if !ok {
			return "", false
		}
		if node, ok = obj[part]; !ok {
			return "", false
		}
	}
	switch v := node.(type) {
	case string:
		return v, true
	case float64, bool:
		return fmt.Sprint(v), true
	default:
		return "", false
	}
}
