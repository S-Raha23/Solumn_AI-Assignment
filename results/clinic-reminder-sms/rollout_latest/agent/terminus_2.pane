[K[?1l>// Command clinicops runs the clinic group's scheduled jobs.
//
//	clinicops agenda   --clinic ID --date YYYY-MM-DD [--clinician ID]
//	clinicops sync-ehr --clinic ID --date YYYY-MM-DD
//	clinicops overlaps
package main

import (
	"errors"
	"flag"
	"fmt"
	"io"
	"os"
	"time"

	_ "time/tzdata"

	"lindenfield.example/clinicops/internal/notify"
	"lindenfield.example/clinicops/internal/render"
	"lindenfield.example/clinicops/internal/schedule"
	"lindenfield.example/clinicops/internal/store"
)

const agendaLine = "{{starts}}  {{minutes}}m  {{patient.first_name}} {{patient.last_name}} ({{patient.id}})  {{appointment.kind}}  [{{clinician.display_name}}]"

var errUsage = errors.New("usage")

func main() {
	os.Exit(run(os.Args[1:], os.Stdout, os.Stderr))
}

func run(args []string, stdout, stderr io.Writer) int {
	if len(args) == 0 {
		fmt.Fprintln(stderr, "usage: clinicops agenda|sync-ehr|overlaps|remind [flags]")
		return 64
	}
	s, err := store.Load(store.Dir())
	if err != nil {
		fmt.Fprintln(stderr, "error:", err)
		return 1
	}
	switch args[0] {
	case "agenda":
		err = agenda(s, args[1:], stdout)
	case "sync-ehr":
		err = syncEHR(s, args[1:], stdout, notify.NewClient())
	case "remind":
		err = remind(s, args[1:], stdout, stderr, notify.NewClient())
	case "overlaps":
		for _, pair := range schedule.Overlaps(s) {
			fmt.Fprintf(stdout, "%s overlaps %s (%s)\n", pair[0].ID, pair[1].ID, pair[0].ClinicianID)
		}
	default:
		err = errUsage
	}
	if errors.Is(err, errUsage) {
		fmt.Fprintln(stderr, "usage: clinicops agenda|sync-ehr|overlaps|remind [flags]")
		return 64
	}
	if err != nil {
		fmt.Fprintln(stderr, "error:", err)
		return 1
	}
	return 0
}

func dayFlags(name string, args []string) (clinic, clinician string, day time.Time, err error) {
	fs := flag.NewFlagSet(name, flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	fs.StringVar(&clinic, "clinic", "", "clinic id")
	fs.StringVar(&clinician, "clinician", "", "clinician id")
	date := fs.String("date", "", "YYYY-MM-DD")
	if err = fs.Parse(args); err != nil || clinic == "" {
		return "", "", time.Time{}, errUsage
	}
	day, err = time.Parse("2006-01-02", *date)
	if err != nil {
		return "", "", time.Time{}, errUsage
	}
	return clinic, clinician, day, nil
}

// agenda prints a clinician's day sheet.
func agenda(s *store.Store, args []string, out io.Writer) error {
	clinicID, clinicianID, day, err := dayFlags("agenda", args)
	if err != nil {
		return err
	}
	clinic, ok := s.Clinics[clinicID]
	if !ok {
		return fmt.Errorf("unknown clinic %s", clinicID)
	}
	fmt.Fprintf(out, "%s, %s\n", clinic.Name, day.Format("Monday 2 January 2006"))
	for _, a := range schedule.Day(s, clinicID, clinicianID, day) {
		line, err := render.Render(agendaLine, map[string]any{
			"starts":      a.StartsAt.In(clinic.Location()).Format("15:04"),
			"minutes":     fmt.Sprint(a.Minutes),
			"appointment": a,
			"patient":     s.Patients[a.PatientID],
			"clinician":   s.Clinicians[a.ClinicianID],
		})
		if err != nil {
			return err
		}
		fmt.Fprintln(out, line)
	}
	return nil
}

type ehrEntry struct {
// Package render fills {{dotted.path}} placeholders from a value.
//
// It is the same placeholder syntax Relaywave uses for SMS templates, so a
// template can be previewed locally before it is configured on the gateway.
package render

import (
	"encoding/json"
	"fmt"
	"regexp"
	"strings"
)

var placeholder = regexp.MustCompile(`\{\{\s*([a-zA-Z0-9_.]+)\s*\}\}`)

// MissingError reports a placeholder with no value.
type MissingError struct{ Path string }

func (e MissingError) Error() string { return "no value for {{" + e.Path + "}}" }

// Render resolves every placeholder in tmpl against vars. vars may be any
// value that encodes to a JSON object; paths follow the JSON field names.
func Render(tmpl string, vars any) (string, error) {
	tree, err := object(vars)
	if err != nil {
		return "", err
	}
	var missing error
	out := placeholder.ReplaceAllStringFunc(tmpl, func(m string) string {
		path := placeholder.FindStringSubmatch(m)[1]
		value, ok := lookup(tree, path)
		if !ok {
			if missing == nil {
				missing = MissingError{Path: path}
			}
			return m
		}
		return value
	})
	return out, missing
}

// Select returns just the nested scalar values used by tmpl. It uses the same
// placeholder and JSON field rules as Render, without exposing unused records
// to a destination that renders templates remotely.
func Select(tmpl string, vars any) (map[string]any, error) {
	tree, err := object(vars)
	if err != nil {
		return nil, err
	}
	selected := map[string]any{}
	for _, match := range placeholder.FindAllStringSubmatch(tmpl, -1) {
		path := match[1]
		value, ok := lookupValue(tree, path)
		if !ok {
			return nil, MissingError{Path: path}
		}
		node := selected
		parts := strings.Split(path, ".")
		for _, part := range parts[:len(parts)-1] {
			child, ok := node[part].(map[string]any)
			if !ok {
				child = map[string]any{}
				node[part] = child
			}
			node = child
		}
		node[parts[len(parts)-1]] = value
	}
	return selected, nil
}

func object(vars any) (map[string]any, error) {
	raw, err := json.Marshal(vars)
	if err != nil {
		return nil, err
	}
	var tree map[string]any
	if err := json.Unmarshal(raw, &tree); err != nil {
		return nil, fmt.Errorf("vars must be a JSON object: %w", err)
	}
	return tree, nil
}

func lookup(tree map[string]any, path string) (string, bool) {
	value, ok := lookupValue(tree, path)
	if !ok {
		return "", false
	}
	return fmt.Sprint(value), true
}

func lookupValue(tree map[string]any, path string) (any, bool) {
	var node any = tree
	for _, part := range strings.Split(path, ".") {
		obj, ok := node.(map[string]any)
		if !ok {
			return nil, false
		}
		if node, ok = obj[part]; !ok {
			return nil, false
		}
	}
	switch v := node.(type) {
	case string:
		return v, true
	case float64, bool:
		return v, true
	default:
		return nil, false
	}
}
package main

import (
	"encoding/json"
	"errors"
	"flag"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"regexp"
	"syscall"
	"time"

	"lindenfield.example/clinicops/internal/render"
	"lindenfield.example/clinicops/internal/schedule"
	"lindenfield.example/clinicops/internal/store"
)

var errReminderDelivery = errors.New("one or more reminders failed")
var e164 = regexp.MustCompile(`^\+[1-9][0-9]{1,14}$`)

type smsSender interface {
	Send(string, any) error
}

type smsMessage struct {
	To        string         `json:"to"`
	Template  string         `json:"template"`
	Vars      map[string]any `json:"vars"`
	Reference string         `json:"reference"`
}

type sentReminder struct {
	AppointmentID string    `json:"appointment_id"`
	StartsAt      time.Time `json:"starts_at"`
	SentAt        time.Time `json:"sent_at"`
}

func reminderKey(id string, start time.Time) string {
	return id + "\x00" + start.UTC().Format(time.RFC3339Nano)
}

// remind holds a lock across the read/send/record cycle so overlapping cron
// invocations cannot both send the same reminder. Only successful sends enter
// the ledger, and old start times remain there if an appointment is moved back.
func remind(s *store.Store, args []string, out, diagnostics io.Writer, client smsSender) error {
	fs := flag.NewFlagSet("remind", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	pinned := fs.String("now", "", "current time (RFC3339)")
	if err := fs.Parse(args); err != nil || fs.NArg() != 0 {
		return errUsage
	}
	now := time.Now()
	var parseErr error
	fs.Visit(func(f *flag.Flag) {
		if f.Name == "now" {
			now, parseErr = time.Parse(time.RFC3339, *pinned)
		}
	})
	if parseErr != nil {
		return errUsage
	}

	var templates []struct {
		Name string `json:"name"`
		Body string `json:"body"`
	}
	if err := loadReminderJSON(filepath.Join(s.Dir, "sms_templates.json"), &templates); err != nil {
		return err
	}
	bodies := make(map[string]string, len(templates))
	for _, template := range templates {
		bodies[template.Name] = template.Body
	}

	path := filepath.Join(s.Dir, "reminders_sent.json")
	lock, err := os.OpenFile(path+".lock", os.O_CREATE|os.O_RDWR, 0o600)
	if err != nil {
		return err
	}
	defer lock.Close()
	if err := syscall.Flock(int(lock.Fd()), syscall.LOCK_EX); err != nil {
		return err
	}
	defer syscall.Flock(int(lock.Fd()), syscall.LOCK_UN)

	var sent []sentReminder
	if err := loadReminderJSON(path, &sent); err != nil && !errors.Is(err, os.ErrNotExist) {
		return err
	}
	seen := make(map[string]bool, len(sent))
	for _, record := range sent {
		seen[reminderKey(record.AppointmentID, record.StartsAt)] = true
	}

	count := 0
	defer func() { fmt.Fprintf(out, "sent %d\n", count) }()
	failed := false
	for _, a := range schedule.Between(s, now, now.Add(24*time.Hour)) {
		patient := s.Patients[a.PatientID]
		clinic := s.Clinics[a.ClinicID]
		hour := now.In(clinic.Location()).Hour()
		key := reminderKey(a.ID, a.StartsAt)
		if !patient.Contact.SMS || patient.Phone == "" || hour < 8 || hour >= 21 || seen[key] {
			continue
		}
		message, err := reminderMessage(s, a, bodies)
		if err == nil {
			err = client.Send("sms", message)
		}
		if err != nil {
			fmt.Fprintf(diagnostics, "reminder %s: %v\n", a.ID, err)
			failed = true
			continue
		}
		count++
		fmt.Fprintf(out, "reminded %s\n", a.ID)
		sent = append(sent, sentReminder{AppointmentID: a.ID, StartsAt: a.StartsAt.UTC(), SentAt: now.UTC()})
		if err := saveReminders(path, sent); err != nil {
			return fmt.Errorf("record reminder %s: %w", a.ID, err)
		}
		seen[key] = true
	}
	if failed {
		return errReminderDelivery
	}
	return nil
}

func reminderMessage(s *store.Store, a store.Appointment, bodies map[string]string) (smsMessage, error) {
	clinic := s.Clinics[a.ClinicID]
	patient := s.Patients[a.PatientID]
	if !e164.MatchString(patient.Phone) {
		return smsMessage{}, errors.New("phone must be E.164")
	}
	body, ok := bodies[clinic.SMSTemplate]
	if !ok {
		return smsMessage{}, fmt.Errorf("unknown SMS template %q", clinic.SMSTemplate)
	}
	// The full records stay local. Select projects only the template's fields,
	// preserving their nested paths and JSON types for Relaywave.
	vars, err := render.Select(body, map[string]any{
		"patient":   patient,
		"clinician": s.Clinicians[a.ClinicianID],
		"clinic":    clinic,
		"appointment": struct {
			store.Appointment
			StartsLocal string `json:"starts_local"`
		}{a, schedule.StartsLocal(a, clinic)},
	})
	if err != nil {
		return smsMessage{}, err
	}
	return smsMessage{To: patient.Phone, Template: clinic.SMSTemplate, Vars: vars, Reference: "appt-" + a.ID}, nil
}

func loadReminderJSON(path string, into any) error {
	raw, err := os.ReadFile(path)
	if err != nil {
		return err
	}
	if err := json.Unmarshal(raw, into); err != nil {
		return fmt.Errorf("%s: %w", filepath.Base(path), err)
	}
	return nil
}

// Replace the ledger atomically after every success, rather than waiting for
// the entire batch. A malformed or unwritable ledger must never be ignored.
func saveReminders(path string, sent []sentReminder) error {
	raw, err := json.MarshalIndent(sent, "", "  ")
	if err != nil {
		return err
	}
	f, err := os.CreateTemp(filepath.Dir(path), ".reminders-*.json")
	if err != nil {
		return err
	}
	defer os.Remove(f.Name())
	if _, err = f.Write(append(raw, '\n')); err == nil {
		err = f.Sync()
	}
	closeErr := f.Close()
	if err != nil {
		return err
	}
	if closeErr != nil {
		return closeErr
	}
	return os.Rename(f.Name(), path)
}
