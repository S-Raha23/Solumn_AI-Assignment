[199.152442, "o", "func TestRemindDefaultClock(t *testing.T) {\r\n\u001b[?2004l\r"]
[199.152567, "o", "\u001b[?2004h> "]
[199.152649, "o", "    s, _ := reminderFixture(t)\r\n\u001b[?2004l\r"]
[199.15267, "o", "\u001b[?2004h"]
[199.152972, "o", "> "]
[199.153326, "o", "    // Use a fixed-offset clinic where it is currently noon to avoid quiet hours.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.15359, "o", "    zone := \"Etc/GMT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.15382, "o", "    offset := 12-time.Now().UTC().Hour()\r\n\u001b[?2004l\r"]
[199.153856, "o", "\u001b[?2004h> "]
[199.15434, "o", "    if offset > 0 { zone = fmt.Sprintf(\"Etc/GMT-%d\", offset) }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.154756, "o", "    if offset < 0 { zone = fmt.Sprintf(\"Etc/GMT+%d\", -offset) }\r\n\u001b[?2004l\r"]
[199.155014, "o", "\u001b[?2004h> "]
[199.155492, "o", "    c := s.Clinics[\"site\"]; c.TimeZone = zone; s.Clinics[c.ID] = c\r\n\u001b[?2004l\r"]
[199.155648, "o", "\u001b[?2004h> "]
[199.156319, "o", "    s.Appointments = []store.Appointment{appt(\"a\", time.Now().Add(time.Hour))}\r\n\u001b[?2004l\r\u001b[?2004h>     writeFixture(t, s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.156541, "o", "    var out, diagnostics bytes.Buffer\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.156679, "o", "> "]
[199.15738, "o", "    if code := run([]string{\"remind\"}, &out, &diagnostics); code != 0 || out.String() != \"reminded a\\nsent 1\\n\" {\r\n\u001b[?2004l\r"]
[199.157408, "o", "\u001b[?2004h> "]
[199.157802, "o", "        t.Fatalf(\"exit %d, out %s, err %s\", code, &out, &diagnostics)"]
[199.157978, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }"]
[199.158096, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[199.158215, "o", "\u001b[?2004h> "]
[199.15861, "o", "func TestRemindMalformedLedgerFailsClosed(t *testing.T) {\r\n\u001b[?2004l\r"]
[199.158666, "o", "\u001b[?2004h> "]
[199.159027, "o", "    s, outbox := reminderFixture(t)\r\n\u001b[?2004l\r"]
[199.159075, "o", "\u001b[?2004h> "]
[199.159476, "o", "    now := mustTime(t, \"2026-11-16T10:00:00Z\")\r\n\u001b[?2004l\r"]
[199.159669, "o", "\u001b[?2004h> "]
[199.160062, "o", "    s.Appointments = []store.Appointment{appt(\"a\", now.Add(time.Hour))}\r\n\u001b[?2004l\r"]
[199.160097, "o", "\u001b[?2004h"]
[199.160113, "o", "> "]
[199.160987, "o", "    if err := os.WriteFile(filepath.Join(s.Dir, \"reminders_sent.json\"), []byte(\"not JSON\"), 0o600); err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r"]
[199.161201, "o", "\u001b[?2004h"]
[199.161241, "o", "> "]
[199.161445, "o", "    runReminder(t, s, now, 1, \"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.161934, "o", "    if len(readMessages(t, outbox)) != 0 { t.Fatal(\"sent despite unreadable history\") }\r\n\u001b[?2004l\r"]
[199.162137, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[199.162351, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[199.162366, "o", "\u001b[?2004h> "]
[199.162783, "o", "func TestRemindExistingTemplates(t *testing.T) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.163163, "o", "    s, outbox := reminderFixture(t)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.163815, "o", "    for _, name := range []string{\"patients.json\", \"clinicians.json\", \"clinics.json\", \"appointments.json\", \"sms_templates.json\"} {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.164206, "o", "        raw, err := os.ReadFile(filepath.Join(\"../../data\", name))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.164525, "o", "        if err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.165178, "o", "        if err := os.WriteFile(filepath.Join(s.Dir, name), raw, 0o600); err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.165334, "o", "    var out, diagnostics bytes.Buffer\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.166213, "o", "    if code := run([]string{\"remind\", \"--now\", \"2026-11-16T16:00:00Z\"}, &out, &diagnostics); code != 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         t.Fatalf(\"exit %d: %s\", code, &diagnostics)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.170879, "o", "    if out.String() != \"reminded ap-506\\nreminded ap-501\\nreminded ap-502\\nreminded ap-507\\nreminded ap-505\\nsent 5\\n\" { t.Fatalf(\"out: %s\", &out) }\r\n\u001b[?2004l\r\u001b[?2004h>     var templates []struct { Name, Body string }\r\n\u001b[?2004l\r\u001b[?2004h>     if err := loadReminderJSON(filepath.Join(s.Dir, \"sms_templates.json\"), &templates); err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.171194, "o", "    for _, m := range readMessages(t, outbox) {\r\n\u001b[?2004l\r"]
[199.171422, "o", "\u001b[?2004h> "]
[199.171826, "o", "        for _, template := range templates {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.17213, "o", "            if template.Name == m.Template {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.172347, "o", "> "]
[199.172925, "o", "                if _, err := render.Render(template.Body, m.Vars); err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.173027, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.173172, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.173529, "o", "        raw, _ := json.Marshal(m)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.174016, "o", "        if strings.Contains(string(raw), \"clinical_summary\") || strings.Contains(string(raw), \"nhs_number\") {\r\n\u001b[?2004l\r"]
[199.174158, "o", "\u001b[?2004h> "]
[199.174472, "o", "            t.Fatalf(\"unused clinical data sent: %s\", raw)\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n"]
[199.176258, "o", "\u001b[?2004l\r\u001b[?2004h>     // The other jobs do not depend on templates or the reminder ledger.\r\n\u001b[?2004l\r\u001b[?2004h>     if err := os.Remove(filepath.Join(s.Dir, \"sms_templates.json\")); err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.179111, "o", "    for _, args := range [][]string{{\"overlaps\"}, {\"agenda\", \"--clinic\", \"bristol\", \"--date\", \"2026-11-17\"}, {\"sync-ehr\", \"--clinic\", \"cork\", \"--date\", \"2026-11-17\"}} {\r\n\u001b[?2004l\r\u001b[?2004h>         if code := run(args, io.Discard, &diagnostics); code != 0 { t.Fatalf(\"%v exit %d: %s\", args, code, &diagnostics) }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.179138, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n"]
