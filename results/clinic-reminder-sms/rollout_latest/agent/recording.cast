[199.151521, "o", "                t.Fatalf(\"exit %d, out %s, err %s\", code, &out, &diagnostics)\r\n\u001b[?2004l\r"]
[199.151823, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
