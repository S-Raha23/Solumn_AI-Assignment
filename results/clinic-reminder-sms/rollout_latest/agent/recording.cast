[117.535824, "i", "plate's fields,\n\t// preserving their nested paths and JSON types for Relaywave.\n\tvars, err := render.Select(body, map[string]any{\n\t\t\"patient\": patient,\n\t\t\"clinician\": s.Clinicians[a.ClinicianID],\n\t\t\"clinic\": clinic,\n\t\t\"appointment\": struct {\n\t\t\tstore.Appointment\n\t\t\tStartsLocal string `json:\"starts_local\"`\n\t\t}{a, schedule.StartsLocal(a, clinic)},\n\t})\n\tif err != nil {\n\t\treturn smsMessage{}, err\n\t}\n\treturn smsMessage{To: patient.Phone, Template: clinic.SMSTemplate, Vars: vars, Reference: \"appt-\" + a.ID}, nil\n}\n\nfunc loadReminderJSON(path string, into any) error {\n\traw, err := os.ReadFile(path)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := json.Unmarshal(raw, into); err != nil {\n\t\treturn fmt.Errorf(\"%s: %w\", filepath.Base(path), err)\n\t}\n\treturn nil\n}\n\n// Replace the ledger atomically after every success, rather than waiting for\n// the entire batch. A malformed or unwritable ledger must never be ignored.\nfunc saveReminders(path string, sent []sentReminder) error {\n\traw, err := json.MarshalIndent(sent, \"\", \"  \")\n\tif "]
