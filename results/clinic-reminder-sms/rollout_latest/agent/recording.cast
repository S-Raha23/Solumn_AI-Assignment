[117.539262, "i", "err != nil {\n\t\treturn err\n\t}\n\tf, err := os.CreateTemp(filepath.Dir(path), \".reminders-*.json\")\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer os.Remove(f.Name())\n\tif _, err = f.Write(append(raw, '\\n')); err == nil {\n\t\terr = f.Sync()\n\t}\n\tcloseErr := f.Close()\n\tif err != nil {\n\t\treturn err\n\t}\n\tif closeErr != nil {\n\t\treturn closeErr\n\t}\n\treturn os.Rename(f.Name(), path)\n}\nEOF\npython3 - <<'PY'\np='cmd/clinicops/main.go'\ns=open(p).read().replace('//      clinicops overlaps', '//      clinicops overlaps\\n//      clinicops remind [--now RFC3339]')\ns=s.replace('agenda|sync-ehr|overlaps [flags]', 'agenda|sync-ehr|overlaps|remind [flags]')\ns=s.replace('case \"overlaps\":', 'case \"remind\":\\n\\t\\terr = remind(s, args[1:], stdout, stderr, notify.NewClient())\\n\\tcase \"overlaps\":')\ns=s.replace('''if err != nil {\n\t\tfmt.Fprintln(stderr, \"error:\", err)\n\t\treturn 1\n\t}\n\treturn 0''', '''if err != nil {\n\t\tfmt.Fprintln(stderr, \"error:\", err)\n\t\tif errors.Is(err, errReminderDelivery) {\n\t\t\treturn 3\n\t\t}\n\t\treturn 1\n\t}\n\treturn 0''')\nopen(p,'w').write"]
