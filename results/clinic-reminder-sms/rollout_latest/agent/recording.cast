[256.1607, "o", "?   \tlindenfield.example/clinicops/internal/notify\t[no test files]\r\n?   \tlindenfield.example/clinicops/internal/schedule\t[no test files]\r\n?   \tlindenfield.example/clinicops/internal/store\t[no test files]\r\n"]
[256.315163, "o", "ok  \tlindenfield.example/clinicops/cmd/clinicops\t0.141s\r\nok  \tlindenfield.example/clinicops/internal/render\t0.003s\r\n"]
[256.577511, "i", "go test -race ./...\n"]
