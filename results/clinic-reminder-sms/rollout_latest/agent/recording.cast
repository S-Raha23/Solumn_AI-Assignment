[84.253283, "o", "s=s.replace('''func lookup(tree map[string]any, path string) (string, bool) {''', '''func lookup(tree map[string]any, path string) (string, bool) {\r\n\u001b[?2004l\r\u001b[?2004h>         value, ok := lookupValue(tree, path)\r\n\u001b[?2004l\r\u001b[?2004h>         if !ok {\r\n\u001b[?2004l\r\u001b[?2004h>                 return \"\", false\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         return fmt.Sprint(value), true\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func lookupValue(tree map[string]any, path string) (any, bool) {''')\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('return \"\", false', 'return nil, false') if False else s\r\n\u001b[?2004l\r\u001b[?2004h> start=s.index('func lookupValue')\r\n\u001b[?2004l\r\u001b[?2004h> s=s[:start]+s[start:].replace('return \"\", false', 'return nil, false').replace('return fmt.Sprint(v), true', 'return v, true')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
