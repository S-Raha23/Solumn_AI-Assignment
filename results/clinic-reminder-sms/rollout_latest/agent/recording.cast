[199.124275, "o", "\u001b[?2004h> "]
[199.125274, "o", "    if _, err := os.Stat(filepath.Join(s.Dir, \"reminders_sent.json\")); !errors.Is(err, os.ErrNotExist) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.125335, "o", "> "]
[199.125797, "o", "        t.Fatalf(\"failed sends wrote ledger: %v\", err)\r\n\u001b[?2004l\rt despite \u001b[?2004h>     }\r\n\u001b[?2004l\runread\u001b[?2004h"]
[199.125997, "o", "> "]
[199.126549, "o", "    t.Setenv(\"OUTBOX_FAIL\", \"\")\r\n\u001b[?2004l\rRem\u001b[?2004h> "]
[199.127027, "o", "    runReminder(t, s, now, 0, \"reminded a\\nreminded b\\nsent 2\\n\")\r\n\u001b[?2004l\r"]
[199.127052, "o", "\u001b[?2004h"]
[199.127323, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.127732, "o", "type failOneSender struct { calls []string }\r\n\u001b[?2004l\ren"]
[199.128022, "o", "\u001b[?2004h> "]
[199.130185, "o", "func (f *failOneSender) Send(destination string, body any) error {\r\n\u001b[?2004l\r\u001b[?2004h>     message := body.(smsMessage)\r\n\u001b[?2004l\r\u001b[?2004h>     f.calls = append(f.calls, destination+\":\"+message.Reference)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.13074, "o", "    if message.Reference == \"appt-a\" { return notify.DeliveryError{Destination: destination, Reason: \"test failure\"} }\r\n\u001b[?2004l\r"]
[199.130903, "o", "\u001b[?2004h>     return nil\r\n\u001b[?2004l\r"]
[199.130956, "o", "\u001b[?2004h"]
[199.13117, "o", "> }\r\n\u001b[?2004l\r"]
[199.131399, "o", "{ t.Fatal(err) }\r\n    }\u001b[?2004h> \r\n\u001b[?2004l\r"]
[199.131417, "o", "\u001b[?2004h> "]
[199.131851, "o", "func TestRemindContinuesAfterDeliveryFailure(t *testing.T) {\r\n\u001b[?2004l\r"]
[199.131957, "o", "\u001b[?2004h> "]
[199.132185, "o", "    s, _ := reminderFixture(t)\r\n\u001b[?2004l\r"]
[199.132317, "o", "\u001b[?2004h> "]
[199.132725, "o", "    now := mustTime(t, \"2026-11-16T10:00:00Z\")\r\n\u001b[?2004l\r= \u001b[?2004h> "]
[199.13352, "o", "    s.Appointments = []store.Appointment{appt(\"a\", now.Add(time.Hour)), appt(\"b\", now.Add(2*time.Hour))}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.133825, "o", "    sender := &failOneSender{}\r\n\u001b[?2004l\r"]
[199.135141, "o", "\u001b[?2004h>     var out, diagnostics bytes.Buffer\r\n\u001b[?2004l\r\u001b[?2004h>     err := remind(s, []string{\"--now\", now.Format(time.RFC3339)}, &out, &diagnostics, sender)\r\n\u001b[?2004l\r"]
[199.135479, "o", "\u001b[?2004h> "]
[199.13602, "o", "    if !errors.Is(err, errReminderDelivery) || out.String() != \"reminded b\\nsent 1\\n\" || len(sender.calls) != 2 {\r\n\u001b[?2004l\r"]
[199.136262, "o", "\u001b[?2004h> "]
[199.136911, "o", "        t.Fatalf(\"err %v, out %q, calls %v\", err, &out, sender.calls)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.137747, "o", "    var ledger []sentReminder\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.1381, "o", "    if err := loadReminderJSON(filepath.Join(s.Dir, \"reminders_sent.json\"), &ledger); err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.13878, "o", "    if len(ledger) != 1 || ledger[0].AppointmentID != \"b\" { t.Fatalf(\"ledger: %+v\", ledger) }\r\n\u001b[?2004l\r"]
[199.139153, "o", "\u001b[?2004h> "]
[199.139534, "o", "    runReminder(t, s, now, 0, \"reminded a\\nsent 1\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.139944, "o", "> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[199.139966, "o", "func TestRemindInvalidTemplateDoesNotBlockOthers(t *testing.T) {\r\n\u001b[?2004l\r"]
