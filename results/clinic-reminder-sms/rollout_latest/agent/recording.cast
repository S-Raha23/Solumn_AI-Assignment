[199.144424, "o", "> "]
[199.145488, "o", "            s.Appointments = []store.Appointment{appt(\"a\", now.Add(time.Hour)), appt(\"b\", now.Add(2*time.Hour))}\r\n\u001b[?2004l\r"]
[199.145637, "o", "\u001b[?2004h> "]
