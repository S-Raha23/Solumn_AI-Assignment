[199.075043, "o", "\u001b[?2004h> "]
[199.076693, "o", "            c := s.Clinics[\"site\"]; c.TimeZone = tt.zone; s.Clinics[c.ID] = c\r\n\u001b[?2004l\r\u001b[?2004h>             now := mustTime(t, tt.now)\r\n\u001b[?2004l\rr))}\r\n    sender := &failOneSender{}\r\n    \u001b[?2004h> "]
