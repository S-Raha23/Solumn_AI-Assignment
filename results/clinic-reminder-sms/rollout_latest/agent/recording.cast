[199.097643, "o", "> "]
[199.097951, "o", "    now := mustTime(t, \"2026-10-24T09:00:00Z\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.099351, "o", "    s.Appointments = []store.Appointment{appt(\"a\", now.Add(24*time.Hour))}\r\n\u001b[?2004l\rn\u001b[?2004h"]
[199.099395, "o", "> "]
[199.103888, "o", "    writeTemplates(t, s, map[string]string{\"standard\": \"{{ patient.last_name }} {{patient.contact.sms}} {{appointment.minutes}} {{patient.referral.source}} {{clinic.address}} {{clinician.role}} {{appointment.starts_at}} {{appointment.starts_local\\n}}\"})\r\n\u001b[?2004l\r"]
[199.104022, "o", "\u001b[?2004h> "]
[199.105251, "o", "    runReminder(t, s, now, 0, \"reminded a\\nsent 1\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.105812, "o", "    message := readMessages(t, outbox)[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.106381, "o", "    vars := message.Vars\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.106524, "o", "> "]
[199.109114, "o", "    if !reflect.DeepEqual(vars[\"patient\"], map[string]any{\"last_name\": \"Smith\", \"contact\": map[string]any{\"sms\": true}, \"referral\": map[string]any{\"source\": \"GP\"}}) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.109163, "o", "> "]
[199.109942, "o", "        t.Fatalf(\"nested selection: %#v\", vars)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.110205, "o", "    a := vars[\"appointment\"].(map[string]any)\r\n\u001b[?2004l\rm\u001b[?2004h> "]
[199.111324, "o", "    if a[\"starts_local\"] != \"Sun 25 Oct, 09:00\" || a[\"minutes\"] != float64(30) || a[\"starts_at\"] != \"2026-10-25T09:00:00Z\" {\r\n\u001b[?2004l\rde"]
[199.111369, "o", "\u001b[?2004h> "]
[199.112273, "o", "        t.Fatalf(\"appointment values: %#v\", a)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
