[199.146493, "o", "\u001b[?2004h> "]
[199.146861, "o", "            if len(readMessages(t, outbox)) != 1 { t.Fatal(\"invalid template was sent\") }\r\n\u001b[?2004l\r"]
[199.14703, "o", "\u001b[?2004h> "]
[199.147567, "o", "            writeTemplates(t, s, map[string]string{\"standard\": \"{{patient.first_name}}\", badTemplate: \"{{clinic.name}}\"})\r\n\u001b[?2004l\r"]
[199.147661, "o", "\u001b[?2004h> "]
