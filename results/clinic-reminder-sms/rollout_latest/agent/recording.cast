[199.121278, "o", "    now := mustTime(t, \"2026-11-16T10:00:00Z\")\r\n\u001b[?2004l\r"]
[199.12137, "o", "\u001b[?2004h"]
[199.12142, "o", "> "]
[199.122499, "o", "    s.Appointments = []store.Appointment{appt(\"a\", now.Add(time.Hour)), appt(\"b\", now.Add(2*time.Hour))}\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.122598, "o", "> "]
[199.122806, "o", "    t.Setenv(\"OUTBOX_FAIL\", \"sms\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.123258, "o", "    runReminder(t, s, now, 3, \"sent 0\\n\")\r\n\u001b[?2004l\r"]
[199.12375, "o", "\u001b[?2004h> "]
