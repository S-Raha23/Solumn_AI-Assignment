[198.959799, "o", "\u001b[?2004h> "]
[198.965713, "o", "    t.Setenv(\"OUTBOX_ROOT\", outbox)\r\n\u001b[?2004l\r\u001b[?2004h>     t.Setenv(\"OUTBOX_FAIL\", \"\")\r\n\u001b[?2004l\r\u001b[?2004h>     s := &store.Store{\r\n\u001b[?2004l\r\u001b[?2004h>         Dir: dir,\r\n\u001b[?2004l\r\u001b[?2004h>         Patients: map[string]store.Patient{\r\n\u001b[?2004l\r\u001b[?2004h>             \"p\": {ID: \"p\", FirstName: \"Ana\", LastName: \"Smith\", Phone: \"+447700900123\", Contact: store.Contact{SMS: true},\r\n\u001b[?2004l\r\u001b[?2004h>                 NHSNumber: \"private-nhs\", ClinicalSummary: \"private-notes\", Referral: store.Referral{Source: \"GP\", Reason: \"private-reason\"}},\r\n\u001b[?2004l\r\u001b[?2004h>             \"optout\": {ID: \"optout\", Phone: \"+447700900456\"},\r\n\u001b[?2004l\r\u001b[?2004h>             \"no-phone\": {ID: \"no-phone\", Contact: store.Contact{SMS: true}},\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r\u001b[?2004h>         Clinicians: map[string]store.Clinician{\"staff\": {ID: \"staff\", DisplayName: \"Sam Lee\", Role: \"Physiotherapist\", Email: \"staff@example.test\"}},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.969394, "o", "        Clinics: map[string]store.Clinic{\"site\": {ID: \"site\", Name: \"Test Clinic\", Phone: \"+44 1234\", Address: \"1 High St\", TimeZone: \"Europe/London\", SMSTemplate: \"standard\"}},\r\n\u001b[?2004l\r"]
[198.969433, "o", "\u001b[?2004h> "]
[198.969569, "o", "    }\r\n\u001b[?2004l\r"]
[198.969714, "o", "\u001b[?2004h> "]
[198.974072, "o", "    writeTemplates(t, s, map[string]string{\"standard\": \"Hi {{patient.first_name}}, {{appointment.kind}} with {{clinician.display_name}} at {{clinic.name}} on {{appointment.starts_local}}. Call {{clinic.phone}}.\"})\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.974111, "o", "> "]
