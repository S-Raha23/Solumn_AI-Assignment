[214.209457, "o", "\u001b[1mdiff --git a/internal/render/render.go b/internal/render/render.go\u001b[m\r\n\u001b[1mindex c839b86..765598e 100755\u001b[m\r\n\u001b[1m--- a/internal/render/render.go\u001b[m\r\n\u001b[1m+++ b/internal/render/render.go\u001b[m\r\n\u001b[36m@@ -21,14 +21,10 @@\u001b[m \u001b[mfunc (e MissingError) Error() string { return \"no value for {{\" + e.Path + \"}}\"\u001b[m\r\n // Render resolves every placeholder in tmpl against vars. vars may be any\u001b[m\r\n // value that encodes to a JSON object; paths follow the JSON field names.\u001b[m\r\n func Render(tmpl string, vars any) (string, error) {\u001b[m\r\n\u001b[31m-\traw, err := json.Marshal(vars)\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mtree, err := object(vars)\u001b[m\r\n \tif err != nil {\u001b[m\r\n \t\treturn \"\", err\u001b[m\r\n \t}\u001b[m\r\n\u001b[31m-\tvar tree map[string]any\u001b[m\r\n\u001b[31m-\tif err := json.Unmarshal(raw, &tree); err != nil {\u001b[m\r\n\u001b[31m-\t\treturn \"\", fmt.Errorf(\"vars must be a JSON object: %w\", err)\u001b[m\r\n\u001b[31m-\t}\u001b[m\r\n \tvar missing error\u001b[m\r\n \tout := placeholder.ReplaceAllStringFunc(tmpl, func(m string) string {\u001b[m\r\n \t\tpath := placeholder.FindStringSubmatch(m)[1]\u001b[m\r\n\u001b[36m@@ -44,23 +40,73 @@"]
[214.209502, "o", "\u001b[m \u001b[mfunc Render(tmpl string, vars any) (string, error) {\u001b[m\r\n \treturn out, missing\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Select returns just the nested scalar values used by tmpl. It uses the same\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// placeholder and JSON field rules as Render, without exposing unused records\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// to a destination that renders templates remotely.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunc Select(tmpl string, vars any) (map[string]any, error) {\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mtree, err := object(vars)\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mif err != nil {\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mreturn nil, err\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mselected := map[string]any{}\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mfor _, match := range placeholder.FindAllStringSubmatch(tmpl, -1) {\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mpath := match[1]\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mvalue, ok := lookupValue(tree, path)\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mif !ok {\u001b[m\r\n\u001b[32m+\u001b[m\t\t\t\u001b[32mreturn nil, MissingError{Path: path}\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mnode := selected\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mparts := strings.Split(path, \".\")\u001b[m\r\n\u001b[32m+\u001b[m\t\t"]
[214.209514, "o", "\u001b[32mfor _, part := range parts[:len(parts)-1] {\u001b[m\r\n\u001b[32m+\u001b[m\t\t\t\u001b[32mchild, ok := node[part].(map[string]any)\u001b[m\r\n\u001b[32m+\u001b[m\t\t\t\u001b[32mif !ok {\u001b[m\r\n\u001b[32m+\u001b[m\t\t\t\t\u001b[32mchild = map[string]any{}\u001b[m\r\n\u001b[32m+\u001b[m\t\t\t\t\u001b[32mnode[part] = child\u001b[m\r\n\u001b[32m+\u001b[m\t\t\t\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\t\t\t\u001b[32mnode = child\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mnode[parts[len(parts)-1]] = value\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mreturn selected, nil\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunc object(vars any) (map[string]any, error) {\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mraw, err := json.Marshal(vars)\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mif err != nil {\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mreturn nil, err\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mvar tree map[string]any\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mif err := json.Unmarshal(raw, &tree); err != nil {\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mreturn nil, fmt.Errorf(\"vars must be a JSON object: %w\", err)\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mreturn tree, nil\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n func lookup(tree map[string]any, path string) (string, bool) {\u001b[m\r\n\u001b[32m+\u001b"]
