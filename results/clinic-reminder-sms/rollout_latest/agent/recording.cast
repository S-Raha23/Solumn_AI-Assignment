[198.99855, "o", "func runReminder(t *testing.T, s *store.Store, now time.Time, wantCode int, wantOutput string) {\r\n\u001b[?2004l\r"]
[198.99862, "o", "\u001b[?2004h"]
[198.998662, "o", "> "]
[198.998918, "o", "    t.Helper()\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.998987, "o", "> "]
[198.999432, "o", "    writeFixture(t, s)\r\n\u001b[?2004l\rg\u001b[?2004h"]
[198.999522, "o", "> "]
[199.000141, "o", "    var out, diagnostics bytes.Buffer\r\n\u001b[?2004l\r"]
[199.000242, "o", "\u001b[?2004h> "]
[199.002062, "o", "    code := run([]string{\"remind\", \"--now\", now.Format(time.RFC3339Nano)}, &out, &diagnostics)\r\n\u001b[?2004l\r"]
[199.002241, "o", "\u001b[?2004h> "]
[199.003309, "o", "    if code != wantCode || out.String() != wantOutput {\r\n\u001b[?2004l\r"]
[199.003519, "o", "\u001b[?2004h> "]
[199.005264, "o", "        t.Fatalf(\"got exit %d, stdout %q, stderr %q; want exit %d, stdout %q\", code, out.String(), diagnostics.String(), wantCode, wantOutput)\r\n\u001b[?2004l\rr\u001b[?2004h"]
[199.005305, "o", "> "]
[199.00541, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.006848, "o", "    if wantCode == 0 && diagnostics.Len() != 0 { t.Fatalf(\"unexpected stderr: %s\", &diagnostics) }\r\n\u001b[?2004l\r"]
[199.007018, "o", "\u001b[?2004h"]
[199.007049, "o", "> }\r\n\u001b[?2004l\rst\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[199.00706, "o", "> "]
[199.0081, "o", "func readMessages(t *testing.T, outbox string) []smsMessage {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.008164, "o", "> "]
[199.008315, "o", "    t.Helper()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.00949, "o", "    paths, err := filepath.Glob(filepath.Join(outbox, \"sms\", \"*.json\"))\r\n\u001b[?2004l\r"]
[199.009633, "o", "\u001b[?2004h> "]
[199.010215, "o", "    if err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.010362, "o", "> "]
[199.010803, "o", "    var messages []smsMessage\r\n\u001b[?2004l\r"]
[199.010852, "o", "\u001b[?2004h> "]
[199.01133, "o", "    for _, path := range paths {\r\n\u001b[?2004l\r"]
[199.011376, "o", "\u001b[?2004h> "]
[199.011671, "o", "        var doc struct {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.011788, "o", "> "]
[199.012195, "o", "            Destination string `json:\"destination\"`\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.012249, "o", "> "]
[199.013125, "o", "            Body smsMessage `json:\"body\"`\r\n\u001b[?2004l\r \u001b[?2004h"]
[199.01322, "o", ">         }\r\n\u001b[?2004l\r"]
[199.013345, "o", "\u001b[?2004h> "]
[199.0144, "o", "        if err := loadReminderJSON(path, &doc); err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.014442, "o", "> "]
[199.015719, "o", "        if doc.Destination != \"sms\" { t.Fatalf(\"destination %q\", doc.Destination) }\r\n\u001b[?2004l\rm\u001b[?2004h"]
[199.01584, "o", "> "]
[199.016142, "o", "        messages = append(messages, doc.Body)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.016381, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.016519, "o", "    return messages\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.016654, "o", "> }\r\n\u001b[?2004l\r"]
[199.016687, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.017648, "o", "func TestRemindWindowConsentAndOrder(t *testing.T) {\r\n\u001b[?2004l\r"]
[199.017757, "o", "\u001b[?2004h> "]
[199.018265, "o", "    s, outbox := reminderFixture(t)\r\n\u001b[?2004l\r"]
[199.018464, "o", "\u001b[?2004h> "]
[199.018802, "o", "    now := mustTime(t, \"2026-11-16T10:00:00Z\")\r\n\u001b[?2004l\r4\u001b[?2004h> "]
[199.019912, "o", "    s.Appointments = []store.Appointment{\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.02015, "o", "> "]
[199.02036, "o", "        appt(\"last\", now.Add(24*time.Hour)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.020448, "o", "> "]
[199.021313, "o", "        appt(\"outside\", now.Add(24*time.Hour+time.Nanosecond)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.02149, "o", "> "]
[199.021946, "o", "        appt(\"past\", now.Add(-time.Hour)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.021981, "o", "> "]
[199.022799, "o", "        appt(\"now\", now),\r\n\u001b[?2004l\r1\u001b[?2004h> "]
[199.023579, "o", "        appt(\"first\", now.Add(time.Nanosecond)),\r\n\u001b[?2004l\r"]
[199.023683, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[199.023781, "o", "\u001b[?2004h> "]
[199.024941, "o", "    for _, status := range []string{\"cancelled\", \"attended\", \"no_show\"} {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.025007, "o", "> "]
[199.026277, "o", "        a := appt(status, now.Add(time.Hour)); a.Status = status\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.026566, "o", "        s.Appointments = append(s.Appointments, a)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.026827, "o", "    }\r\n\u001b[?2004l\r"]
[199.027062, "o", "\u001b[?2004h> "]
[199.027822, "o", "    for _, id := range []string{\"optout\", \"no-phone\"} {\r\n\u001b[?2004l\rf\u001b[?2004h"]
[199.028, "o", "> "]
[199.028433, "o", "        a := appt(id, now.Add(time.Hour)); a.PatientID = id\r\n\u001b[?2004l\r"]
[199.028617, "o", "\u001b[?2004h> "]
[199.029511, "o", "        s.Appointments = append(s.Appointments, a)\r\n\u001b[?2004l\r"]
[199.02964, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[199.029664, "o", "\u001b[?2004h> "]
[199.03065, "o", "    runReminder(t, s, now, 0, \"reminded first\\nreminded last\\nsent 2\\n\")\r\n\u001b[?2004l\r"]
[199.030717, "o", "\u001b[?2004h> "]
[199.031347, "o", "    messages := readMessages(t, outbox)\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.031584, "o", "> "]
[199.033185, "o", "    if len(messages) != 2 || messages[0].Reference != \"appt-first\" || messages[1].Reference != \"appt-last\" {\r\n\u001b[?2004l\r"]
[199.033267, "o", "\u001b[?2004h> "]
[199.034051, "o", "        t.Fatalf(\"unexpected messages: %+v\", messages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.034351, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.034487, "o", "    wantVars := map[string]any{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.035366, "o", "        \"patient\": map[string]any{\"first_name\": \"Ana\"},\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.035433, "o", "> "]
[199.037213, "o", "        \"appointment\": map[string]any{\"kind\": \"follow-up\", \"starts_local\": \"Mon 16 Nov, 10:00\"},\r\n\u001b[?2004l\r"]
[199.03728, "o", "\u001b[?2004h> "]
[199.038722, "o", "        \"clinician\": map[string]any{\"display_name\": \"Sam Lee\"},\r\n\u001b[?2004l\r"]
[199.03881, "o", "\u001b[?2004h> "]
[199.040077, "o", "        \"clinic\": map[string]any{\"name\": \"Test Clinic\", \"phone\": \"+44 1234\"},\r\n\u001b[?2004l\r"]
[199.040122, "o", "\u001b[?2004h> "]
[199.040239, "o", "    }\r\n\u001b[?2004l\r"]
[199.0404, "o", "\u001b[?2004h> "]
[199.042827, "o", "    if messages[0].To != \"+447700900123\" || messages[0].Template != \"standard\" || !reflect.DeepEqual(messages[0].Vars, wantVars) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.042976, "o", "> "]
[199.043567, "o", "        t.Fatalf(\"unexpected payload: %+v\", messages[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.043721, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.044076, "o", "    runReminder(t, s, now, 0, \"sent 0\\n\")\r\n\u001b[?2004l\r"]
[199.04413, "o", "\u001b[?2004h> "]
[199.045346, "o", "    if len(readMessages(t, outbox)) != 2 { t.Fatal(\"repeat run sent duplicates\") }\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.045413, "o", "> "]
[199.045964, "o", "    var ledger []sentReminder\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.046016, "o", "> "]
[199.047722, "o", "    if err := loadReminderJSON(filepath.Join(s.Dir, \"reminders_sent.json\"), &ledger); err != nil { t.Fatal(err) }\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.047798, "o", "> "]
[199.048407, "o", "    if len(ledger) != 2 { t.Fatalf(\"ledger: %+v\", ledger) }\r\n\u001b[?2004l\r"]
[199.048448, "o", "\u001b[?2004h> "]
[199.048496, "o", "}\r\n\u001b[?2004l\r"]
[199.04861, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[199.048684, "o", "\u001b[?2004h> "]
[199.049364, "o", "func TestRemindRescheduledAndEquivalentInstants(t *testing.T) {\r\n\u001b[?2004l\r"]
[199.049416, "o", "\u001b[?2004h> "]
[199.049807, "o", "    s, outbox := reminderFixture(t)\r\n\u001b[?2004l\r"]
[199.049955, "o", "\u001b[?2004h> "]
[199.050515, "o", "    now := mustTime(t, \"2026-11-16T10:00:00Z\")\r\n\u001b[?2004l\r"]
[199.050588, "o", "\u001b[?2004h> "]
[199.051215, "o", "    original := now.Add(23*time.Hour)\r\n\u001b[?2004l\r"]
[199.051273, "o", "\u001b[?2004h> "]
[199.052313, "o", "    s.Appointments = []store.Appointment{appt(\"a\", original)}\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.052433, "o", "> "]
[199.053399, "o", "    runReminder(t, s, now, 0, \"reminded a\\nsent 1\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.05362, "o", "> "]
[199.054833, "o", "    s.Appointments[0].StartsAt = original.In(time.FixedZone(\"offset\", 3600))\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.054983, "o", "> "]
[199.055461, "o", "    runReminder(t, s, now, 0, \"sent 0\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.055503, "o", "> "]
