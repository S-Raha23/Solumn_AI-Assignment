[199.114733, "o", "> "]
[199.115032, "o", "    runReminder(t, s, now, 0, \"reminded a\\nsent 1\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.115368, "o", "    message = readMessages(t, outbox)[1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.115452, "o", "> "]
[199.117666, "o", "    if !reflect.DeepEqual(message.Vars, map[string]any{\"patient\": map[string]any{\"first_name\": \"Ana\", \"contact\": map[string]any{\"email\": false}}, \"clinic\": map[string]any{\"address\": \"1 High St\"}}) {\r\n"]
[199.118103, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[199.118521, "o", "        t.Fatalf(\"changed template vars: %#v\", message.Vars)\r\n\u001b[?2004l\r \u001b[?2004h"]
