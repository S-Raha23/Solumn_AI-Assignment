[310.862426, "o", "sent 5\r\n"]
[310.867631, "o", "sent 0\r\n"]
[310.881326, "o", "reminder ap-506: sms: 503 service unavailable\r\nreminder ap-501: sms: 503 service unavailable\r\nreminder ap-502: sms: 503 service unavailable\r\nreminder ap-507: sms: 503 service unavailable\r\nreminder ap-505: sms: 503 service unavailable\r\nsent 0\r\nerror: one or more reminders failed\r\nfailure exit: 3\r\n"]
