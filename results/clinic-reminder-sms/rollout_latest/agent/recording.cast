[199.077744, "o", "\u001b[?2004h> "]
[199.078036, "o", "            want, count := \"sent 0\\n\", 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.078646, "o", "            if tt.send { want, count = \"reminded a\\nsent 1\\n\", 1 }\r\n\u001b[?2004l\r"]
[199.078691, "o", "\u001b[?2004h> "]
