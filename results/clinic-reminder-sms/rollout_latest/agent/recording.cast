[199.114021, "o", "    writeTemplates(t, s, map[string]string{\"standard\": \"Hello {{patient.first_name}} {{patient.contact.email}} at {{clinic.address}}\"})\r\n\u001b[?2004l\rNow"]
[199.114165, "o", "\u001b[?2004h> "]
