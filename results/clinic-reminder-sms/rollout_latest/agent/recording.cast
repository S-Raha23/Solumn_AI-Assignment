[199.148541, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.148643, "o", "func TestRemindUsage(t *testing.T) {\r\n\u001b[?2004l\r"]
[199.148718, "o", "\u001b[?2004h> "]
[199.148918, "o", "    s, _ := reminderFixture(t)\r\n\u001b[?2004l\r"]
