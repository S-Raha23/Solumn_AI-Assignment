[255.583028, "i", " make(chan struct{})\n    type result struct { output string; err error }\n    results := make(chan result, 2)\n    for i := 0; i < 2; i++ {\n        go func() {\n            <-start\n            var out, diagnostics bytes.Buffer\n            err := remind(s, []string{\"--now\", now.Format(time.RFC3339)}, &out, &diagnostics, notify.NewClient())\n            results <- result{out.String(), err}\n        }()\n    }\n    close(start)\n    counts := map[string]int{}\n    for i := 0; i < 2; i++ {\n        r := <-results\n        if r.err != nil { t.Fatal(r.err) }\n        counts[r.output]++\n    }\n    if counts[\"reminded a\\nsent 1\\n\"] != 1 || counts[\"sent 0\\n\"] != 1 || len(readMessages(t, outbox)) != 1 {\n        t.Fatalf(\"overlapping runs: %#v\", counts)\n    }\n}\nEOF\npython3 - <<'PY'\np='internal/render/render_test.go'\ns=open(p).read().replace('\"errors\"', '\"encoding/json\"\\n\\t\"errors\"')\nopen(p,'w').write(s)\np='cmd/clinicops/main.go'\ns=open(p).read().replace('//      clinicops overlaps\\n', '//      clinicops overlaps\\n//      clinicops r"]
[255.583067, "i", "emind [--now RFC3339]\\n').replace('//\\tclinicops overlaps\\n', '//\\tclinicops overlaps\\n//\\tclinicops remind [--now RFC3339]\\n')\nopen(p,'w').write(s)\np='docs/README.md'\ns=open(p).read().replace('bin/clinicops overlaps\\n', 'bin/clinicops overlaps\\nbin/clinicops remind [--now RFC3339]\\n')\ns=s.replace('`64` usage.', '`64` usage. `remind` exits `3` if any reminder cannot be prepared or sent; it\\ncontinues with the other appointments.')\ns=s.replace('| `sms_templates.json` | copy of the templates configured in our Relaywave account |', '| `sms_templates.json` | copy of the templates configured in our Relaywave account |\\n| `reminders_sent.json` | generated ledger of successful reminders (appointment id, UTC start and send time) |')\ns += '''\n## SMS reminders\n\nRun `clinicops remind` every 15 minutes, with `CLINIC_DATA` pointing to a persistent,\nwritable data directory. `--now RFC3339` overrides the current time for a reproducible\nrun. The command sends reminders for SMS-consenting patients with phone numbers and\nbooke"]
[255.583472, "i", "d appointments starting in `(now, now + 24 hours]`. Each clinic's local sending\nhours are 08:00 inclusive to 21:00 exclusive. Quiet-hour reminders are reconsidered on\nthe next run, provided their appointment is still in the window.\n\nThe clinic's current `sms_template` selects a body in `sms_templates.json`. Template\npaths resolve against `patient`, `appointment`, `clinician`, and `clinic` using the\nrecords' JSON field names. `appointment.starts_local` is also available (for example,\n`Tue 17 Nov, 09:30`). Only the fields referenced by that template are sent in `vars`;\nthe full patient record is not sent to Relaywave. Unknown paths or templates fail that\nreminder locally. Phone numbers must be E.164.\n\nSuccessful sends print `reminded <id>` in appointment start order, followed by\n`sent <n>`. Diagnostics go to stderr. Failed sends are not recorded and can be retried\non the next run. Successful appointment/start pairs are recorded atomically after each\nsend in `reminders_sent.json`, so rescheduling to a different "]
[255.583502, "i", "start allows a fresh\nreminder. Keep the ledger between runs. A sibling `reminders_sent.json.lock` serializes\noverlapping invocations; do not delete it while a job is running.\n'''\nopen(p,'w').write(s)\nPY\ngofmt -w cmd/clinicops/main.go cmd/clinicops/remind_test.go internal/render/render_test.go\ngo test ./... && go vet ./...\n"]
