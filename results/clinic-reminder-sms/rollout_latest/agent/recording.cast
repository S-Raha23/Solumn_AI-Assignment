[208.07582, "o", "\u001b[1mdiff --git a/cmd/clinicops/main.go b/cmd/clinicops/main.go\u001b[m\u001b[m\r\n\u001b[1mindex f1f0686..2831765 100755\u001b[m\u001b[m\r\n\u001b[1m--- a/cmd/clinicops/main.go\u001b[m\u001b[m\r\n\u001b[1m+++ b/cmd/clinicops/main.go\u001b[m\u001b[m\r\n\u001b[36m@@ -31,7 +31,7 @@\u001b[m \u001b[mfunc main() {\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n func run(args []string, stdout, stderr io.Writer) int {\u001b[m\u001b[m\r\n        if len(args) == 0 {\u001b[m\u001b[m\r\n\u001b[31m-               fmt.Fprintln(stderr, \"usage: clinicops agenda|sync-ehr|overlaps [flags]\")\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m               \u001b[32mfmt.Fprintln(stderr, \"usage: clinicops agenda|sync-ehr|overlaps|remind [flags]\")\u001b[m\u001b[m\r\n                return 64\u001b[m\u001b[m\r\n        }\u001b[m\u001b[m\r\n        s, err := store.Load(store.Dir())\u001b[m\u001b[m\r\n\u001b[36m@@ -44,6 +44,8 @@\u001b[m \u001b[mfunc run(args []string, stdout, stderr io.Writer) int {\u001b[m\u001b[m\r\n                err = agenda(s, args[1:], stdout)\u001b[m\u001b[m\r\n        case \"sync-ehr\":\u001b[m\u001b[m\r\n                err = syncEHR(s, args[1:], stdout, notify.NewClient())\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m       \u001b[32mcase \"remind\":\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m               \u001b[32merr = remind(s, args[1:], st"]
[208.076004, "o", "dout, stderr, notify.NewClient())\u001b[m\u001b[m\r\n        case \"overlaps\":\u001b[m\u001b[m\r\n                for _, pair := range schedule.Overlaps(s) {\u001b[m\u001b[m\r\n                        fmt.Fprintf(stdout, \"%s overlaps %s (%s)\\n\", pair[0].ID, pair[1].ID, pair[0].ClinicianID)\u001b[m\u001b[m\r\n\u001b[36m@@ -52,11 +54,14 @@\u001b[m \u001b[mfunc run(args []string, stdout, stderr io.Writer) int {\u001b[m\u001b[m\r\n                err = errUsage\u001b[m\u001b[m\r\n        }\u001b[m\u001b[m\r\n        if errors.Is(err, errUsage) {\u001b[m\u001b[m\r\n\u001b[31m-               fmt.Fprintln(stderr, \"usage: clinicops agenda|sync-ehr|overlaps [flags]\")\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m               \u001b[32mfmt.Fprintln(stderr, \"usage: clinicops agenda|sync-ehr|overlaps|remind [flags]\")\u001b[m\u001b[m\r\n                return 64\u001b[m\u001b[m\r\n        }\u001b[m\u001b[m\r\n        if err != nil {\u001b[m\u001b[m\r\n                fmt.Fprintln(stderr, \"error:\", err)\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m               \u001b[32mif errors.Is(err, errReminderDelivery) {\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m                       \u001b[32mreturn 3\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m               \u001b[32m}\u001b[m\u001b[m\r\n                return 1\u001b[m\u001b[m\r\n        }\u001b"]
