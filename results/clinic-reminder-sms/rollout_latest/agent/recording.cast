[255.606663, "o", "    for i := 0; i < 2; i++ {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[255.606767, "o", "        r := <-results\r\n\u001b[?2004l\r\u001b[?2004h> "]
[255.607011, "o", "        if r.err != nil { t.Fatal(r.err) }\r\n\u001b[?2004l\r\u001b[?2004h"]
[255.607143, "o", "> "]
[255.607224, "o", "        counts[r.output]++\r\n\u001b[?2004l\r\u001b[?2004h> "]
[255.60735, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[255.607879, "o", "    if counts[\"reminded a\\nsent 1\\n\"] != 1 || counts[\"sent 0\\n\"] != 1 || len(readMessages(t, outbox)) != 1 {\r\n\u001b[?2004l\r"]
[255.607989, "o", "\u001b[?2004h> "]
[255.608188, "o", "        t.Fatalf(\"overlapping runs: %#v\", counts)\r\n\u001b[?2004l\r\u001b[?2004h"]
[255.608311, "o", ">     }\r\n\u001b[?2004l\r"]
[255.608423, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[255.61141, "o", "\u001b[?2004h"]
[255.611461, "o", "root@379ef3c101f4:/app# python3 - <<'PY'"]
[255.611685, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[255.612136, "o", "> p='internal/render/render_test.go'"]
[255.612279, "o", "\r\n"]
[255.612392, "o", "\u001b[?2004l\r"]
[255.612575, "o", "\u001b[?2004h"]
[255.613032, "o", "> s=open(p).read().replace('\"errors\"', '\"encoding/json\"\\n\\t\"errors\"')"]
[255.61316, "o", "\r\n"]
[255.613273, "o", "\u001b[?2004l\r"]
[255.613408, "o", "\u001b[?2004h"]
[255.613587, "o", "> "]
[255.613842, "o", "open(p,'w').write(s)"]
[255.614064, "o", "\r\n"]
[255.614115, "o", "\u001b[?2004l\r\u001b[?2004h"]
[255.6144, "o", "> "]
[255.614569, "o", "p='cmd/clinicops/main.go'\r\n\u001b[?2004l\r\u001b[?2004h"]
[255.614774, "o", "> "]
[255.615696, "o", "s=open(p).read().replace('//      clinicops overlaps\\n', '//      clinicops overlaps\\n//      clinicops remind [--now RFC3339]\\n').replace('//\\tclinicops overlaps\\n', '//\\tclinicops overlaps\\n//\\tclinicops remind [--now RFC3339]\\n')\r\n\u001b[?2004l\r"]
[255.615875, "o", "\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r"]
[255.615898, "o", "\u001b[?2004h> "]
[255.616038, "o", "p='docs/README.md'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[255.616495, "o", "s=open(p).read().replace('bin/clinicops overlaps\\n', 'bin/clinicops overlaps\\nbin/clinicops remind [--now RFC3339]\\n')\r\n\u001b[?2004l\r"]
[255.616565, "o", "\u001b[?2004h> "]
[255.617191, "o", "s=s.replace('`64` usage.', '`64` usage. `remind` exits `3` if any reminder cannot be prepared or sent; it\\ncontinues with the other appointments.')\r\n\u001b[?2004l\r\u001b[?2004h"]
[255.617308, "o", "> "]
[255.618469, "o", "s=s.replace('| `sms_templates.json` | copy of the templates configured in our Relaywave account |', '| `sms_templates.json` | copy of the templates configured in our Relaywave account |\\n| `reminders_sent.json` | generated ledger of successful reminders (appointment id, UTC start and send time) |')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[255.619101, "o", "s += '''\r\n\u001b[?2004l\r\u001b[?2004h> ## SMS reminders\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[255.619297, "o", "Run `clinicops remind` every 15 minutes, with `CLINIC_DATA` pointing to a persistent,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[255.61943, "o", "writable data directory. `--now RFC3339` overrides the current time for a reproducible\r\n\u001b[?2004l\r\u001b[?2004h> "]
[255.619859, "o", "run. The command sends reminders for SMS-consenting patients with phone numbers and\r\n\u001b[?2004l\r"]
[255.620025, "o", "\u001b[?2004h> "]
[255.620346, "o", "booked appointments starting in `(now, now + 24 hours]`. Each clinic's local sending\r\n\u001b[?2004l\r"]
[255.620481, "o", "\u001b[?2004h> "]
[255.620787, "o", "hours are 08:00 inclusive to 21:00 exclusive. Quiet-hour reminders are reconsidered on\r\n\u001b[?2004l\r"]
[255.620918, "o", "\u001b[?2004h> "]
[255.621125, "o", "the next run, provided their appointment is still in the window.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[255.621382, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[255.622374, "o", "The clinic's current `sms_template` selects a body in `sms_templates.json`. Template\r\n"]
[255.625778, "o", "\u001b[?2004l\r\u001b[?2004h> paths resolve against `patient`, `appointment`, `clinician`, and `clinic` using the\r\n\u001b[?2004l\r\u001b[?2004h> records' JSON field names. `appointment.starts_local` is also available (for example,\r\n\u001b[?2004l\r\u001b[?2004h> `Tue 17 Nov, 09:30`). Only the fields referenced by that template are sent in `vars`;\r\n\u001b[?2004l\r\u001b[?2004h> the full patient record is not sent to Relaywave. Unknown paths or templates fail that\r\n\u001b[?2004l\r\u001b[?2004h> reminder locally. Phone numbers must be E.164.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> Successful sends print `reminded <id>` in appointment start order, followed by\r\n\u001b[?2004l\r\u001b[?2004h> `sent <n>`. Diagnostics go to stderr. Failed sends are not recorded and can be retried\r\n\u001b[?2004l\r\u001b[?2004h> "]
[255.626072, "o", "on the next run. Successful appointment/start pairs are recorded atomically after each\r\n\u001b[?2004l\r"]
[255.626291, "o", "\u001b[?2004h> "]
[255.626717, "o", "send in `reminders_sent.json`, so rescheduling to a different start allows a fresh\r\n\u001b[?2004l\r"]
[255.626848, "o", "\u001b[?2004h"]
[255.626949, "o", "> "]
[255.627297, "o", "reminder. Keep the ledger between runs. A sibling `reminders_sent.json.lock` serializes\r\n\u001b[?2004l\r\u001b[?2004h"]
[255.627353, "o", "> "]
[255.627691, "o", "overlapping invocations; do not delete it while a job is running.\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[255.627717, "o", "\u001b[?2004h> "]
[255.627999, "o", "open(p,'w').write(s)\r\n\u001b[?2004l\r"]
[255.628024, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[255.64004, "o", "\u001b[?2004hroot@379ef3c101f4:/app# "]
